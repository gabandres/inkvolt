<Window x:Class="InkvoltPrint.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InkvoltPrint.App"
        Title="{x:Static loc:Strings.Password_Title}" Icon="/InkvoltPrint.ico" SizeToContent="Height" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,16"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="Rejected" Text="{x:Static loc:Strings.Password_Rejected}" Margin="0,0,0,8" Visibility="Collapsed"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        <PasswordBox x:Name="Password" AutomationProperties.Name="{x:Static loc:Strings.Password_Title}" PasswordChanged="Password_Changed" />
        <!-- A new password (a scan preset's, roadmap 4.18): typed again -->
        <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
            <TextBlock Text="{x:Static loc:Strings.Password_TypeAgain}" Margin="0,12,0,4" />
            <PasswordBox x:Name="Confirm" AutomationProperties.Name="{x:Static loc:Strings.Password_TypeAgain}" PasswordChanged="Password_Changed" />
            <TextBlock x:Name="Mismatch" Text="{x:Static loc:Strings.Password_Mismatch}" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </StackPanel>
        <CheckBox x:Name="Remember" Content="{x:Static loc:Strings.Password_Remember}" IsChecked="True" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="Ok" Content="{x:Static loc:Strings.Common_OK}" IsDefault="True" IsEnabled="False" Click="Ok_Click" MinWidth="96" Margin="0,0,8,0"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="{x:Static loc:Strings.Common_Cancel}" IsCancel="True" MinWidth="96" />
        </StackPanel>
    </StackPanel>
</Window>
