<UserControl x:Class="InkvoltPrint.App.Views.ScanPages"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:InkvoltPrint.App"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:InkvoltPrint.App.ViewModels"
             xmlns:views="clr-namespace:InkvoltPrint.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ScanViewModel}">
    <UserControl.Resources>
        <!-- One menu per page (x:Shared=False); Tag carries the ScanViewModel, since a menu isn't in the page's visual tree. -->
        <ContextMenu x:Key="PageMenu" x:Shared="False">
            <MenuItem Header="{x:Static loc:Strings.Scan_TurnLeft}" InputGestureText="Ctrl+L" Command="{Binding PlacementTarget.Tag.RotateLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="{x:Static loc:Strings.Scan_TurnRight}" InputGestureText="Ctrl+R" Command="{Binding PlacementTarget.Tag.RotateRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="{x:Static loc:Strings.Scan_CropMenu}" Command="{Binding PlacementTarget.Tag.CropCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                      Visibility="{Binding FindsPhotos, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
            <MenuItem Header="{x:Static loc:Strings.Scan_PhotosMenu}" Command="{Binding PlacementTarget.Tag.EditPhotosCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"
                      Visibility="{Binding FindsPhotos, Converter={StaticResource VisibleWhen}}" />
            <MenuItem Header="{x:Static loc:Strings.Scan_CleanUpMenu}" Command="{Binding PlacementTarget.Tag.CleanUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="{x:Static loc:Strings.Scan_MoveEarlier}" InputGestureText="Alt+Shift+Left"
                      Command="{Binding PlacementTarget.Tag.MovePageEarlierCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="{x:Static loc:Strings.Scan_MoveLater}" InputGestureText="Alt+Shift+Right"
                      Command="{Binding PlacementTarget.Tag.MovePageLaterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <Separator />
            <MenuItem Header="{Binding FileStartMenuText}" InputGestureText="{x:Static loc:Strings.Scan_ShortcutStartFile}"
                      Visibility="{Binding IsSeparator, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"
                      Command="{Binding PlacementTarget.Tag.ToggleFileStartCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="{x:Static loc:Strings.Scan_UseAsSeparator}"
                      Visibility="{Binding IsSeparator, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"
                      Command="{Binding PlacementTarget.Tag.MarkSeparatorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="{x:Static loc:Strings.Scan_NotSeparatorMenu}" Visibility="{Binding IsSeparator, Converter={StaticResource VisibleWhen}}"
                      Command="{Binding PlacementTarget.Tag.NotSeparatorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="{x:Static loc:Strings.Scan_KeepThisPage}" Visibility="{Binding IsSkipped, Converter={StaticResource VisibleWhen}}"
                      Command="{Binding PlacementTarget.Tag.KeepPageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
            <MenuItem Header="{x:Static loc:Strings.Common_Delete}" InputGestureText="{x:Static loc:Strings.Scan_ShortcutDel}"
                      Command="{Binding PlacementTarget.Tag.RemovePageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
        </ContextMenu>
    </UserControl.Resources>
    <!-- Ctrl+Z puts back the last change to the pages (a text box's own Undo comes first when it has the focus) -->
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}" CommandParameter="pdf" />
    </UserControl.InputBindings>

    <Grid>
        <!-- Empty state -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                    Visibility="{Binding HasPages, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8FE;" FontSize="48" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,12,0,0" />
        </StackPanel>

        <!-- Pages: drag to reorder; Alt+Shift+arrows move the selected page, Delete removes it -->
        <ListBox x:Name="PagesList" ItemsSource="{Binding Pages}" SelectionMode="Single" AllowDrop="True"
                 Background="Transparent" BorderThickness="0" Padding="12,0,12,12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{x:Static loc:Strings.Scan_ScannedPages}"
                 AutomationProperties.HelpText="{x:Static loc:Strings.Scan_PagesHelp}"
                 Visibility="{Binding HasPages, Converter={StaticResource VisibleWhen}}"
                 PreviewMouseLeftButtonDown="Pages_PreviewMouseLeftButtonDown" PreviewMouseMove="Pages_PreviewMouseMove"
                 DragOver="Pages_DragOver" Drop="Pages_Drop" PreviewKeyDown="Pages_PreviewKeyDown">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="8" />
                    <Setter Property="Margin" Value="2" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <Setter Property="ContextMenu" Value="{StaticResource PageMenu}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ScanPageViewModel}">
                    <StackPanel Width="220">
                        <Grid Height="{Binding ThumbnailHeight, RelativeSource={RelativeSource AncestorType=views:ScanPages}}">
                            <Border CornerRadius="4" BorderThickness="1" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxWidth="218">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                    <Setter Property="Opacity" Value="0.35" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsSeparator}" Value="True" />
                                                        <Condition Binding="{Binding SeparatorKept}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Opacity" Value="0.35" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Border>
                            <!-- Found blank: left out of what's saved -->
                            <Border CornerRadius="6" Padding="12,8" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1"
                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Visibility="{Binding IsSkipped, Converter={StaticResource VisibleWhen}}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static loc:Strings.Scan_BlankWontBeSaved}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <Button Content="{x:Static loc:Strings.Scan_KeepThisPage}" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                            Command="{Binding DataContext.KeepPageCommand, ElementName=PagesList}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                            <!-- Saved as several files: where each one starts -->
                            <Border CornerRadius="4" Padding="8,2" Margin="-4,-4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Visibility="{Binding ShowsFileStart, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="{Binding FileStartText}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                            <!-- A separator sheet: the next file starts after it -->
                            <Border CornerRadius="6" Padding="12,8" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1"
                                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Visibility="{Binding IsSeparator, Converter={StaticResource VisibleWhen}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SeparatorText}" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                    <TextBlock Text="{Binding SeparatorStatus}" Style="{StaticResource Caption}" FontSize="12" HorizontalAlignment="Center" />
                                    <Button Content="{x:Static loc:Strings.Scan_NotSeparator}" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                            Command="{Binding DataContext.NotSeparatorCommand, ElementName=PagesList}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <DockPanel Margin="2,6,2,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" ToolTip="{x:Static loc:Strings.Scan_DeletePageTip}" AutomationProperties.Name="{x:Static loc:Strings.Scan_DeletePage}"
                                    Command="{Binding DataContext.RemovePageCommand, ElementName=PagesList}" CommandParameter="{Binding}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" ToolTip="{Binding FileStartMenuText}" AutomationProperties.Name="{Binding FileStartMenuText}"
                                    Command="{Binding DataContext.ToggleFileStartCommand, ElementName=PagesList}" CommandParameter="{Binding}" Margin="6,0,0,0"
                                    Visibility="{Binding IsSeparator, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C6;" />
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" ToolTip="{x:Static loc:Strings.Scan_CleanUpTip}" AutomationProperties.Name="{x:Static loc:Strings.Scan_CleanUpPage}"
                                    Command="{Binding DataContext.CleanUpCommand, ElementName=PagesList}" CommandParameter="{Binding}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE771;" />
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" ToolTip="{Binding CropText}" AutomationProperties.Name="{Binding CropText}"
                                    Command="{Binding DataContext.CropCommand, ElementName=PagesList}" CommandParameter="{Binding}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7A8;" />
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" ToolTip="{x:Static loc:Strings.Scan_TurnRightTip}" AutomationProperties.Name="{x:Static loc:Strings.Scan_TurnPageRight}"
                                    Command="{Binding DataContext.RotateRightCommand, ElementName=PagesList}" CommandParameter="{Binding}" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7AD;" />
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" ToolTip="{x:Static loc:Strings.Scan_TurnLeftTip}" AutomationProperties.Name="{x:Static loc:Strings.Scan_TurnPageLeft}"
                                    Command="{Binding DataContext.RotateLeftCommand, ElementName=PagesList}" CommandParameter="{Binding}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Button>
                            <TextBlock Text="{Binding Number, StringFormat={x:Static loc:Strings.Scan_LabelPage}}" Style="{StaticResource Caption}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <!-- Under the buttons: the clean up's list of what was done needs the width -->
                        <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="2,2,2,0"
                                   ToolTip="{Binding Note}" Visibility="{Binding Note, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Photos on the glass: the scan, large, with a box over each photo -->
        <DockPanel Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                   Visibility="{Binding IsEditingPhotos, Converter={StaticResource VisibleWhen}}">
            <views:HeaderPanel DockPanel.Dock="Top" Margin="20,14,14,10" Gap="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PhotoPage.Number, StringFormat={x:Static loc:Strings.Scan_PhotosOnPage}}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="{x:Static loc:Strings.Scan_PhotosHelp}" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="{x:Static loc:Strings.Scan_AddPhoto}" Command="{Binding AddPhotoCommand}" Margin="0,0,8,0" />
                        <Button Content="{x:Static loc:Strings.Scan_RemovePhoto}" Command="{Binding RemovePhotoCommand}" Margin="0,0,8,0" />
                        <Button Content="{x:Static loc:Strings.Scan_TurnSavedPhoto}" Command="{Binding TurnPhotoCommand}" Margin="0,0,8,0"
                                ToolTip="{x:Static loc:Strings.Scan_TurnSavedPhotoTip}" />
                        <Button Content="{x:Static loc:Strings.Scan_FindAgain}" Command="{Binding FindPhotosAgainCommand}" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                ToolTip="{x:Static loc:Strings.Scan_FindAgainTip}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding PhotoStatus}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="{x:Static loc:Strings.Common_Cancel}" Command="{Binding CancelPhotosCommand}" Margin="0,0,8,0" IsCancel="True" />
                    <Button Content="{x:Static loc:Strings.Common_Done}" Command="{Binding ApplyPhotosCommand}" Style="{DynamicResource AccentButtonStyle}" />
                </StackPanel>
            </views:HeaderPanel>
            <Grid Margin="20,0,20,20">
                <TextBlock Text="{x:Static loc:Strings.Scan_LoadingScan}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding PhotoImage, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                <views:PhotoBoxesView x:Name="PhotoBoxes" Source="{Binding PhotoImage}" Boxes="{Binding EditedPhotos}" SelectedIndex="{Binding SelectedPhoto}"
                                      AutomationProperties.Name="{x:Static loc:Strings.Scan_PhotosOnGlass}"
                                      AutomationProperties.HelpText="{x:Static loc:Strings.Scan_PhotoBoxesHelp}" />
            </Grid>
        </DockPanel>

        <!-- Crop: one page, large, with the box to keep -->
        <DockPanel Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                   Visibility="{Binding IsCropping, Converter={StaticResource VisibleWhen}}">
            <views:HeaderPanel DockPanel.Dock="Top" Margin="20,14,14,10" Gap="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CropPage.Number, StringFormat={x:Static loc:Strings.Scan_UndoCropPage}}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="{x:Static loc:Strings.Scan_CropHelp}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{x:Static loc:Strings.Scan_WholePage}" Command="{Binding ResetCropCommand}" Style="{StaticResource LinkButton}" Margin="0,0,16,0" />
                    <Button Content="{x:Static loc:Strings.Common_Cancel}" Command="{Binding CancelCropCommand}" Margin="0,0,8,0" IsCancel="True" />
                    <Button Content="{x:Static loc:Strings.Scan_Crop}" Command="{Binding ApplyCropCommand}" Style="{DynamicResource AccentButtonStyle}" />
                </StackPanel>
            </views:HeaderPanel>
            <Grid Margin="20,0,20,20">
                <TextBlock Text="{x:Static loc:Strings.Scan_LoadingPage}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding CropImage, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                <views:CropView x:Name="Cropper" Source="{Binding CropImage}" Box="{Binding CropBox}"
                                AutomationProperties.Name="{x:Static loc:Strings.Scan_CropBox}"
                                AutomationProperties.HelpText="{x:Static loc:Strings.Scan_CropBoxHelp}" />
            </Grid>
        </DockPanel>

        <!-- Clean up: one page, large, with the filters to turn on and off -->
        <DockPanel Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                   Visibility="{Binding IsCleaning, Converter={StaticResource VisibleWhen}}">
            <views:HeaderPanel DockPanel.Dock="Top" Margin="20,14,14,10" Gap="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CleanTitle}" FontSize="14" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox x:Name="FirstCleanChoice" Content="{x:Static loc:Strings.Scan_CropToPaper}" IsChecked="{Binding CleanCrop}" Margin="0,0,16,4" AutomationProperties.Name="{x:Static loc:Strings.Scan_CropToPaper}"
                                  ToolTip="{x:Static loc:Strings.Scan_CropToPaperTip}"
                                  Visibility="{Binding CleansWholePage, Converter={StaticResource VisibleWhen}}" />
                        <CheckBox Content="{x:Static loc:Strings.Scan_Whiten}" IsChecked="{Binding CleanWhiten}" Margin="0,0,16,4" AutomationProperties.Name="{x:Static loc:Strings.Scan_Whiten}"
                                  ToolTip="{x:Static loc:Strings.Scan_WhitenTip}"
                                  Visibility="{Binding CleansWholePage, Converter={StaticResource VisibleWhen}}" />
                        <CheckBox Content="{x:Static loc:Strings.Scan_Descreen}" IsChecked="{Binding CleanDescreen}" Margin="0,0,16,4" AutomationProperties.Name="{x:Static loc:Strings.Scan_Descreen}"
                                  ToolTip="{x:Static loc:Strings.Scan_DescreenTip}" />
                        <CheckBox Content="{x:Static loc:Strings.Scan_RestoreColors}" IsChecked="{Binding CleanRestore}" Margin="0,0,16,4" AutomationProperties.Name="{x:Static loc:Strings.Scan_RestoreColors}"
                                  ToolTip="{x:Static loc:Strings.Scan_RestoreColorsTip}" />
                        <ToggleButton Content="{x:Static loc:Strings.Scan_ShowAsScanned}" IsChecked="{Binding ShowOriginal}" AutomationProperties.Name="{x:Static loc:Strings.Scan_ShowAsScanned}"
                                      ToolTip="{x:Static loc:Strings.Scan_ShowAsScannedTip}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding CleanStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="{x:Static loc:Strings.Scan_AllPages}" Command="{Binding ApplyCleanToAllCommand}" Style="{StaticResource LinkButton}" Margin="0,0,16,0"
                            ToolTip="{x:Static loc:Strings.Scan_AllPagesTip}" AutomationProperties.Name="{x:Static loc:Strings.Scan_ApplyToAllPages}" />
                    <Button Content="{x:Static loc:Strings.Common_Cancel}" Command="{Binding CancelCleanCommand}" Margin="0,0,8,0" IsCancel="True" />
                    <Button Content="{x:Static loc:Strings.Common_Done}" Command="{Binding ApplyCleanCommand}" Style="{DynamicResource AccentButtonStyle}" />
                </StackPanel>
            </views:HeaderPanel>
            <Grid Margin="20,0,20,20">
                <TextBlock Text="{x:Static loc:Strings.Scan_LoadingPage}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding CleanImage, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="White" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Image Source="{Binding CleanImage}" Stretch="Uniform" AutomationProperties.Name="{x:Static loc:Strings.Scan_PageAsSaved}" />
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
