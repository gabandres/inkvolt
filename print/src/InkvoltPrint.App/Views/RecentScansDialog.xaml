<Window x:Class="InkvoltPrint.App.Views.RecentScansDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:InkvoltPrint.App"
        xmlns:vm="clr-namespace:InkvoltPrint.App.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:RecentScansViewModel}"
        Title="{x:Static loc:Strings.Recent_Title}" Icon="/InkvoltPrint.ico" SizeToContent="Height" Width="600" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Recent scans (roadmap 4.15): the last saves, each with Open, Show in folder, Email and Print. Kept on this PC only. -->
    <DockPanel Margin="24,20,24,20">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Common_Close}" IsCancel="True" IsDefault="True" MinWidth="96"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button DockPanel.Dock="Left" Content="{x:Static loc:Strings.Recent_Clear}" Command="{Binding ClearCommand}" Style="{StaticResource LinkButton}"
                    VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:Strings.Recent_Intro}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,0,0,12" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}" />
        <Grid>
            <TextBlock Text="{x:Static loc:Strings.Recent_Empty}" TextWrapping="Wrap" Margin="0,8"
                       Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" />
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,14,0">
                <ItemsControl ItemsSource="{Binding Items}" Focusable="False" AutomationProperties.Name="{x:Static loc:Strings.Recent_Title}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RecentScanRow}">
                            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Scan.Files[0]}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,4" />
                                    <WrapPanel>
                                        <Button Content="{x:Static loc:Strings.Common_Open}" Style="{StaticResource LinkButton}" Margin="0,0,16,0"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Title, StringFormat={x:Static loc:Strings.Recent_OpenName}}" />
                                        <Button Content="{x:Static loc:Strings.ScanTab_ShowInFolder}" Style="{StaticResource LinkButton}" Margin="0,0,16,0"
                                                Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Title, StringFormat={x:Static loc:Strings.Recent_ShowName}}" />
                                        <Button Content="{x:Static loc:Strings.Recent_Email}" Style="{StaticResource LinkButton}" Margin="0,0,16,0"
                                                Command="{Binding DataContext.EmailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Title, StringFormat={x:Static loc:Strings.Recent_EmailName}}" />
                                        <Button Content="{x:Static loc:Strings.Recent_Print}" Style="{StaticResource LinkButton}" Margin="0,0,16,0"
                                                Command="{Binding DataContext.PrintCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Title, StringFormat={x:Static loc:Strings.Recent_PrintName}}"
                                                Visibility="{Binding DataContext.CanPrint, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource VisibleWhen}}" />
                                        <Button Content="{x:Static loc:Strings.Recent_Remove}" Style="{StaticResource LinkButton}"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Title, StringFormat={x:Static loc:Strings.Recent_RemoveName}}"
                                                ToolTip="{x:Static loc:Strings.Recent_RemoveTip}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
