<Window x:Class="InkvoltPrint.App.Views.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InkvoltPrint.App"
        Title="{x:Static loc:Strings.Help_Title}" Icon="/InkvoltPrint.ico" SizeToContent="Height" Width="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{x:Static loc:Strings.Help_Shortcuts}" Style="{StaticResource CardTitle}" />
        <Grid x:Name="Shortcuts" AutomationProperties.Name="{x:Static loc:Strings.Help_Shortcuts}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>

        <TextBlock Text="{x:Static loc:Strings.Help_CantFind}" Style="{StaticResource CardTitle}" Margin="0,20,0,8" />
        <TextBlock TextWrapping="Wrap"
                   Text="{x:Static loc:Strings.Help_CantFindText}" />

        <WrapPanel Margin="0,20,0,0">
            <Button Content="{x:Static loc:Strings.Help_WhatsNew}" Click="WhatsNew_Click" Margin="0,0,8,8" />
            <Button Content="{x:Static loc:Strings.Help_Report}" Click="Report_Click" Margin="0,0,8,8"
                    ToolTip="{x:Static loc:Strings.Help_ReportTip}" />
            <Button Content="{x:Static loc:Strings.Help_LogFolder}" Click="LogFolder_Click" Margin="0,0,8,8" />
            <Button Content="{x:Static loc:Strings.Help_Pro}" Click="Pro_Click" Margin="0,0,8,8"
                    ToolTip="{x:Static loc:Strings.Help_ProTip}" />
        </WrapPanel>
        <Button Content="{x:Static loc:Strings.Common_Close}" IsCancel="True" IsDefault="True" MinWidth="96" HorizontalAlignment="Right" Margin="0,12,0,0"
                Style="{DynamicResource AccentButtonStyle}" />
    </StackPanel>
</Window>
