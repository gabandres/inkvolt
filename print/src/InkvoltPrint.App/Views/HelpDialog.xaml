<Window x:Class="InkvoltPrint.App.Views.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inkvolt Print help" Icon="/InkvoltPrint.ico" SizeToContent="Height" Width="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Keyboard shortcuts" Style="{StaticResource CardTitle}" />
        <Grid x:Name="Shortcuts" AutomationProperties.Name="Keyboard shortcuts">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>

        <TextBlock Text="Can't find a printer?" Style="{StaticResource CardTitle}" Margin="0,20,0,8" />
        <TextBlock TextWrapping="Wrap"
                   Text="Inkvolt Print finds printers on the same network as this PC. A VPN, a firewall that blocks finding devices, or a printer on another network (a guest Wi-Fi, another subnet) can hide one: use Add a printer by address, under the printer list, with the IP address from the printer's network report." />

        <WrapPanel Margin="0,20,0,0">
            <Button Content="What's new" Click="WhatsNew_Click" Margin="0,0,8,8" />
            <Button Content="Report a problem…" Click="Report_Click" Margin="0,0,8,8"
                    ToolTip="Copy the details a report needs, then open a GitHub issue to paste them in. Nothing is sent by Inkvolt Print." />
            <Button Content="Open log folder" Click="LogFolder_Click" Margin="0,0,8,8" />
        </WrapPanel>
        <Button Content="Close" IsCancel="True" IsDefault="True" MinWidth="96" HorizontalAlignment="Right" Margin="0,12,0,0"
                Style="{DynamicResource AccentButtonStyle}" />
    </StackPanel>
</Window>
