<Window x:Class="InkvoltPrint.App.Views.HandDuplexDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InkvoltPrint.App"
        Title="{x:Static loc:Strings.Hand_Title}" Icon="/InkvoltPrint.ico" SizeToContent="Height" Width="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Two-sided by hand (roadmap 4.2), between the fronts and the backs: how to put the stack back, which depends on which
         way up the sheets came out (the person confirms it) and on an odd last sheet. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,16" BorderThickness="0,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PrintBacks" Content="{x:Static loc:Strings.Hand_PrintBacks}" Click="PrintBacks_Click" IsDefault="True" MinWidth="104" Margin="0,0,8,0"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="{x:Static loc:Strings.Hand_Stop}" IsCancel="True" MinWidth="104" />
            </StackPanel>
        </Border>
        <StackPanel Margin="24,22,24,22">
            <TextBlock x:Name="Heading" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static loc:Strings.Hand_Wait}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Text="{x:Static loc:Strings.Hand_CameOut}" FontWeight="SemiBold" Margin="0,16,0,6" />
            <RadioButton x:Name="Down" GroupName="face" Checked="Face_Changed" AutomationProperties.Name="{x:Static loc:Strings.Hand_FaceDown}">
                <TextBlock Text="{x:Static loc:Strings.Hand_FaceDown}" TextWrapping="Wrap" />
            </RadioButton>
            <RadioButton x:Name="Up" GroupName="face" Checked="Face_Changed" Margin="0,6,0,0" AutomationProperties.Name="{x:Static loc:Strings.Hand_FaceUp}">
                <TextBlock Text="{x:Static loc:Strings.Hand_FaceUp}" TextWrapping="Wrap" />
            </RadioButton>
            <StackPanel x:Name="Steps" Margin="0,16,0,0" />
            <TextBlock Text="{x:Static loc:Strings.Hand_TrayNote}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
        </StackPanel>
    </DockPanel>
</Window>
