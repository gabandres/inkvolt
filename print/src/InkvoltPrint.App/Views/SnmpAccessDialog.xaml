<Window x:Class="InkvoltPrint.App.Views.SnmpAccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InkvoltPrint.App"
        Title="SNMP access" Icon="/InkvoltPrint.ico" SizeToContent="Height" Width="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Inkvolt Print reads this printer's status and supplies over SNMP, with the read community the printer's administrator set. It's kept in Windows Credential Manager, used only to read the printer, and never changes anything on it." />
        <TextBlock x:Name="CommunityLabel" Text="Community" Margin="0,0,0,6" />
        <TextBox x:Name="CommunityBox" MaxLength="255" local:Placeholder.Text="public"
                 AutomationProperties.LabeledBy="{Binding ElementName=CommunityLabel}" TextChanged="Community_Changed" />
        <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,6,0,0" Text="Leave it blank for public, the community most printers ship with." />
        <TextBlock x:Name="Error" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="Ok" Content="Save" IsDefault="True" Click="Ok_Click" MinWidth="96" Margin="0,0,8,0"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" IsCancel="True" MinWidth="96" />
        </StackPanel>
    </StackPanel>
</Window>
