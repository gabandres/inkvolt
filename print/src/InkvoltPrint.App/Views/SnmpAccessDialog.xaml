<Window x:Class="InkvoltPrint.App.Views.SnmpAccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:InkvoltPrint.App.Views"
        Title="SNMP access" Icon="/InkvoltPrint.ico" SizeToContent="Height" Width="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Inkvolt Print reads this printer's status and supplies over SNMP, with the read community or SNMPv3 user the printer's administrator set." />
        <views:SnmpAccessFields x:Name="Fields" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="Ok" Content="Save" IsDefault="True" Click="Ok_Click" MinWidth="96" Margin="0,0,8,0"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" IsCancel="True" MinWidth="96" />
        </StackPanel>
    </StackPanel>
</Window>
