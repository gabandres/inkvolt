<Window x:Class="InkvoltPrint.App.Views.SnmpAccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:InkvoltPrint.App.Views"
        xmlns:loc="clr-namespace:InkvoltPrint.App"
        Title="{x:Static loc:Strings.Snmp_Title}" Icon="/InkvoltPrint.ico" SizeToContent="Height" Width="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{x:Static loc:Strings.Snmp_Intro}" />
        <views:SnmpAccessFields x:Name="Fields" />
        <!-- What asking the printer with the login came to: refused (which part), another device, or no answer (Save anyway).
             Announced by the code (Prompt.Announce), as is "Asking the printer…" -->
        <TextBlock x:Name="Problem" Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        <DockPanel Margin="0,24,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="Ok" Content="{x:Static loc:Strings.Common_Save}" IsDefault="True" Click="Ok_Click" MinWidth="96" Margin="0,0,8,0"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="{x:Static loc:Strings.Common_Cancel}" IsCancel="True" MinWidth="96" />
            </StackPanel>
            <TextBlock x:Name="Asking" Text="{x:Static loc:Strings.Snmp_Asking}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
        </DockPanel>
    </StackPanel>
</Window>
