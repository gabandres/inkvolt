<Window x:Class="InkvoltPrint.App.Views.PrintLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:InkvoltPrint.App"
        xmlns:vm="clr-namespace:InkvoltPrint.App.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PrintLogViewModel}"
        Title="{x:Static loc:Strings.PrintLog_Title}" Icon="/InkvoltPrint.ico" SizeToContent="Height" Width="680" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- The print log (roadmap 4.9): every job this PC's spooler saw while Inkvolt Print ran, month totals, kept on this PC only. -->
    <Window.Resources>
        <DataTemplate x:Key="TotalLine" DataType="{x:Type vm:PrintLogTotalRow}">
            <StackPanel Margin="0,4" AutomationProperties.Name="{Binding Name}">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                    <Run Text="{Binding Pages, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Jobs, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="24,20,24,20">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Common_Close}" IsCancel="True" IsDefault="True" MinWidth="96"
                    Style="{DynamicResource AccentButtonStyle}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasJobs, Converter={StaticResource VisibleWhen}}">
                <Button Content="{x:Static loc:Strings.PrintLog_Export}" Command="{Binding ExportCommand}" Style="{StaticResource LinkButton}" Margin="0,0,16,0"
                        ToolTip="{x:Static loc:Strings.PrintLog_ExportTip}" />
                <Button Content="{x:Static loc:Strings.PrintLog_Clear}" Command="{Binding ClearCommand}" Style="{StaticResource LinkButton}"
                        ToolTip="{x:Static loc:Strings.PrintLog_ClearTip}" />
            </StackPanel>
        </DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{x:Static loc:Strings.PrintLog_Intro}" TextWrapping="Wrap" Style="{StaticResource Caption}" />
            <CheckBox Content="{x:Static loc:Strings.PrintLog_Keep}" IsChecked="{Binding IsOn}" Margin="0,10,0,0" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}" />
        <Grid Margin="0,12,0,0">
            <TextBlock Text="{x:Static loc:Strings.PrintLog_Empty}" TextWrapping="Wrap" Margin="0,8"
                       Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" />
            <DockPanel Visibility="{Binding HasJobs, Converter={StaticResource VisibleWhen}}">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="{x:Static loc:Strings.PrintLog_Month}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" MinWidth="180"
                              AutomationProperties.Name="{x:Static loc:Strings.PrintLog_Month}" />
                </StackPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Strings.PrintLog_ByPrinter}" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding ByPrinter}" ItemTemplate="{StaticResource TotalLine}" Focusable="False"
                                          AutomationProperties.Name="{x:Static loc:Strings.PrintLog_ByPrinter}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Strings.PrintLog_ByUser}" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding ByUser}" ItemTemplate="{StaticResource TotalLine}" Focusable="False"
                                          AutomationProperties.Name="{x:Static loc:Strings.PrintLog_ByUser}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:Strings.PrintLog_Jobs}" Style="{StaticResource CardTitle}" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding MoreText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding MoreText, Converter={StaticResource VisibleWhen}}" />
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,0,14,0">
                    <ItemsControl ItemsSource="{Binding Jobs}" Focusable="False" AutomationProperties.Name="{x:Static loc:Strings.PrintLog_Jobs}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                <Setter Property="AutomationProperties.HelpText" Value="{Binding Detail}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PrintLogRow}">
                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
