<Window x:Class="InkvoltPrint.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inkvolt Print" Icon="/InkvoltPrint.ico" SizeToContent="Height" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- The Windows dialog shape: the question as the heading (and the window's title), the explanation under it,
         the buttons on a footer, each saying what it does. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,16" BorderThickness="0,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="Confirm" Click="Confirm_Click" MinWidth="104" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" />
                <Button x:Name="Cancel" Content="Cancel" IsCancel="True" IsDefault="True" MinWidth="104" />
            </StackPanel>
        </Border>
        <StackPanel Margin="24,22,24,22">
            <TextBlock x:Name="Heading" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </DockPanel>
</Window>
