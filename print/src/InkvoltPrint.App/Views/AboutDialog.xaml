<Window x:Class="InkvoltPrint.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InkvoltPrint.App"
        xmlns:loc="clr-namespace:InkvoltPrint.App"
        Title="{x:Static loc:Strings.About_Title}" Icon="/InkvoltPrint.ico" SizeToContent="Height" Width="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Image local:AppIcon.Size="48" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Static loc:Strings.Common_InkvoltPrint}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" />
            </StackPanel>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="{x:Static loc:Strings.About_Summary}" />
        <TextBlock TextWrapping="Wrap" Text="{x:Static loc:Strings.About_Copyright}" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" FontSize="12"
                   Text="{x:Static loc:Strings.About_Trademarks}" />
        <TextBlock x:Name="PackagedNote" Style="{StaticResource Caption}" Margin="0,8,0,0" FontSize="12" Visibility="Collapsed"
                   Text="{x:Static loc:Strings.About_Packaged}" />
        <WrapPanel Margin="0,20,0,0">
            <Button Content="{x:Static loc:Strings.About_SourceCode}" Click="Source_Click" Margin="0,0,8,8" />
            <Button Content="{x:Static loc:Strings.About_License}" Click="License_Click" Margin="0,0,8,8" />
            <Button Content="{x:Static loc:Strings.About_Notices}" Click="Notices_Click" Margin="0,0,8,8" />
        </WrapPanel>
        <Button Content="{x:Static loc:Strings.Common_Close}" IsCancel="True" IsDefault="True" MinWidth="96" HorizontalAlignment="Right" Margin="0,12,0,0"
                Style="{DynamicResource AccentButtonStyle}" />
    </StackPanel>
</Window>
