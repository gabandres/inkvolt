<Window x:Class="InkvoltPrint.App.Views.AppSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inkvolt Print settings" Icon="/InkvoltPrint.ico" SizeToContent="Height" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="Theme" Margin="0,0,0,6" />
        <StackPanel x:Name="ThemeChoices" AutomationProperties.Name="Theme">
            <RadioButton Content="Use Windows' setting" Tag="System" GroupName="theme" Checked="Theme_Checked" />
            <RadioButton Content="Light" Tag="Light" GroupName="theme" Margin="0,6,0,0" Checked="Theme_Checked" />
            <RadioButton Content="Dark" Tag="Dark" GroupName="theme" Margin="0,6,0,0" Checked="Theme_Checked" />
        </StackPanel>
        <Button Content="Close" IsCancel="True" IsDefault="True" MinWidth="96" HorizontalAlignment="Right" Margin="0,24,0,0"
                Style="{DynamicResource AccentButtonStyle}" />
    </StackPanel>
</Window>
