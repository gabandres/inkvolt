<Window x:Class="InkvoltPrint.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:InkvoltPrint.App.Views"
        Title="Inkvolt Print settings" Icon="/InkvoltPrint.ico" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,12,24,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" IsDefault="True" Click="Close_Click" MinWidth="96"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Reset to defaults" Click="Reset_Click" HorizontalAlignment="Left"
                        ToolTip="Theme, scan folder, Inkvolt PDF and the notification area back to how they start. Printers, presets and scans are kept." />
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,20">
                <TextBlock Text="Appearance" Style="{StaticResource CardTitle}" />
                <TextBlock Text="Theme" Margin="0,0,0,6" />
                <StackPanel x:Name="ThemeChoices" AutomationProperties.Name="Theme">
                    <RadioButton Content="Use Windows' setting" Tag="System" GroupName="theme" Checked="Theme_Checked" />
                    <RadioButton Content="Light" Tag="Light" GroupName="theme" Margin="0,6,0,0" Checked="Theme_Checked" />
                    <RadioButton Content="Dark" Tag="Dark" GroupName="theme" Margin="0,6,0,0" Checked="Theme_Checked" />
                </StackPanel>

                <TextBlock Text="Scanning" Style="{StaticResource CardTitle}" Margin="0,24,0,8" />
                <TextBlock Text="Save scans to" Margin="0,0,0,6" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Change…" Click="ChangeFolder_Click" Margin="8,0,0,0"
                            AutomationProperties.Name="Change the folder scans are saved to" />
                    <TextBox x:Name="FolderText" IsReadOnly="True" AutomationProperties.Name="Folder scans are saved to" VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Where Save opens; it follows the folder you last saved to. Presets save to their own folders." />
                <CheckBox x:Name="OpenInPdfBox" Margin="0,12,0,0" Checked="OpenInPdf_Changed" Unchecked="OpenInPdf_Changed"
                          AutomationProperties.Name="Open scans in Inkvolt PDF" AutomationProperties.HelpText="Each PDF you save opens there automatically">
                    <StackPanel>
                        <TextBlock Text="Open scans in Inkvolt PDF" />
                        <TextBlock Text="Each PDF you save opens there automatically" Style="{StaticResource Caption}" FontSize="12" />
                    </StackPanel>
                </CheckBox>
                <Button x:Name="PresetsButton" Content="Edit scan presets…" Click="Presets_Click" HorizontalAlignment="Left" Margin="0,12,0,0" />

                <StackPanel x:Name="AlertsSection">
                    <TextBlock Text="Notification area and alerts" Style="{StaticResource CardTitle}" Margin="0,24,0,8" />
                    <views:AlertSettingsPanel x:Name="Alerts" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
