<Window x:Class="InkvoltPrint.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:InkvoltPrint.App.Views"
        xmlns:loc="clr-namespace:InkvoltPrint.App"
        Title="{x:Static loc:Strings.AppSettings_Title}" Icon="/InkvoltPrint.ico" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,12,24,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Common_Close}" IsCancel="True" IsDefault="True" Click="Close_Click" MinWidth="96"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="{x:Static loc:Strings.AppSettings_ResetDefaults}" Click="Reset_Click" HorizontalAlignment="Left"
                        ToolTip="{x:Static loc:Strings.AppSettings_ResetTip}" />
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,20">
                <TextBlock Text="{x:Static loc:Strings.AppSettings_Appearance}" Style="{StaticResource CardTitle}" />
                <TextBlock Text="{x:Static loc:Strings.AppSettings_Theme}" Margin="0,0,0,6" />
                <StackPanel x:Name="ThemeChoices" AutomationProperties.Name="{x:Static loc:Strings.AppSettings_Theme}">
                    <RadioButton Content="{x:Static loc:Strings.AppSettings_ThemeWindows}" Tag="System" GroupName="theme" Checked="Theme_Checked" />
                    <RadioButton Content="{x:Static loc:Strings.AppSettings_ThemeLight}" Tag="Light" GroupName="theme" Margin="0,6,0,0" Checked="Theme_Checked" />
                    <RadioButton Content="{x:Static loc:Strings.AppSettings_ThemeDark}" Tag="Dark" GroupName="theme" Margin="0,6,0,0" Checked="Theme_Checked" />
                </StackPanel>
                <StackPanel x:Name="LanguageSection">
                    <TextBlock Text="{x:Static loc:Strings.Settings_Language}" Margin="0,16,0,6" />
                    <StackPanel x:Name="LanguageChoices" AutomationProperties.Name="{x:Static loc:Strings.Settings_Language}">
                        <RadioButton Content="{x:Static loc:Strings.Settings_LanguageWindows}" Tag="" GroupName="language" Checked="Language_Checked" />
                        <RadioButton Content="{x:Static loc:Strings.Settings_LanguageEnglish}" Tag="en" GroupName="language" Margin="0,6,0,0"
                                     Checked="Language_Checked" Language="en" />
                        <RadioButton Content="{x:Static loc:Strings.Settings_LanguageSpanish}" Tag="es" GroupName="language" Margin="0,6,0,0"
                                     Checked="Language_Checked" Language="es" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{x:Static loc:Strings.Settings_LanguageRestart}" />
                </StackPanel>

                <TextBlock Text="{x:Static loc:Strings.AppSettings_Scanning}" Style="{StaticResource CardTitle}" Margin="0,24,0,8" />
                <TextBlock Text="{x:Static loc:Strings.AppSettings_SaveScansTo}" Margin="0,0,0,6" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Common_Change}" Click="ChangeFolder_Click" Margin="8,0,0,0"
                            AutomationProperties.Name="{x:Static loc:Strings.AppSettings_ChangeFolderName}" />
                    <TextBox x:Name="FolderText" IsReadOnly="True" AutomationProperties.Name="{x:Static loc:Strings.AppSettings_FolderName}" VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{x:Static loc:Strings.AppSettings_FolderNote}" />
                <CheckBox x:Name="OpenInPdfBox" Margin="0,12,0,0" Checked="OpenInPdf_Changed" Unchecked="OpenInPdf_Changed"
                          AutomationProperties.Name="{x:Static loc:Strings.AppSettings_OpenInPdf}" AutomationProperties.HelpText="{x:Static loc:Strings.AppSettings_OpenInPdfNote}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.AppSettings_OpenInPdf}" />
                        <TextBlock Text="{x:Static loc:Strings.AppSettings_OpenInPdfNote}" Style="{StaticResource Caption}" FontSize="12" />
                    </StackPanel>
                </CheckBox>
                <Button x:Name="PresetsButton" Content="{x:Static loc:Strings.AppSettings_EditPresets}" Click="Presets_Click" HorizontalAlignment="Left" Margin="0,12,0,0" />

                <StackPanel x:Name="AlertsSection">
                    <TextBlock Text="{x:Static loc:Strings.AppSettings_TrayAlerts}" Style="{StaticResource CardTitle}" Margin="0,24,0,8" />
                    <views:AlertSettingsPanel x:Name="Alerts" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
