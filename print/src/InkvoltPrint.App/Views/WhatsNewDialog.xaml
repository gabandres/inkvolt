<Window x:Class="InkvoltPrint.App.Views.WhatsNewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's new in Inkvolt Print" Icon="/InkvoltPrint.ico" SizeToContent="Height" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="24,20,24,20">
        <Button DockPanel.Dock="Bottom" Content="Close" IsCancel="True" IsDefault="True" MinWidth="96" HorizontalAlignment="Right" Margin="0,20,0,0"
                Style="{DynamicResource AccentButtonStyle}" />
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="Entries" />
        </ScrollViewer>
    </DockPanel>
</Window>
