<UserControl x:Class="InkvoltPrint.App.Views.AlertSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:InkvoltPrint.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AlertSettingsViewModel}">
    <!-- Settings › Notification area and alerts: every change applies right away -->
    <StackPanel>
        <CheckBox x:Name="EnabledBox" IsChecked="{Binding Enabled}" FontWeight="SemiBold" Content="Keep Inkvolt Print in the notification area" />
        <TextBlock Style="{StaticResource Caption}" Margin="28,4,0,0"
                   Text="Its icon shows how your printers are doing. Closing the window leaves Inkvolt Print running there: it reads each printer every 5 minutes (every 15 on battery or a metered network, less often when one doesn't answer). Quit from the icon's menu. Off: Inkvolt Print runs only while its window is open." />

        <CheckBox IsChecked="{Binding StartWithWindowsOn}" IsEnabled="{Binding CanStartWithWindows}" Margin="0,14,0,0"
                  Content="Start with Windows, in the notification area" />
        <TextBlock Style="{StaticResource Caption}" Margin="28,4,0,0" Text="{Binding StartupNote}"
                   Visibility="{Binding StartupNote, Converter={StaticResource VisibleWhen}}" />

        <Border Style="{StaticResource Card}" Margin="0,18,0,0" IsEnabled="{Binding Enabled}">
            <StackPanel>
                <TextBlock Text="Alerts" Style="{StaticResource CardTitle}" />
                <CheckBox IsChecked="{Binding Alerts}" Content="Tell me about low supplies and printer problems" />
                <TextBlock Style="{StaticResource Caption}" Margin="28,4,0,0"
                           Text="Once per problem, as a Windows notification: a supply low or empty, a waste box almost full or full, a paper jam, no paper, an open cover or another printer error lasting a minute. Click it to see the printer. No ads, no shop links." />
                <StackPanel IsEnabled="{Binding Alerts}" Margin="28,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Low supply at" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding LowChoices}" SelectedItem="{Binding LowPercent}" MinWidth="90"
                                  AutomationProperties.Name="Low supply alert at percent" ItemStringFormat="{}{0}%" />
                        <TextBlock Text="or less" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding OfflineAlerts}" Margin="0,12,0,0"
                              Content="Tell me when a printer stops answering for 15 minutes" />
                    <CheckBox IsChecked="{Binding QuietHours}" Margin="0,12,0,0" Content="Quiet hours" />
                    <StackPanel Orientation="Horizontal" Margin="28,6,0,0" IsEnabled="{Binding QuietHours}">
                        <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding QuietFrom}" MinWidth="110" AutomationProperties.Name="Quiet hours from" />
                        <TextBlock Text="to" VerticalAlignment="Center" Margin="10,0,10,0" />
                        <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding QuietTo}" MinWidth="110" AutomationProperties.Name="Quiet hours to" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="28,4,0,0"
                               Text="Alerts that come up meanwhile wait until quiet hours end, if the problem is still there." />
                    <DockPanel Margin="0,12,0,0" Visibility="{Binding IsPaused, Converter={StaticResource VisibleWhen}}">
                        <Button DockPanel.Dock="Right" Content="Resume alerts" Command="{Binding ResumeAlertsCommand}" />
                        <TextBlock Text="{Binding PauseText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
