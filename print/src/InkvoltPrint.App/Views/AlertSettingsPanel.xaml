<UserControl x:Class="InkvoltPrint.App.Views.AlertSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:InkvoltPrint.App.ViewModels"
             xmlns:loc="clr-namespace:InkvoltPrint.App"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:AlertSettingsViewModel}">
    <!-- Settings › Notification area and alerts: every change applies right away -->
    <StackPanel>
        <CheckBox x:Name="EnabledBox" IsChecked="{Binding Enabled}" FontWeight="SemiBold" Content="{x:Static loc:Strings.Alerts_KeepInTray}" />
        <TextBlock Style="{StaticResource Caption}" Margin="28,4,0,0"
                   Text="{x:Static loc:Strings.Alerts_KeepInTrayNote}" />

        <CheckBox IsChecked="{Binding StartWithWindowsOn}" IsEnabled="{Binding CanStartWithWindows}" Margin="0,14,0,0"
                  Content="{x:Static loc:Strings.Alerts_StartWithWindows}" />
        <TextBlock Style="{StaticResource Caption}" Margin="28,4,0,0" Text="{Binding StartupNote}"
                   Visibility="{Binding StartupNote, Converter={StaticResource VisibleWhen}}" />

        <Border Style="{StaticResource Card}" Margin="0,18,0,0" IsEnabled="{Binding Enabled}">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Strings.Alerts_Title}" Style="{StaticResource CardTitle}" />
                <CheckBox IsChecked="{Binding Alerts}" Content="{x:Static loc:Strings.Alerts_TellMe}" />
                <TextBlock Style="{StaticResource Caption}" Margin="28,4,0,0"
                           Text="{x:Static loc:Strings.Alerts_TellMeNote}" />
                <StackPanel IsEnabled="{Binding Alerts}" Margin="28,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static loc:Strings.Alerts_LowAt}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding LowChoices}" SelectedItem="{Binding LowPercent}" MinWidth="90"
                                  AutomationProperties.Name="{x:Static loc:Strings.Alerts_LowAtName}" ItemStringFormat="{}{0}%" />
                        <TextBlock Text="{x:Static loc:Strings.Alerts_OrLess}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding OfflineAlerts}" Margin="0,12,0,0"
                              Content="{x:Static loc:Strings.Alerts_Offline}" />
                    <CheckBox IsChecked="{Binding JobAlerts}" Margin="0,12,0,0"
                              Content="{x:Static loc:Strings.Alerts_Jobs}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="28,4,0,0"
                               Text="{Binding JobAlertsNote}" />
                    <CheckBox IsChecked="{Binding QuietHours}" Margin="0,12,0,0" Content="{x:Static loc:Strings.Alerts_QuietHours}" />
                    <StackPanel Orientation="Horizontal" Margin="28,6,0,0" IsEnabled="{Binding QuietHours}">
                        <TextBlock Text="{x:Static loc:Strings.Alerts_From}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding QuietFrom}" MinWidth="110" AutomationProperties.Name="{x:Static loc:Strings.Alerts_QuietFromName}" />
                        <TextBlock Text="{x:Static loc:Strings.Alerts_To}" VerticalAlignment="Center" Margin="10,0,10,0" />
                        <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding QuietTo}" MinWidth="110" AutomationProperties.Name="{x:Static loc:Strings.Alerts_QuietToName}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="28,4,0,0"
                               Text="{x:Static loc:Strings.Alerts_QuietNote}" />
                    <DockPanel Margin="0,12,0,0" Visibility="{Binding IsPaused, Converter={StaticResource VisibleWhen}}">
                        <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Alerts_Resume}" Command="{Binding ResumeAlertsCommand}" />
                        <TextBlock Text="{Binding PauseText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
