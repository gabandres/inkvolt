<Window x:Class="InkvoltPrint.App.Views.ReportProblemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report a problem" Icon="/InkvoltPrint.ico" SizeToContent="Height" Width="680" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="These details help find the problem: the version, Windows, a few settings and the end of Inkvolt Print's log. IP addresses, printer IDs and serial numbers, file paths and your names are masked. Nothing is sent: copy them, then paste them into a GitHub issue or an e-mail. Delete anything you'd rather not share." />
        <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="NoWrap" Height="320" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Details to report" />
        <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="Collapsed" />
        <DockPanel Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" MinWidth="96" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Copy and open a GitHub issue" Click="CopyAndIssue_Click" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0"
                        IsDefault="True" ToolTip="Copies the details, then opens a new issue on GitHub in your browser to paste them in" />
                <Button Content="Copy" Click="Copy_Click" MinWidth="96" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
