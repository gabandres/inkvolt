<Window x:Class="InkvoltPrint.App.Views.ReportProblemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InkvoltPrint.App"
        Title="{x:Static loc:Strings.Report_Title}" Icon="/InkvoltPrint.ico" SizeToContent="Height" Width="680" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,20">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="{x:Static loc:Strings.Report_Intro}" />
        <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="NoWrap" Height="320" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{x:Static loc:Strings.Report_DetailsName}" />
        <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
        <DockPanel Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top">
                <Button x:Name="RecordButton" Content="{x:Static loc:Strings.Report_Record}" Click="Record_Click" MinWidth="150"
                        ToolTip="{x:Static loc:Strings.Report_RecordTip}" />
                <Button x:Name="ShowRecording" Content="{x:Static loc:Strings.Report_ShowFile}" Click="ShowRecording_Click" MinWidth="150" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="RecordNote" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Common_Close}" IsCancel="True" MinWidth="96" />
            <StackPanel Orientation="Horizontal">
                <Button Content="{x:Static loc:Strings.Report_CopyAndIssue}" Click="CopyAndIssue_Click" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0"
                        IsDefault="True" ToolTip="{x:Static loc:Strings.Report_CopyAndIssueTip}" />
                <Button Content="{x:Static loc:Strings.Common_Copy}" Click="Copy_Click" MinWidth="96" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
