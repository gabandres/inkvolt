<Window x:Class="InkvoltPrint.App.Views.ScanPresetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:InkvoltPrint.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ScanPresetsViewModel}"
        Title="Scan presets" Icon="/InkvoltPrint.ico" Width="900" Height="720" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="24,20,24,20">
        <!-- Save / Cancel -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Save" Click="Save_Click" IsDefault="True" MinWidth="96" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}"
                        IsEnabled="{Binding CanSave}" />
                <Button Content="Cancel" IsCancel="True" MinWidth="96" />
            </StackPanel>
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Visibility="{Binding IsReadOnly, Converter={StaticResource VisibleWhen}}"
                   Text="These presets were saved by a newer version of Inkvolt Print. This version can scan with them but doesn't change them, so nothing is lost when you update again." />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="A preset scans with its own settings and saves the file by itself: one click on the Scan tab or the Overview, or Ctrl+1 to Ctrl+9 for the first nine. Each scanner gets the closest it can do." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The list: order here is the order of the buttons -->
            <DockPanel Margin="0,0,20,0">
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="New" Command="{Binding NewCommand}" Margin="0,0,6,6" />
                    <Button Content="Duplicate" Command="{Binding DuplicateCommand}" Margin="0,0,6,6" />
                    <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,6,6" />
                    <Button Command="{Binding MoveUpCommand}" Margin="0,0,6,6" ToolTip="Move up (Alt+Up)" AutomationProperties.Name="Move up">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" />
                    </Button>
                    <Button Command="{Binding MoveDownCommand}" Margin="0,0,6,6" ToolTip="Move down (Alt+Down)" AutomationProperties.Name="Move down">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" />
                    </Button>
                </WrapPanel>
                <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name"
                         AutomationProperties.Name="Presets" AutomationProperties.HelpText="Alt+Up and Alt+Down move the selected preset.">
                    <ListBox.InputBindings>
                        <KeyBinding Modifiers="Alt" Key="Up" Command="{Binding MoveUpCommand}" />
                        <KeyBinding Modifiers="Alt" Key="Down" Command="{Binding MoveDownCommand}" />
                        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                    </ListBox.InputBindings>
                </ListBox>
            </DockPanel>

            <TextBlock Grid.Column="1" Text="No presets. New adds one." Style="{StaticResource Caption}"
                       Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />

            <!-- The selected preset -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}"
                          Visibility="{Binding Converter={StaticResource VisibleWhen}}" Focusable="False">
                <StackPanel Margin="0,0,12,0">
                    <StackPanel.Resources>
                        <Style x:Key="Label" TargetType="TextBlock">
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                        <Style x:Key="Error" TargetType="TextBlock">
                            <Setter Property="Margin" Value="0,4,0,0" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </Style>
                    </StackPanel.Resources>

                    <TextBlock Text="Name" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Preset name" MaxLength="60" />
                    <TextBlock Text="{Binding NameError}" Style="{StaticResource Error}" Visibility="{Binding NameError, Converter={StaticResource VisibleWhen}}" />

                    <TextBlock Text="Scan" Style="{StaticResource CardTitle}" Margin="0,20,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Source" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{x:Static vm:ScanPresetsViewModel.Sources}" SelectedItem="{Binding Source}" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Source" />
                            <CheckBox Content="Both sides (two-sided feeder)" IsChecked="{Binding TwoSided}" Margin="0,8,0,0" />
                            <TextBlock Text="Page size" Style="{StaticResource Label}" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{x:Static vm:ScanPresetsViewModel.PageSizes}" SelectedItem="{Binding PageSize}" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Page size" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Quality" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{x:Static vm:ScanPresetsViewModel.Resolutions}" SelectedItem="{Binding Resolution}" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Quality" />
                            <CheckBox Content="Color" IsChecked="{Binding Color}" Margin="0,8,0,0" />
                            <TextBlock Text="File type" Style="{StaticResource Label}" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{x:Static vm:ScanPresetsViewModel.FileTypes}" SelectedItem="{Binding FileType}" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="File type" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                        <CheckBox AutomationProperties.Name="Review before saving" AutomationProperties.HelpText="Turn, crop or reorder first" IsChecked="{Binding Review}" Margin="0,0,24,6">
                            <StackPanel>
                                <TextBlock Text="Review before saving" />
                                <TextBlock Text="Turn, crop or reorder first" Style="{StaticResource Caption}" FontSize="12" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox AutomationProperties.Name="Skip blank pages" AutomationProperties.HelpText="Left out when saving" IsChecked="{Binding SkipBlank}" Margin="0,0,24,6">
                            <StackPanel>
                                <TextBlock Text="Skip blank pages" />
                                <TextBlock Text="Left out when saving" Style="{StaticResource Caption}" FontSize="12" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox AutomationProperties.Name="Straighten pages" AutomationProperties.HelpText="Fixes pages scanned a little crooked" IsChecked="{Binding Straighten}" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Straighten pages" />
                                <TextBlock Text="Fixes pages scanned a little crooked" Style="{StaticResource Caption}" FontSize="12" />
                            </StackPanel>
                        </CheckBox>
                    </WrapPanel>
                    <TextBlock Text="Clean up each page" Style="{StaticResource Label}" Margin="0,8,0,4" />
                    <WrapPanel>
                        <CheckBox Content="Crop to the paper" IsChecked="{Binding CropToPaper}" Margin="0,0,24,6" AutomationProperties.Name="Crop to the paper"
                                  ToolTip="Takes off the lid around a sheet; a page it can't be sure of stays whole" />
                        <CheckBox Content="Whiten the background" IsChecked="{Binding WhitenPages}" Margin="0,0,24,6" AutomationProperties.Name="Whiten the background"
                                  ToolTip="Evens grey or yellowed paper out to white and removes specks" />
                        <CheckBox Content="Descreen printed pictures" IsChecked="{Binding DescreenPages}" Margin="0,0,24,6" AutomationProperties.Name="Descreen printed pictures"
                                  ToolTip="Takes the dots out of pictures from magazines and newspapers" />
                        <CheckBox Content="Restore faded colors" IsChecked="{Binding RestoreColors}" Margin="0,0,0,6" AutomationProperties.Name="Restore faded colors"
                                  ToolTip="Brings back the blacks and colors of a faded print" />
                    </WrapPanel>
                    <StackPanel Margin="0,4,0,0" Visibility="{Binding HasOcrLanguageChoice, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="Text language" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding OcrLanguages}" SelectedItem="{Binding OcrLanguage}" HorizontalAlignment="Left" MinWidth="220"
                                  AutomationProperties.Name="Text language" AutomationProperties.HelpText="The language text recognition reads" />
                    </StackPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Split into files at" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{x:Static vm:ScanPresetsViewModel.Splits}" SelectedItem="{Binding SplitAt}" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Split into files at"
                                      AutomationProperties.HelpText="Saves one feeder run as several files, a new one after each separator sheet" />
                        </StackPanel>
                        <CheckBox AutomationProperties.Name="Keep separator sheets" AutomationProperties.HelpText="As the first page of the next file" Grid.Column="2" IsChecked="{Binding KeepSeparators}" VerticalAlignment="Bottom"
                                  Visibility="{Binding Splits, Converter={StaticResource VisibleWhen}}">
                            <StackPanel>
                                <TextBlock Text="Keep separator sheets" />
                                <TextBlock Text="As the first page of the next file" Style="{StaticResource Caption}" FontSize="12" />
                            </StackPanel>
                        </CheckBox>
                    </Grid>
                    <CheckBox AutomationProperties.Name="Several photos on the glass" AutomationProperties.HelpText="Each photo saved by itself, cut out straight (glass scans only)" IsChecked="{Binding FindPhotos}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Several photos on the glass" />
                            <TextBlock Text="Each photo saved by itself, cut out straight (glass scans only)" Style="{StaticResource Caption}" FontSize="12" />
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="Save" Style="{StaticResource CardTitle}" Margin="0,20,0,8" />
                    <TextBlock Text="Save to" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding DataContext.Folders, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Folder}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Save to"
                              AutomationProperties.HelpText="Documents, Pictures, OneDrive or Dropbox folders on this PC, or another folder" />
                    <TextBlock Text="Subfolder (optional)" Style="{StaticResource Label}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding Subfolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Subfolder" />
                    <TextBlock Text="{Binding SubfolderError}" Style="{StaticResource Error}" Visibility="{Binding SubfolderError, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="File name" Style="{StaticResource Label}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="File name" />
                    <TextBlock Text="{Binding FileNameError}" Style="{StaticResource Error}" Visibility="{Binding FileNameError, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap">
                        <Run Text="Tokens:" /> <Run Text="{x:Static vm:ScanPresetsViewModel.TokenHelp}" FontFamily="Consolas" />
                        <LineBreak /><Run Text="{}{n} counts up with every scan saved with this preset. A name already taken gets -2, -3 at the end: nothing is overwritten." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap">
                        <Run Text="Next file:" /> <Run Text="{Binding Example, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </TextBlock>

                    <TextBlock Text="After saving" Style="{StaticResource Label}" Margin="0,16,0,4" />
                    <ComboBox ItemsSource="{x:Static vm:ScanPresetsViewModel.Afters}" SelectedItem="{Binding After}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="After saving" />
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding Note, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
