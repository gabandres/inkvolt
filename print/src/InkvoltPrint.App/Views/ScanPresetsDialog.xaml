<Window x:Class="InkvoltPrint.App.Views.ScanPresetsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InkvoltPrint.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:InkvoltPrint.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:ScanPresetsViewModel}"
        Title="{x:Static loc:Strings.Presets_Title}" Icon="/InkvoltPrint.ico" Width="900" Height="720" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="24,20,24,20">
        <!-- Save / Cancel -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{x:Static loc:Strings.Common_Save}" Click="Save_Click" IsDefault="True" MinWidth="96" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}"
                        IsEnabled="{Binding CanSave}" />
                <Button Content="{x:Static loc:Strings.Common_Cancel}" IsCancel="True" MinWidth="96" />
            </StackPanel>
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Visibility="{Binding IsReadOnly, Converter={StaticResource VisibleWhen}}"
                   Text="{x:Static loc:Strings.Presets_NewerVersion}" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="{x:Static loc:Strings.Presets_Intro}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The list: order here is the order of the buttons -->
            <DockPanel Margin="0,0,20,0">
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="{x:Static loc:Strings.Presets_New}" Command="{Binding NewCommand}" Margin="0,0,6,6" />
                    <Button Content="{x:Static loc:Strings.Presets_Duplicate}" Command="{Binding DuplicateCommand}" Margin="0,0,6,6" />
                    <Button Content="{x:Static loc:Strings.Common_Delete}" Command="{Binding DeleteCommand}" Margin="0,0,6,6" />
                    <Button Command="{Binding MoveUpCommand}" Margin="0,0,6,6" ToolTip="{x:Static loc:Strings.Presets_MoveUpTip}" AutomationProperties.Name="{x:Static loc:Strings.Presets_MoveUp}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" />
                    </Button>
                    <Button Command="{Binding MoveDownCommand}" Margin="0,0,6,6" ToolTip="{x:Static loc:Strings.Presets_MoveDownTip}" AutomationProperties.Name="{x:Static loc:Strings.Presets_MoveDown}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" />
                    </Button>
                </WrapPanel>
                <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name"
                         AutomationProperties.Name="{x:Static loc:Strings.Presets_List}" AutomationProperties.HelpText="{x:Static loc:Strings.Presets_ListHelp}">
                    <ListBox.InputBindings>
                        <KeyBinding Modifiers="Alt" Key="Up" Command="{Binding MoveUpCommand}" />
                        <KeyBinding Modifiers="Alt" Key="Down" Command="{Binding MoveDownCommand}" />
                        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                    </ListBox.InputBindings>
                </ListBox>
            </DockPanel>

            <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.Presets_None}" Style="{StaticResource Caption}"
                       Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />

            <!-- The selected preset -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}"
                          Visibility="{Binding Converter={StaticResource VisibleWhen}}" Focusable="False">
                <StackPanel Margin="0,0,12,0">
                    <StackPanel.Resources>
                        <Style x:Key="Label" TargetType="TextBlock">
                            <Setter Property="Margin" Value="0,0,0,4" />
                        </Style>
                        <Style x:Key="Error" TargetType="TextBlock">
                            <Setter Property="Margin" Value="0,4,0,0" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </Style>
                    </StackPanel.Resources>

                    <TextBlock Text="{x:Static loc:Strings.Presets_Name}" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static loc:Strings.Presets_PresetName}" MaxLength="60" />
                    <TextBlock Text="{Binding NameError}" Style="{StaticResource Error}" Visibility="{Binding NameError, Converter={StaticResource VisibleWhen}}" />

                    <TextBlock Text="{x:Static loc:Strings.Common_Scan}" Style="{StaticResource CardTitle}" Margin="0,20,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Strings.Presets_Source}" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{x:Static vm:ScanPresetsViewModel.Sources}" SelectedItem="{Binding Source}" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{x:Static loc:Strings.Presets_Source}" />
                            <CheckBox Content="{x:Static loc:Strings.Presets_BothSides}" IsChecked="{Binding TwoSided}" Margin="0,8,0,0" />
                            <TextBlock Text="{x:Static loc:Strings.Presets_PageSize}" Style="{StaticResource Label}" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{x:Static vm:ScanPresetsViewModel.PageSizes}" SelectedItem="{Binding PageSize}" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{x:Static loc:Strings.Presets_PageSize}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Static loc:Strings.Presets_Quality}" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{x:Static vm:ScanPresetsViewModel.Resolutions}" SelectedItem="{Binding Resolution}" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{x:Static loc:Strings.Presets_Quality}" />
                            <CheckBox Content="{x:Static loc:Strings.Presets_Color}" IsChecked="{Binding Color}" Margin="0,8,0,0" />
                            <TextBlock Text="{x:Static loc:Strings.Presets_FileType}" Style="{StaticResource Label}" Margin="0,12,0,4" />
                            <ComboBox ItemsSource="{x:Static vm:ScanPresetsViewModel.FileTypes}" SelectedItem="{Binding FileType}" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{x:Static loc:Strings.Presets_FileType}" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                        <CheckBox AutomationProperties.Name="{x:Static loc:Strings.Presets_Review}" AutomationProperties.HelpText="{x:Static loc:Strings.Presets_ReviewHelp}" IsChecked="{Binding Review}" Margin="0,0,24,6">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Presets_Review}" />
                                <TextBlock Text="{x:Static loc:Strings.Presets_ReviewHelp}" Style="{StaticResource Caption}" FontSize="12" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox AutomationProperties.Name="{x:Static loc:Strings.Presets_SkipBlank}" AutomationProperties.HelpText="{x:Static loc:Strings.Presets_SkipBlankHelp}" IsChecked="{Binding SkipBlank}" Margin="0,0,24,6">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Presets_SkipBlank}" />
                                <TextBlock Text="{x:Static loc:Strings.Presets_SkipBlankHelp}" Style="{StaticResource Caption}" FontSize="12" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox AutomationProperties.Name="{x:Static loc:Strings.Presets_Straighten}" AutomationProperties.HelpText="{x:Static loc:Strings.Presets_StraightenHelp}" IsChecked="{Binding Straighten}" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Presets_Straighten}" />
                                <TextBlock Text="{x:Static loc:Strings.Presets_StraightenHelp}" Style="{StaticResource Caption}" FontSize="12" />
                            </StackPanel>
                        </CheckBox>
                    </WrapPanel>
                    <TextBlock Text="{x:Static loc:Strings.Presets_CleanUp}" Style="{StaticResource Label}" Margin="0,8,0,4" />
                    <WrapPanel>
                        <CheckBox Content="{x:Static loc:Strings.Scan_CropToPaper}" IsChecked="{Binding CropToPaper}" Margin="0,0,24,6" AutomationProperties.Name="{x:Static loc:Strings.Scan_CropToPaper}"
                                  ToolTip="{x:Static loc:Strings.Presets_CropToPaperTip}" />
                        <CheckBox Content="{x:Static loc:Strings.Scan_Whiten}" IsChecked="{Binding WhitenPages}" Margin="0,0,24,6" AutomationProperties.Name="{x:Static loc:Strings.Scan_Whiten}"
                                  ToolTip="{x:Static loc:Strings.Presets_WhitenTip}" />
                        <CheckBox Content="{x:Static loc:Strings.Scan_Descreen}" IsChecked="{Binding DescreenPages}" Margin="0,0,24,6" AutomationProperties.Name="{x:Static loc:Strings.Scan_Descreen}"
                                  ToolTip="{x:Static loc:Strings.Scan_DescreenTip}" />
                        <CheckBox Content="{x:Static loc:Strings.Scan_RestoreColors}" IsChecked="{Binding RestoreColors}" Margin="0,0,0,6" AutomationProperties.Name="{x:Static loc:Strings.Scan_RestoreColors}"
                                  ToolTip="{x:Static loc:Strings.Scan_RestoreColorsTip}" />
                    </WrapPanel>
                    <StackPanel Margin="0,4,0,0" Visibility="{Binding HasOcrLanguageChoice, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{x:Static loc:Strings.Presets_TextLanguage}" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding OcrLanguages}" SelectedItem="{Binding OcrLanguage}" HorizontalAlignment="Left" MinWidth="220"
                                  AutomationProperties.Name="{x:Static loc:Strings.Presets_TextLanguage}" AutomationProperties.HelpText="{x:Static loc:Strings.Presets_TextLanguageHelp}" />
                    </StackPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Strings.Presets_SplitAt}" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{x:Static vm:ScanPresetsViewModel.Splits}" SelectedItem="{Binding SplitAt}" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="{x:Static loc:Strings.Presets_SplitAt}"
                                      AutomationProperties.HelpText="{x:Static loc:Strings.Presets_SplitAtHelp}" />
                        </StackPanel>
                        <CheckBox AutomationProperties.Name="{x:Static loc:Strings.Presets_KeepSeparators}" AutomationProperties.HelpText="{x:Static loc:Strings.Presets_KeepSeparatorsHelp}" Grid.Column="2" IsChecked="{Binding KeepSeparators}" VerticalAlignment="Bottom"
                                  Visibility="{Binding Splits, Converter={StaticResource VisibleWhen}}">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Strings.Presets_KeepSeparators}" />
                                <TextBlock Text="{x:Static loc:Strings.Presets_KeepSeparatorsHelp}" Style="{StaticResource Caption}" FontSize="12" />
                            </StackPanel>
                        </CheckBox>
                    </Grid>
                    <CheckBox AutomationProperties.Name="{x:Static loc:Strings.Presets_SeveralPhotos}" AutomationProperties.HelpText="{x:Static loc:Strings.Presets_SeveralPhotosHelp}" IsChecked="{Binding FindPhotos}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Strings.Presets_SeveralPhotos}" />
                            <TextBlock Text="{x:Static loc:Strings.Presets_SeveralPhotosHelp}" Style="{StaticResource Caption}" FontSize="12" />
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="{x:Static loc:Strings.Common_Save}" Style="{StaticResource CardTitle}" Margin="0,20,0,8" />
                    <TextBlock Text="{x:Static loc:Strings.Presets_SaveTo}" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding DataContext.Folders, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Folder}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static loc:Strings.Presets_SaveTo}"
                              AutomationProperties.HelpText="{x:Static loc:Strings.Presets_SaveToHelp}" />
                    <TextBlock Text="{x:Static loc:Strings.Presets_SubfolderOptional}" Style="{StaticResource Label}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding Subfolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static loc:Strings.Presets_Subfolder}" />
                    <TextBlock Text="{Binding SubfolderError}" Style="{StaticResource Error}" Visibility="{Binding SubfolderError, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{x:Static loc:Strings.Presets_FileName}" Style="{StaticResource Label}" Margin="0,12,0,4" />
                    <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static loc:Strings.Presets_FileName}" />
                    <TextBlock Text="{Binding FileNameError}" Style="{StaticResource Error}" Visibility="{Binding FileNameError, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap">
                        <Run Text="{x:Static loc:Strings.Presets_Tokens}" /> <Run Text="{x:Static vm:ScanPresetsViewModel.TokenHelp}" FontFamily="Consolas" />
                        <LineBreak /><Run Text="{x:Static loc:Strings.Presets_CounterHelp}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap">
                        <Run Text="{x:Static loc:Strings.Presets_NextFile}" /> <Run Text="{Binding Example, Mode=OneWay}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </TextBlock>

                    <TextBlock Text="{x:Static loc:Strings.Presets_AfterSaving}" Style="{StaticResource Label}" Margin="0,16,0,4" />
                    <ComboBox ItemsSource="{x:Static vm:ScanPresetsViewModel.Afters}" SelectedItem="{Binding After}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="{x:Static loc:Strings.Presets_AfterSaving}" />
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding Note, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
