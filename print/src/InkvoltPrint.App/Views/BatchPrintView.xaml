<UserControl x:Class="InkvoltPrint.App.Views.BatchPrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:InkvoltPrint.App"
             xmlns:loc="clr-namespace:InkvoltPrint.App"
             xmlns:vm="clr-namespace:InkvoltPrint.App.ViewModels">
    <Grid Margin="0,0,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- What to add, the settings for all files, what it comes to -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <StackPanel>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.Batch_Title}" Style="{StaticResource CardTitle}" />
                        <Button Content="{x:Static loc:Strings.Batch_AddFilesButton}" Command="{Binding AddFilesCommand}" HorizontalAlignment="Stretch" Padding="0,8" />
                        <Button Content="{x:Static loc:Strings.Batch_AddFolderButton}" Command="{Binding AddFolderCommand}" HorizontalAlignment="Stretch" Padding="0,8" Margin="0,8,0,0" />

                        <TextBlock Text="{x:Static loc:Strings.Batch_ForAllFiles}" Margin="0,20,0,6" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static loc:Strings.Batch_Copies}" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding FewerCopiesCommand}" Width="36" ToolTip="{x:Static loc:Strings.Batch_FewerAll}" AutomationProperties.Name="{x:Static loc:Strings.Batch_FewerAll}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE738;" />
                            </Button>
                            <TextBox Text="{Binding AllCopies, UpdateSourceTrigger=PropertyChanged}" Width="56" Margin="6,0" TextAlignment="Center"
                                     AutomationProperties.Name="{x:Static loc:Strings.Batch_CopiesAll}" />
                            <Button Command="{Binding MoreCopiesCommand}" Width="36" ToolTip="{x:Static loc:Strings.Batch_MoreAll}" AutomationProperties.Name="{x:Static loc:Strings.Batch_MoreAll}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.Batch_Paper}" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding Papers}" SelectedItem="{Binding AllPaper}" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static loc:Strings.Batch_PaperAll}" />
                        <CheckBox Content="{x:Static loc:Strings.Batch_BothSidesAll}" IsChecked="{Binding AllTwoSided}" Margin="0,12,0,0"
                                  Visibility="{Binding CanTwoSided, Converter={StaticResource VisibleWhen}}"
                                  AutomationProperties.Name="{x:Static loc:Strings.Batch_BothSidesAllName}" />

                        <TextBlock Text="{Binding EstimateText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,0"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding EstimateText}"
                                   Visibility="{Binding HasRows, Converter={StaticResource VisibleWhen}}" />
                        <Button AutomationProperties.Name="{x:Static loc:Strings.Batch_PrintName}" Command="{Binding PrintCommand}" Style="{DynamicResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Padding="0,10" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE749;" Margin="0,0,8,0" />
                                <TextBlock Text="{x:Static loc:Strings.Common_Print}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Content="{x:Static loc:Strings.Common_Stop}" Command="{Binding StopCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                AutomationProperties.Name="{x:Static loc:Strings.Batch_StopName}"
                                Visibility="{Binding CanStop, Converter={StaticResource VisibleWhen}}" />
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0"
                                     Visibility="{Binding CanStop, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding Progress}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding Progress, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding Message}"
                                   Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.Batch_ForRegularJobs}" Style="{StaticResource CardTitle}" />
                        <Button Content="{x:Static loc:Strings.Batch_OpenListButton}" Command="{Binding OpenListCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" />
                        <Button Content="{x:Static loc:Strings.Batch_SaveListButton}" Command="{Binding SaveListCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        <Button Content="{x:Static loc:Strings.Batch_SaveResultsButton}" Command="{Binding ExportResultsCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        <Button Content="{x:Static loc:Strings.Batch_WatchButton}" Command="{Binding WatchFolderCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                ToolTip="{x:Static loc:Strings.Batch_WatchTip}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                                   Text="{x:Static loc:Strings.Batch_ProNote}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- The list -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                            Visibility="{Binding HasRows, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;" FontSize="48" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Static loc:Strings.Batch_DropHere}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="{x:Static loc:Strings.Batch_DropHint}"
                               Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <DockPanel Visibility="{Binding HasRows, Converter={StaticResource VisibleWhen}}">
                    <!-- A folder printing as it fills -->
                    <Border DockPanel.Dock="Bottom" Padding="12" Visibility="{Binding IsWatching, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Batch_StopWatching}" Command="{Binding StopWatchingCommand}" Margin="12,0,0,0" />
                                <TextBlock Text="{Binding WatchedFolder, StringFormat={x:Static loc:Strings.Batch_WatchingFolder}}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding WatchLines}" MaxHeight="120" Margin="0,8,0,0" AutomationProperties.Name="{x:Static loc:Strings.Batch_WatchLinesName}" />
                        </StackPanel>
                    </Border>

                    <!-- Wraps in a narrow window: a caption that shrank to nothing beside the links would wrap a letter to a line and push the list out of view -->
                    <WrapPanel DockPanel.Dock="Top" Margin="12,12,12,4">
                        <TextBlock Text="{x:Static loc:Strings.Batch_TopDown}" Style="{StaticResource Caption}" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                   ToolTip="{x:Static loc:Strings.Batch_KeysTip}" />
                        <Button Content="{x:Static loc:Strings.Batch_CheckAgain}" Command="{Binding CheckAgainCommand}" Style="{StaticResource LinkButton}" Margin="0,0,12,0"
                                ToolTip="{x:Static loc:Strings.Batch_CheckAgainTip}" />
                        <Button Content="{x:Static loc:Strings.Batch_StartOver}" Command="{Binding StartOverCommand}" Style="{StaticResource LinkButton}" Margin="0,0,12,0"
                                ToolTip="{x:Static loc:Strings.Batch_StartOverTip}" />
                        <Button Content="{x:Static loc:Strings.Batch_OpenQueue}" Command="{Binding OpenPrintQueueCommand}" Style="{StaticResource LinkButton}" Margin="0,0,12,0" />
                        <Button Content="{x:Static loc:Strings.Batch_RemoveAll}" Command="{Binding ClearCommand}" Style="{StaticResource LinkButton}" />
                    </WrapPanel>

                    <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{x:Static loc:Strings.Batch_ListName}"
                             Background="Transparent" BorderThickness="0" Padding="8,0,8,8" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             KeyboardNavigation.TabNavigation="Local">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
                            <KeyBinding Modifiers="Alt" Key="Up" Command="{Binding MoveUpCommand}" />
                            <KeyBinding Modifiers="Alt" Key="Down" Command="{Binding MoveDownCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,6" />
                                <!-- Focus on a row's box selects the row, so Alt+Up and Alt+Down move the file in focus -->
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="IsSelected" Value="True" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BatchRowViewModel}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SheetsText}" FontWeight="SemiBold" Margin="12,0,0,0" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PagesText}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Margin="12,0,0,0" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <DockPanel Margin="0,4,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0" IsEnabled="{Binding DataContext.IsFree, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                        <Button Style="{StaticResource LinkButton}" MinWidth="24" ToolTip="{x:Static loc:Strings.Batch_MoveUpTip}"
                                                AutomationProperties.Name="{Binding Name, StringFormat={x:Static loc:Strings.Batch_MoveUpName}}"
                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70E;" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource LinkButton}" Margin="6,0,0,0" MinWidth="24" ToolTip="{x:Static loc:Strings.Batch_MoveDownTip}"
                                                AutomationProperties.Name="{Binding Name, StringFormat={x:Static loc:Strings.Batch_MoveDownName}}"
                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource LinkButton}" Margin="6,0,0,0" MinWidth="24" ToolTip="{x:Static loc:Strings.Batch_RemoveTip}"
                                                AutomationProperties.Name="{Binding Name, StringFormat={x:Static loc:Strings.Batch_RemoveName}}"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                    <WrapPanel IsEnabled="{Binding Editable}">
                                        <Button Command="{Binding FewerCopiesCommand}" Width="28" MinHeight="24" Padding="0" ToolTip="{x:Static loc:Strings.Batch_Fewer}"
                                                AutomationProperties.Name="{Binding Name, StringFormat={x:Static loc:Strings.Batch_FewerName}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE738;" FontSize="12" />
                                        </Button>
                                        <TextBox Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}" Width="44" Margin="4,0" TextAlignment="Center" VerticalAlignment="Center"
                                                 ToolTip="{x:Static loc:Strings.Batch_Copies}" AutomationProperties.Name="{Binding Name, StringFormat={x:Static loc:Strings.Batch_CopiesName}}" />
                                        <Button Command="{Binding MoreCopiesCommand}" Width="28" MinHeight="24" Padding="0" ToolTip="{x:Static loc:Strings.Batch_More}" Margin="0,0,12,0"
                                                AutomationProperties.Name="{Binding Name, StringFormat={x:Static loc:Strings.Batch_MoreName}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" />
                                        </Button>
                                        <TextBox Text="{Binding Range, UpdateSourceTrigger=PropertyChanged}" Width="96" Margin="0,0,12,0" VerticalAlignment="Center"
                                                 local:Placeholder.Text="{x:Static loc:Strings.Batch_AllPages}"
                                                 ToolTip="{x:Static loc:Strings.Batch_PagesTip}" AutomationProperties.Name="{Binding Name, StringFormat={x:Static loc:Strings.Batch_PagesName}}"
                                                 AutomationProperties.HelpText="{x:Static loc:Strings.Batch_PagesHelp}" />
                                        <ComboBox ItemsSource="{Binding Papers}" SelectedItem="{Binding Paper}" MinWidth="140" MaxWidth="220" Margin="0,0,12,0" VerticalAlignment="Center"
                                                  ToolTip="{x:Static loc:Strings.Batch_Paper}" AutomationProperties.Name="{Binding Name, StringFormat={x:Static loc:Strings.Batch_PaperName}}" />
                                        <CheckBox Content="{x:Static loc:Strings.Batch_BothSides}" IsChecked="{Binding TwoSided}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  AutomationProperties.Name="{Binding Name, StringFormat={x:Static loc:Strings.Batch_BothSidesName}}"
                                                  Visibility="{Binding ShowTwoSided, Converter={StaticResource VisibleWhen}}" />
                                    </WrapPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,2,0,0" Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}">
                                        <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Batch_EnterPassword}" Style="{StaticResource LinkButton}" Margin="12,0,0,0"
                                                AutomationProperties.Name="{Binding Name, StringFormat={x:Static loc:Strings.Batch_PasswordName}}"
                                                Command="{Binding DataContext.EnterPasswordCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                Visibility="{Binding NeedsPassword, Converter={StaticResource VisibleWhen}}" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
