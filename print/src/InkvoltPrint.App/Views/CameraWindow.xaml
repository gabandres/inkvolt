<Window x:Class="InkvoltPrint.App.Views.CameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:InkvoltPrint.App"
        Title="{x:Static loc:Strings.Camera_Title}" Icon="/InkvoltPrint.ico" Width="860" Height="700" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="Window_PreviewKeyDown">
    <!-- A camera scan (roadmap 4.12): the camera's live picture, Capture page (Space) for each page, Done. Closing it ends the scan
         and stops the camera; the pages go to the Scan tab's review. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20,14" BorderThickness="0,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding CaptureCommand}" IsDefault="True" MinWidth="140" Margin="12,0,8,0" Style="{DynamicResource AccentButtonStyle}"
                            AutomationProperties.Name="{x:Static loc:Strings.Camera_Capture}" ToolTip="{x:Static loc:Strings.Camera_CaptureTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE722;" Margin="0,0,8,0" />
                            <TextBlock Text="{x:Static loc:Strings.Camera_Capture}" />
                        </StackPanel>
                    </Button>
                    <Button Content="{x:Static loc:Strings.Phone_Finish}" Command="{Binding DoneCommand}" MinWidth="104" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding Camera}" DisplayMemberPath="Name" MinWidth="220" HorizontalAlignment="Left" Margin="0,0,0,6"
                              AutomationProperties.Name="{x:Static loc:Strings.Camera_Which}"
                              Visibility="{Binding HasCameraChoice, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Background="Black">
            <Image Source="{Binding Preview}" Stretch="Uniform" AutomationProperties.Name="{x:Static loc:Strings.Camera_PreviewName}" />
        </Grid>
    </DockPanel>
</Window>
