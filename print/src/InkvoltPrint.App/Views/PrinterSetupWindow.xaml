<Window x:Class="InkvoltPrint.App.Views.PrinterSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:InkvoltPrint.App"
        xmlns:vm="clr-namespace:InkvoltPrint.App.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PrinterSetupViewModel}"
        Title="{x:Static loc:Strings.Setup_Title}" Icon="/InkvoltPrint.ico" SizeToContent="Height" Width="600" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Set up a new printer's Wi-Fi (roadmap 4.17): its setup network, its own page, back home. Steps are Core.Setup.PrinterSetupGuide's. -->
    <DockPanel Margin="24,20,24,20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Top"
                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE701;" FontSize="22" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <StackPanel>
                <TextBlock Text="{x:Static loc:Strings.Setup_Title}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{x:Static loc:Strings.Setup_Intro}" />
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Common_Close}" IsCancel="True" MinWidth="96" />
            <Button DockPanel.Dock="Left" Content="{x:Static loc:Strings.Setup_LookAgain}" Command="{Binding LookCommand}" Style="{StaticResource LinkButton}"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{Binding CanLookAgain, Converter={StaticResource VisibleWhen}}" />
        </DockPanel>

        <StackPanel>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" AutomationProperties.Name="{Binding Status}"
                         Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                       Visibility="{Binding Status, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"
                       Visibility="{Binding HasProblem, Converter={StaticResource VisibleWhen}}" />
            <Button Content="{x:Static loc:Strings.Setup_LocationSettings}" Command="{Binding OpenLocationSettingsCommand}" Style="{StaticResource LinkButton}"
                    HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding IsLocationOff, Converter={StaticResource VisibleWhen}}" />

            <!-- 1. The printers' networks nearby -->
            <ItemsControl ItemsSource="{Binding Networks}" Margin="0,8,0,0" Focusable="False" AutomationProperties.Name="{x:Static loc:Strings.Setup_Networks}"
                          Visibility="{Binding HasNetworks, Converter={StaticResource VisibleWhen}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SetupNetworkRow}">
                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,10" AutomationProperties.Name="{Binding Name}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Setup_Connect}" MinWidth="96" VerticalAlignment="Center" Margin="12,0,0,0"
                                        Style="{DynamicResource AccentButtonStyle}" AutomationProperties.HelpText="{Binding Name}"
                                        Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{x:Static loc:Strings.Setup_Promise}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Visibility="{Binding IsChoosing, Converter={StaticResource VisibleWhen}}" />

            <!-- 2. On the printer's network: its own page -->
            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsOnPrinter, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="{x:Static loc:Strings.Setup_OnPage}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="{x:Static loc:Strings.Setup_OpenPage}" Command="{Binding OpenPageCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,12,0"
                            Visibility="{Binding HasPage, Converter={StaticResource VisibleWhen}}" AutomationProperties.HelpText="{Binding PageAddress}" />
                    <Button Content="{x:Static loc:Strings.Setup_Done}" Command="{Binding ReturnCommand}" />
                </WrapPanel>
            </StackPanel>

            <!-- 3. It couldn't go back by itself -->
            <WrapPanel Margin="0,12,0,0" Visibility="{Binding CouldNotReturn, Converter={StaticResource VisibleWhen}}">
                <Button Content="{x:Static loc:Strings.Setup_OpenWifiList}" Command="{Binding OpenWifiListCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,12,0" />
                <Button Content="{x:Static loc:Strings.Setup_CheckAgain}" Command="{Binding CheckBackCommand}" />
            </WrapPanel>

            <!-- 4. Back home: the printer, once it's on the network -->
            <Button Content="{x:Static loc:Strings.Setup_ShowFound}" Command="{Binding ShowFoundCommand}" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Left"
                    Margin="0,12,0,0" Visibility="{Binding HasFound, Converter={StaticResource VisibleWhen}}" />
        </StackPanel>
    </DockPanel>
</Window>
