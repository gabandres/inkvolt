<Project>
  <!-- dotnet publish src/InkvoltPrint.App -p:PublishProfile=win-arm64  → one self-contained InkvoltPrint.exe, no .NET install needed -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Uncompressed: compression saves disk but unpacks every assembly into RAM (~80 MB) at startup -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\win-arm64\</PublishDir>
  </PropertyGroup>
</Project>
