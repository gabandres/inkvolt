<Window x:Class="PrintDesk.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password" Icon="/PrintDesk.ico" SizeToContent="Height" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,16"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="Rejected" Text="That password didn't work. Try again." Margin="0,0,0,8" Visibility="Collapsed"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        <PasswordBox x:Name="Password" AutomationProperties.Name="Password" PasswordChanged="Password_Changed" />
        <CheckBox x:Name="Remember" Content="Remember on this PC (stored in Windows Credential Manager)" IsChecked="True" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="Ok" Content="OK" IsDefault="True" IsEnabled="False" Click="Ok_Click" MinWidth="96" Margin="0,0,8,0"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" IsCancel="True" MinWidth="96" />
        </StackPanel>
    </StackPanel>
</Window>
