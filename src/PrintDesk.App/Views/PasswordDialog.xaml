<Window x:Class="PrintDesk.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Printer password" SizeToContent="Height" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock x:Name="Rejected" Text="That password was not accepted. Try again." Foreground="#D13438"
                   Margin="0,0,0,8" Visibility="Collapsed" />
        <PasswordBox x:Name="Password" AutomationProperties.Name="Admin password" />
        <CheckBox x:Name="Remember" Content="Remember on this PC (Windows Credential Manager)" IsChecked="True" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" IsDefault="True" Click="Ok_Click" Width="90" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" IsCancel="True" Width="90" />
        </StackPanel>
    </StackPanel>
</Window>
