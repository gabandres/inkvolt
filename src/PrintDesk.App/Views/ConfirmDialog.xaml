<Window x:Class="PrintDesk.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintDesk" Icon="/PrintDesk.ico" SizeToContent="Height" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="Message" TextWrapping="Wrap" FontSize="14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="Confirm" Click="Confirm_Click" MinWidth="96" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" IsCancel="True" IsDefault="True" MinWidth="96" />
        </StackPanel>
    </StackPanel>
</Window>
