<Window x:Class="PrintDesk.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PrintDesk.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="PrintDesk" Icon="/PrintDesk.ico" Width="1180" Height="800" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <Window.Resources>
        <!-- Shared per item (x:Shared=False gives each printer its own menu instance). -->
        <ContextMenu x:Key="PrinterMenu" x:Shared="False">
            <MenuItem Header="Reconnect" Command="{Binding ReconnectCommand}" />
            <MenuItem Header="Remove from PrintDesk…"
                      Command="{Binding PlacementTarget.Tag.ForgetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}" />
        </ContextMenu>

        <!-- ===================== Overview ===================== -->
        <DataTemplate x:Key="OverviewSection" DataType="{x:Type vm:PrinterViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel Margin="0,0,0,16">
                    <WrapPanel.Resources>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Width" Value="400" />
                            <Setter Property="Margin" Value="0,0,16,16" />
                            <Setter Property="VerticalAlignment" Value="Top" />
                        </Style>
                    </WrapPanel.Resources>

                    <!-- Status -->
                    <Border>
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,16,0" VerticalAlignment="Top">
                                <Ellipse Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                                <TextBlock Style="{StaticResource Icon}" HorizontalAlignment="Center" FontSize="18"
                                           Foreground="{Binding StatusKind, Converter={StaticResource StatusGlyphBrush}}"
                                           Text="{Binding StatusKind, Converter={StaticResource StatusGlyph}}" />
                            </Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           Visibility="{Binding StatusDetail, Converter={StaticResource VisibleWhen}}" />
                                <ItemsControl ItemsSource="{Binding Alerts}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Margin="0,0,8,0"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Try again now" Command="{Binding ReconnectCommand}" Margin="0,12,0,0" HorizontalAlignment="Left"
                                        Visibility="{Binding IsOnline, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Toner -->
                    <Border Visibility="{Binding Supplies.Count, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}">
                                <Run Text="Toner" /><Run Text="{Binding StaleSuffix, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Supplies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SupplyViewModel}">
                                        <StackPanel Margin="0,0,0,8">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Headline}" Style="{StaticResource Caption}"
                                                           VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                                <TextBlock Text="{Binding PercentText}" FontSize="28" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <Grid Height="8" Margin="0,6,0,0">
                                                <Border CornerRadius="4" Background="{DynamicResource ControlStrongFillColorDefaultBrush}" Opacity="0.25" />
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="8"
                                                             Background="Transparent" BorderThickness="0"
                                                             Foreground="{Binding Level, Converter={StaticResource LevelBrush}}"
                                                             AutomationProperties.Name="{Binding Name}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding Cartridge}" Style="{StaticResource Caption}"
                                                       Visibility="{Binding Cartridge, Converter={StaticResource VisibleWhen}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Usage -->
                    <Border Visibility="{Binding Stats.Count, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}">
                                <Run Text="Usage" /><Run Text="{Binding StaleSuffix, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Stats}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InfoRow}">
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Label}" FontSize="22" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- About -->
                    <Border Visibility="{Binding About.Count, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Text="About this printer" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding About}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InfoRow}">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                     Background="Transparent" Padding="0" MinHeight="0" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Printer web page" Command="{Binding OpenWebPageCommand}" Style="{StaticResource LinkButton}" Margin="0,0,20,0" />
                                <Button Content="Windows printer settings" Command="{Binding OpenPrintQueueCommand}" Style="{StaticResource LinkButton}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- ===================== Scan ===================== -->
        <DataTemplate DataType="{x:Type vm:ScanViewModel}">
            <Grid Margin="0,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,16,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Scan settings" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Source" Margin="0,0,0,4" Visibility="{Binding HasSourceChoice, Converter={StaticResource VisibleWhen}}" />
                        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" Margin="0,0,0,12" HorizontalAlignment="Stretch"
                                  Visibility="{Binding HasSourceChoice, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="Page size" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Margin="0,0,0,12" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Page size" />
                        <TextBlock Text="Quality" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}" Margin="0,0,0,12" HorizontalAlignment="Stretch" />
                        <CheckBox Content="Color" IsChecked="{Binding IsColor}" Margin="0,0,0,4" />
                        <CheckBox IsChecked="{Binding UseOcr}" IsEnabled="{Binding OcrAvailable}">
                            <StackPanel>
                                <TextBlock Text="Searchable text (OCR)" />
                                <TextBlock Text="Find and copy text in saved PDFs" Style="{StaticResource Caption}" FontSize="12" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding OpenInPdfDesk}" Margin="0,4,0,0"
                                  Visibility="{Binding PdfDeskInstalled, Converter={StaticResource VisibleWhen}}">
                            <StackPanel>
                                <TextBlock Text="Open scans in PdfDesk" />
                                <TextBlock Text="Each PDF you save opens there automatically" Style="{StaticResource Caption}" FontSize="12" />
                            </StackPanel>
                        </CheckBox>

                        <Button Command="{Binding ScanCommand}" Style="{DynamicResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch" Padding="0,10" Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8FE;" Margin="0,0,8,0" />
                                <TextBlock Text="Scan" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                Visibility="{Binding IsScanning, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <!-- Toolbar -->
                        <DockPanel DockPanel.Dock="Top" Margin="20,14,14,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding HasPages, Converter={StaticResource VisibleWhen}}" />
                                <Button Content="Save as images" Command="{Binding SaveCommand}" CommandParameter="jpg" Margin="0,0,8,0" />
                                <Button Content="Save as PDF" Command="{Binding SaveCommand}" CommandParameter="pdf" Style="{DynamicResource AccentButtonStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding PageCountText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Status line -->
                        <Border DockPanel.Dock="Bottom" Padding="20,10" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            Visibility="{Binding LastSavedPath, Converter={StaticResource VisibleWhen}}">
                                    <Button Content="Open" Command="{Binding OpenSavedCommand}" Style="{StaticResource LinkButton}" Margin="16,0,16,0" />
                                    <Button Content="Open in PdfDesk" Command="{Binding OpenSavedInPdfDeskCommand}" Style="{StaticResource LinkButton}" Margin="0,0,16,0"
                                            Visibility="{Binding CanOpenSavedInPdfDesk, Converter={StaticResource VisibleWhen}}" />
                                    <Button Content="Show in folder" Command="{Binding ShowSavedInFolderCommand}" Style="{StaticResource LinkButton}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                        <ProgressBar DockPanel.Dock="Bottom" IsIndeterminate="True" Height="3" Margin="20,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />

                        <Grid>
                            <!-- Empty state -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                                        Visibility="{Binding HasPages, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8FE;" FontSize="48" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding EmptyHint}"
                                           Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,12,0,0" />
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,12">
                                <ItemsControl x:Name="PagesList" ItemsSource="{Binding Pages}" AlternationCount="10000">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ScanPageViewModel}">
                                            <StackPanel Margin="8" Width="200">
                                                <Border CornerRadius="4" BorderThickness="1" Background="White"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Height="270" />
                                                </Border>
                                                <DockPanel Margin="2,6,2,0">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" ToolTip="Remove page" AutomationProperties.Name="Remove page"
                                                            Command="{Binding DataContext.RemovePageCommand, ElementName=PagesList}" CommandParameter="{Binding}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                                                    </Button>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" ToolTip="Move earlier" AutomationProperties.Name="Move page earlier" Margin="0,0,14,0"
                                                            Command="{Binding DataContext.MovePageUpCommand, ElementName=PagesList}" CommandParameter="{Binding}">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" />
                                                    </Button>
                                                    <TextBlock Style="{StaticResource Caption}"
                                                               Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource PageNumber}}" />
                                                </DockPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ===================== Print ===================== -->
        <DataTemplate DataType="{x:Type vm:PrintViewModel}">
            <Grid Margin="0,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Options -->
                <Border Style="{StaticResource Card}" Margin="0,0,16,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Document" Style="{StaticResource CardTitle}" />
                        <Button Command="{Binding BrowseCommand}" HorizontalAlignment="Stretch" Padding="0,8"
                                Visibility="{Binding HasDocument, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" Margin="0,0,8,0" />
                                <TextBlock Text="Choose a PDF…" />
                            </StackPanel>
                        </Button>
                        <StackPanel Visibility="{Binding HasDocument, Converter={StaticResource VisibleWhen}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xEA90;" FontSize="22" Margin="0,0,10,0"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="{Binding PageCountText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding PaperText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="32,6,0,0">
                                <Button Content="Choose another" Command="{Binding BrowseCommand}" Style="{StaticResource LinkButton}" Margin="0,0,16,0" />
                                <Button Content="Remove" Command="{Binding ClearCommand}" Style="{StaticResource LinkButton}" />
                            </StackPanel>

                            <TextBlock Text="Pages" Margin="0,20,0,6" FontWeight="SemiBold" />
                            <RadioButton Content="{Binding AllPagesText}" IsChecked="{Binding AllPages}" GroupName="pages" />
                            <DockPanel Margin="0,6,0,0">
                                <RadioButton DockPanel.Dock="Left" Content="Only" IsChecked="{Binding AllPages, Converter={StaticResource Not}}"
                                             GroupName="pages" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding RangeText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Page range"
                                         ToolTip="For example 1-3, 5" />
                            </DockPanel>
                            <TextBlock Text="{Binding RangeError}" FontSize="12" Margin="0,4,0,0"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                       Visibility="{Binding RangeError, Converter={StaticResource VisibleWhen}}" />

                            <TextBlock Text="Copies" Margin="0,20,0,6" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding FewerCopiesCommand}" Width="36" ToolTip="Fewer copies" AutomationProperties.Name="Fewer copies">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE738;" />
                                </Button>
                                <TextBox Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}" Width="56" Margin="6,0"
                                         TextAlignment="Center" AutomationProperties.Name="Copies" />
                                <Button Command="{Binding MoreCopiesCommand}" Width="36" ToolTip="More copies" AutomationProperties.Name="More copies">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" />
                                </Button>
                            </StackPanel>

                            <CheckBox Content="Print on both sides" IsChecked="{Binding TwoSided}" Margin="0,16,0,0"
                                      Visibility="{Binding CanTwoSided, Converter={StaticResource VisibleWhen}}" />

                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,16,0,0" />

                            <Button Command="{Binding PrintCommand}" Style="{DynamicResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" Padding="0,10" Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE749;" Margin="0,0,8,0" />
                                    <TextBlock Text="Print" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                    Visibility="{Binding CanCancel, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>

                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Preview -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340"
                                    Visibility="{Binding HasDocument, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" FontSize="48" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Drop a PDF here" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock Text="or choose one. You'll see every page and how many there are before anything prints."
                                       Style="{StaticResource Caption}" TextAlignment="Center" />
                            <Button Content="Choose a PDF…" Command="{Binding BrowseCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12"
                                      Visibility="{Binding HasDocument, Converter={StaticResource VisibleWhen}}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Thumbnails}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PdfThumbnail}">
                                            <StackPanel Margin="8" Width="150">
                                                <Border BorderThickness="1" CornerRadius="3" Background="White"
                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                    <Image Source="{Binding Image}" Stretch="Uniform" Height="195" />
                                                </Border>
                                                <TextBlock Text="{Binding Number}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding MoreThumbnailsText}" Style="{StaticResource Caption}" Margin="8"
                                           Visibility="{Binding MoreThumbnailsText, Converter={StaticResource VisibleWhen}}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ===================== Settings ===================== -->
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <DockPanel Margin="0,0,16,16">
                <!-- Sticky action bar -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Undo" Command="{Binding RevertCommand}" IsEnabled="{Binding HasChanges}" Margin="0,0,8,0" Padding="16,6" />
                            <Button Content="Save changes" Command="{Binding ApplyCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Reload from printer" Command="{Binding LoadCommand}" Style="{StaticResource LinkButton}" Margin="0,0,20,0" />
                                <Button Content="Trust the new certificate" Command="{Binding TrustNewCertificateCommand}" Style="{StaticResource LinkButton}"
                                        Margin="0,0,20,0" Visibility="{Binding CertificateChanged, Converter={StaticResource VisibleWhen}}" />
                                <Button Content="Forget saved admin password" Command="{Binding ForgetPasswordCommand}" Style="{StaticResource LinkButton}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                                 Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <CollectionViewSource x:Key="Grouped" Source="{Binding Items}">
                                <CollectionViewSource.GroupDescriptions>
                                    <PropertyGroupDescription PropertyName="Group" />
                                </CollectionViewSource.GroupDescriptions>
                            </CollectionViewSource>
                        </ScrollViewer.Resources>
                        <ItemsControl ItemsSource="{Binding Source={StaticResource Grouped}}" MaxWidth="820" HorizontalAlignment="Left">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <StackPanel Margin="0,0,0,16">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" Margin="2,0,0,8" />
                                                            <Border Style="{StaticResource Card}" Padding="16,6">
                                                                <ItemsPresenter />
                                                            </Border>
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SettingItemViewModel}">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="260" />
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                       Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" HorizontalAlignment="Stretch"
                                                  Visibility="{Binding IsChoice, Converter={StaticResource VisibleWhen}}"
                                                  AutomationProperties.Name="{Binding Label}" />
                                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="{Binding MaxLength}"
                                                 Visibility="{Binding IsText, Converter={StaticResource VisibleWhen}}"
                                                 AutomationProperties.Name="{Binding Label}" />
                                        <Ellipse Grid.Column="2" Width="8" Height="8" HorizontalAlignment="Center" ToolTip="Changed, not saved yet"
                                                 Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                 Visibility="{Binding IsDirty, Converter={StaticResource VisibleWhen}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <DockPanel Margin="12,12,12,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,20">
                <Image Source="/PrintDesk.ico" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="PrintDesk" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="Printers" Style="{StaticResource Caption}" Margin="8,0,0,6" />

            <!-- Add a printer that discovery can't see -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button Command="{Binding ToggleAddCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8"
                        Visibility="{Binding IsAddOpen, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,10,0" />
                        <TextBlock Text="Add a printer by address" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource Card}" Padding="12"
                        Visibility="{Binding IsAddOpen, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <TextBlock Text="Printer IP address or name" Margin="0,0,0,6" />
                        <TextBox Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Printer address">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddByAddressCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding ToggleAddCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Print a network report from the printer to find its IP address." Style="{StaticResource Caption}"
                                   FontSize="12" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ManualError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding ManualError, Converter={StaticResource VisibleWhen}}" />
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                                     Visibility="{Binding IsAdding, Converter={StaticResource VisibleWhen}}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Cancel" Command="{Binding ToggleAddCommand}" Margin="0,0,8,0" />
                            <Button Content="Add" Command="{Binding AddByAddressCommand}" Style="{DynamicResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource LinkButton}" Content="About PrintDesk" Click="About_Click" HorizontalAlignment="Left"
                        Margin="10,12,0,0" FontSize="12" />
            </StackPanel>

            <Grid>
                <!-- Empty states: only when the list is empty -->
                <StackPanel Margin="8" Visibility="{Binding ShowSearching, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="Looking for printers on your network…" Style="{StaticResource Caption}" />
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" />
                </StackPanel>
                <StackPanel Margin="8" Visibility="{Binding ShowNoPrinters, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="No printers found" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,10"
                               Text="Make sure the printer is on and connected to the same Wi-Fi or network as this PC." />
                    <Button Content="Search again" Command="{Binding SearchAgainCommand}" HorizontalAlignment="Left" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Printers}" SelectedItem="{Binding Selected}" Style="{StaticResource NavList}"
                         AutomationProperties.Name="Printers" ContextMenuOpening="Printers_ContextMenuOpening">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                            <Setter Property="ContextMenu" Value="{StaticResource PrinterMenu}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PrinterViewModel}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE749;" FontSize="22" HorizontalAlignment="Center"
                                               Visibility="{Binding Image, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                    <Image Source="{Binding Image}" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Ellipse Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{DynamicResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="1.5"
                                             Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>

        <!-- ===================== Main pane ===================== -->
        <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="8,0,0,0"
                BorderThickness="1,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
            <!-- HP software still installed: HP Smart, and HP's print app that handles every print job -->
            <Border DockPanel.Dock="Top" CornerRadius="8" Padding="16,12" Margin="32,20,32,0" BorderThickness="1"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Visibility="{Binding ShowHpBanner, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="18" Margin="0,2,14,0"
                               VerticalAlignment="Top" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Not now" Command="{Binding DismissHpBannerCommand}" Margin="0,0,8,0" />
                        <Button Content="Remove HP software" Command="{Binding RemoveHpSoftwareCommand}" Style="{DynamicResource AccentButtonStyle}"
                                Visibility="{Binding HasHpSoftware, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                                   Visibility="{Binding HasHpSoftware, Converter={StaticResource VisibleWhen}}">
                            <Run Text="{Binding HpAppNames, Mode=OneWay}" /><Run Text=" still installed" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                   Text="{Binding HpMessage, TargetNullValue='HP\'s print app runs on every job you print to this printer. PrintDesk doesn\'t need either one.'}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Selected, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE749;" FontSize="56" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Your printers will show up here" FontSize="16" Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <ContentControl Content="{Binding Selected}" Margin="32,24,16,0" Focusable="False">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:PrinterViewModel}">
                            <DockPanel>
                                <!-- Hero -->
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,16,20">
                                    <Grid DockPanel.Dock="Left" Width="88" Height="88" Margin="0,0,20,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE749;" FontSize="48" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding Image, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                        <Image Source="{Binding Image}" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Command="{Binding GoToPrintCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="16,8" Margin="0,0,8,0"
                                                Visibility="{Binding ShowPrintShortcut, Converter={StaticResource VisibleWhen}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE749;" Margin="0,0,8,0" />
                                                <TextBlock Text="Print a PDF" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding GoToScanCommand}" Padding="16,8"
                                                Visibility="{Binding ShowScanShortcut, Converter={StaticResource VisibleWhen}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8FE;" Margin="0,0,8,0" />
                                                <TextBlock Text="Scan" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Text="{Binding StatusMessage}" />
                                            <TextBlock Text="{Binding Host, StringFormat='   ·   {0}'}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <!-- One-click setup, only when Windows sees the printer but has no queue for it -->
                                <Border DockPanel.Dock="Top" CornerRadius="8" Padding="16,12" Margin="0,0,16,20" BorderThickness="1"
                                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Visibility="{Binding NeedsSetup, Converter={StaticResource VisibleWhen}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE946;" FontSize="18" Margin="0,2,14,0"
                                                   VerticalAlignment="Top" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <Button DockPanel.Dock="Right" Content="Set up" Command="{Binding SetUpCommand}"
                                                Style="{DynamicResource AccentButtonStyle}" Padding="20,6" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Not set up in Windows yet" FontWeight="SemiBold" />
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="{Binding SetupMessage, TargetNullValue='One click lets every app print to it. No driver download or account needed.'}" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0"
                                                       Text="Windows will ask for administrator permission, because this printer was added by address."
                                                       Visibility="{Binding SetupNeedsAdmin, Converter={StaticResource VisibleWhen}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding SetupResult}" Margin="0,0,16,16"
                                           Visibility="{Binding SetupResult, Converter={StaticResource VisibleWhen}}" />

                                <TabControl Style="{StaticResource SectionTabs}" SelectedIndex="{Binding SelectedSection}">
                                    <TabItem Header="Overview" Content="{Binding}" ContentTemplate="{StaticResource OverviewSection}" />
                                    <TabItem Header="Print" Content="{Binding Print}" />
                                    <TabItem Header="Scan" Content="{Binding Scan}"
                                             Visibility="{Binding Scan, Converter={StaticResource VisibleWhen}}" />
                                    <TabItem Header="Printer settings" Content="{Binding Settings}" Tag="settings"
                                             Visibility="{Binding Settings, Converter={StaticResource VisibleWhen}}" />
                                </TabControl>
                            </DockPanel>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
