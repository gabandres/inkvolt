<Window x:Class="PrintDesk.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PrintDesk.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="PrintDesk" Width="1120" Height="760" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- ===================== Status tab ===================== -->
        <DataTemplate x:Key="StatusTab" DataType="{x:Type vm:PrinterViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,12,8,12" MaxWidth="760" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,12,0" VerticalAlignment="Center"
                                     Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                            <StackPanel>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="20" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Alerts}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2">
                                                <Run Text="•" /> <Run Text="{Binding Message, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding Supplies.Count, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Text="Supplies" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Supplies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SupplyViewModel}">
                                        <Grid Margin="0,4,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="1" Height="10" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                                         Foreground="{Binding ColorCode, Converter={StaticResource SupplyBrush}}"
                                                         AutomationProperties.Name="{Binding Name}" />
                                            <TextBlock Grid.Column="2" Text="{Binding PercentText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}"
                                                       Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Visibility="{Binding UsageText, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Text="Usage" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding UsageText}" />
                        </StackPanel>
                    </Border>

                    <WrapPanel>
                        <Button Content="Open printer web page" Command="{Binding OpenWebPageCommand}" Margin="0,0,8,8" />
                        <Button Content="Windows printer settings" Command="{Binding OpenPrintQueueCommand}" Margin="0,0,8,8" />
                        <Button Content="Reconnect" Command="{Binding ReconnectCommand}" Margin="0,0,8,8" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <!-- ===================== Scan tab ===================== -->
        <DataTemplate DataType="{x:Type vm:ScanViewModel}">
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Source" Margin="0,0,0,4" Visibility="{Binding HasSourceChoice, Converter={StaticResource VisibleWhen}}" />
                    <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" Margin="0,0,0,12"
                              Visibility="{Binding HasSourceChoice, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="Resolution" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}" Margin="0,0,0,12" />
                    <CheckBox Content="Color" IsChecked="{Binding IsColor}" Margin="0,0,0,8" />
                    <CheckBox Content="Make text searchable (OCR)" IsChecked="{Binding UseOcr}" IsEnabled="{Binding OcrAvailable}" Margin="0,0,0,16" />

                    <Button Content="Scan" Command="{Binding ScanCommand}" Style="{DynamicResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" Padding="0,8" IsDefault="True" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />

                    <UniformGrid Columns="2" Margin="0,16,0,0">
                        <Button Content="Save…" Command="{Binding SaveCommand}" Margin="0,0,4,0" />
                        <Button Content="Clear" Command="{Binding ClearCommand}" Margin="4,0,0,0" />
                    </UniformGrid>

                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,16,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding LastSavedPath, Converter={StaticResource VisibleWhen}}">
                        <Button Content="Open" Command="{Binding OpenSavedCommand}" Style="{StaticResource LinkButton}" Margin="0,0,16,0" />
                        <Button Content="Show in folder" Command="{Binding ShowSavedInFolderCommand}" Style="{StaticResource LinkButton}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0" Padding="8">
                    <Grid>
                        <TextBlock Text="Place a page on the scanner glass and press Scan."
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Caption}"
                                   Visibility="{Binding HasPages, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PagesList" ItemsSource="{Binding Pages}" AlternationCount="10000">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ScanPageViewModel}">
                                        <StackPanel Margin="8" Width="190">
                                            <Border BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxHeight="260" />
                                            </Border>
                                            <DockPanel Margin="0,4,0,0">
                                                <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource LinkButton}"
                                                        Command="{Binding DataContext.RemovePageCommand, ElementName=PagesList}" CommandParameter="{Binding}" />
                                                <Button DockPanel.Dock="Right" Content="Move up" Style="{StaticResource LinkButton}" Margin="0,0,10,0"
                                                        Command="{Binding DataContext.MovePageUpCommand, ElementName=PagesList}" CommandParameter="{Binding}" />
                                                <TextBlock>
                                                    <Run Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource PageNumber}, Mode=OneWay}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ===================== Settings tab ===================== -->
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <DockPanel Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save changes" Command="{Binding ApplyCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" Margin="0,0,8,0" />
                        <Button Content="Undo changes" Command="{Binding RevertCommand}" Padding="16,6" Margin="0,0,8,0"
                                IsEnabled="{Binding HasChanges}" />
                        <Button Content="Reload" Command="{Binding LoadCommand}" Padding="16,6" Margin="0,0,24,0" />
                        <Button Content="Forget saved admin password" Command="{Binding ForgetPasswordCommand}"
                                Style="{StaticResource LinkButton}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" Margin="0,8,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="#D13438" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Grid>
                    <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top"
                                 Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <CollectionViewSource x:Key="Grouped" Source="{Binding Items}">
                                <CollectionViewSource.GroupDescriptions>
                                    <PropertyGroupDescription PropertyName="Group" />
                                </CollectionViewSource.GroupDescriptions>
                            </CollectionViewSource>
                        </ScrollViewer.Resources>
                        <ItemsControl ItemsSource="{Binding Source={StaticResource Grouped}}" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,8,0">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SettingItemViewModel}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300" />
                                            <ColumnDefinition Width="320" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}"
                                                  Visibility="{Binding IsChoice, Converter={StaticResource VisibleWhen}}"
                                                  AutomationProperties.Name="{Binding Label}" />
                                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="{Binding MaxLength}"
                                                 Visibility="{Binding IsText, Converter={StaticResource VisibleWhen}}"
                                                 AutomationProperties.Name="{Binding Label}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Error}" Foreground="#D13438" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="●" ToolTip="Changed" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Visibility="{Binding IsDirty, Converter={StaticResource VisibleWhen}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Printer list ===================== -->
        <DockPanel Margin="12">
            <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8">
                <TextBlock Text="Printers" FontSize="20" FontWeight="SemiBold" />
            </DockPanel>
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="3" Margin="4,0,4,8"
                         Visibility="{Binding IsSearching, Converter={StaticResource VisibleWhen}}" ToolTip="Searching the network" />

            <StackPanel DockPanel.Dock="Bottom" Margin="4,12,4,0">
                <TextBlock Text="Not listed? Add by IP address or name:" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddByAddressCommand}" Margin="6,0,0,0" />
                    <TextBox Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Printer address">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddByAddressCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>
                <TextBlock Text="{Binding ManualError}" Foreground="#D13438" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding ManualError, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>

            <Grid>
                <TextBlock Text="Looking for printers on your network…" Style="{StaticResource Caption}" Margin="4"
                           Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" />
                <ListBox ItemsSource="{Binding Printers}" SelectedItem="{Binding Selected}" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Printers">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PrinterViewModel}">
                            <DockPanel Margin="2,6">
                                <DockPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Reconnect" Command="{Binding ReconnectCommand}" />
                                        <MenuItem Header="Forget this printer"
                                                  Command="{Binding PlacementTarget.Tag.ForgetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                                <DockPanel.Tag>
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                </DockPanel.Tag>
                                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center"
                                         Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>

        <!-- ===================== Selected printer ===================== -->
        <ContentControl Grid.Column="1" Content="{Binding Selected}" Margin="8,12,16,12">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:PrinterViewModel}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" Margin="0,2,0,8" />
                        </StackPanel>

                        <!-- One-click setup: shown only when Windows sees the printer but has no queue for it -->
                        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10"
                                Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                                Visibility="{Binding NeedsSetup, Converter={StaticResource VisibleWhen}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Set up" Command="{Binding SetUpCommand}"
                                        Style="{DynamicResource AccentButtonStyle}" Padding="20,6" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="This printer isn't set up in Windows yet." FontWeight="SemiBold"
                                               Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" />
                                    <TextBlock Text="{Binding SetupMessage, TargetNullValue='Set it up to print from any app. No driver download or account needed.'}"
                                               Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SetupResult}" Margin="0,0,0,8"
                                   Visibility="{Binding SetupResult, Converter={StaticResource VisibleWhen}}" />

                        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
                            <TabItem Header="Status" Content="{Binding}" ContentTemplate="{StaticResource StatusTab}" />
                            <TabItem Header="Scan" Content="{Binding Scan}"
                                     Visibility="{Binding Scan, Converter={StaticResource VisibleWhen}}" />
                            <TabItem Header="Settings" Content="{Binding Settings}" Tag="settings"
                                     Visibility="{Binding Settings, Converter={StaticResource VisibleWhen}}" />
                        </TabControl>
                    </DockPanel>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</Window>
