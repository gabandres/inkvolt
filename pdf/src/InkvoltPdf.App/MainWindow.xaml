<Window x:Class="InkvoltPdf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:InkvoltPdf.App"
        xmlns:loc="clr-namespace:InkvoltPdf.App"
        Title="{x:Static loc:Strings.Main_ProductName}" Icon="InkvoltPdf.ico" AllowDrop="True" Background="Transparent"
        Width="1280" Height="860" MinWidth="720" MinHeight="460"
        app:TextScale.WholeWindow="False">
    <!-- Content extends into the title bar; DWM still draws (and hit-tests) the real caption buttons, so Snap Layouts work. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" GlassFrameThickness="-1" UseAeroCaptionButtons="True"
                      ResizeBorderThickness="6" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: app icon, document tabs, new-tab button; empty space drags the window -->
        <Grid x:Name="TitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionColumn" Width="140" />
            </Grid.ColumnDefinitions>
            <Image app:IconImage.Source="InkvoltPdf.ico" Width="16" Height="16" Margin="14,0,10,0" VerticalAlignment="Center" app:TextScale.Scales="True" />
            <!-- Tabs get at most the width left after the + button and a drag strip (set in code); they shrink, then scroll.
                 Scaled with Windows' Text size, and the title bar grows to fit (ScaleTitleBar); the caption buttons are Windows'. -->
            <DockPanel x:Name="TabArea" Grid.Column="1" LastChildFill="False" app:TextScale.Scales="True">
                <ListBox x:Name="TabStrip" DockPanel.Dock="Left" Background="Transparent" BorderThickness="0" Padding="0"
                         WindowChrome.IsHitTestVisibleInChrome="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False" AutomationProperties.Name="{x:Static loc:Strings.Main_OpenDocuments}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource TitleTab}">
                            <Setter Property="MinWidth" Value="110" />
                            <Setter Property="MaxWidth" Value="{Binding TabMaxWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type app:TabModel}">
                            <DockPanel ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Label}" Background="Transparent">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" FontSize="10" Height="24" MinWidth="24" Padding="4"
                                        Content="&#xE711;" ToolTip="{x:Static app:Cmd.CloseTabTip}" Click="OnTabCloseClick" Margin="6,0,0,0" />
                                <TextBlock DockPanel.Dock="Left" Text="&#xE915;" FontFamily="{StaticResource Icons}" FontSize="9" Margin="0,0,6,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="{Binding DirtyVisibility}" ToolTip="{x:Static loc:Strings.Main_UnsavedChanges}" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="NewTabButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" FontSize="12" Height="30" MinWidth="30"
                        Margin="4,6,0,0" Content="&#xE710;" ToolTip="{x:Static loc:Strings.Main_OpenAFile}" Command="app:Cmd.Open"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                <ProgressBar x:Name="OpenProgress" DockPanel.Dock="Left" IsIndeterminate="True" Width="48" Height="4" Margin="10,4,0,0"
                             VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="{x:Static loc:Strings.Main_OpeningFiles}" />
                <!-- Watched folders' status (FolderWatches); opens Batch > Watched Folders -->
                <Button x:Name="WatchButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Height="30" Margin="6,6,0,0" Padding="8,0"
                        Visibility="Collapsed" Click="OnWatchButton" WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="WatchText" FontSize="12" VerticalAlignment="Center" FontFamily="{DynamicResource ContentControlThemeFontFamily}" />
                    </StackPanel>
                </Button>
                <!-- A Microsoft Store update is ready (packaged installs; MainWindow.Updates.cs) -->
                <Button x:Name="UpdateButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Height="30" Margin="6,6,0,0" Padding="8,0"
                        Visibility="Collapsed" Click="OnUpdateButton" WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.LiveSetting="Polite">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UpdateIcon" Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="UpdateText" Text="{x:Static loc:Strings.Main_Update}" FontSize="12" VerticalAlignment="Center" FontFamily="{DynamicResource ContentControlThemeFontFamily}" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="AppTitle" DockPanel.Dock="Left" Text="{x:Static loc:Strings.Main_ProductName}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" />
            </DockPanel>
        </Grid>

        <!-- Surface below the title bar -->
        <Border x:Name="Surface" Grid.Row="1" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
            <DockPanel>
                <!-- Menu + command bar -->
                <Border x:Name="CommandBar" DockPanel.Dock="Top" app:TextScale.Scales="True" Padding="4,4,8,4"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <!-- One row at every width: commands that don't fit go into the "More" (…) menu at the end of the bar. -->
                    <DockPanel MinHeight="34" SizeChanged="OnBarRowSizeChanged">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource CommandButton}" Command="app:Cmd.CommandPalette" ToolTip="{x:Static loc:Strings.Main_SearchAllCommands}"
                                    AutomationProperties.Name="{x:Static loc:Strings.Main_Commands}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" FontSize="14" />
                                    <TextBlock x:Name="PaletteLabel" Text="{x:Static loc:Strings.Main_Commands}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <Border x:Name="PaletteKey" CornerRadius="3" Padding="5,0,5,1" Margin="8,0,0,0" BorderThickness="1" VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                        <TextBlock x:Name="PaletteKeyText" FontSize="11" Style="{StaticResource Caption}" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="AppearanceButton" Style="{StaticResource IconButton}" Content="&#xE708;" Click="OnAppearanceClick"
                                    ToolTip="{x:Static loc:Strings.Main_AppearanceButtonTip}" />
                            <Button Style="{StaticResource IconButton}" Command="app:Cmd.Settings" Content="&#xE713;" ToolTip="{x:Static loc:Strings.Common_Settings}" />
                        </StackPanel>
                        <DockPanel VerticalAlignment="Stretch">
                            <Menu x:Name="MainMenu" DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Center" Margin="0,0,4,0">
                                <MenuItem Header="{x:Static loc:Strings.Main_MenuFile}">
                                    <MenuItem Command="app:Cmd.Open" />
                                    <MenuItem x:Name="RecentMenu" Header="{x:Static loc:Strings.Main_MenuOpenRecent}" />
                                    <MenuItem Command="app:Cmd.Combine" />
                                    <MenuItem Command="app:Cmd.Compare" />
                                    <MenuItem Command="app:Cmd.Batch" />
                                    <MenuItem Command="app:Cmd.NewFromImages" />
                                    <MenuItem Command="app:Cmd.NewFromClipboard" />
                                    <MenuItem x:Name="OfficeMenu" Command="app:Cmd.CreateFromOffice" Visibility="Collapsed" />
                                    <MenuItem Command="app:Cmd.CreateFromWeb" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.Save" />
                                    <MenuItem Command="app:Cmd.SaveAs" />
                                    <MenuItem Command="app:Cmd.SaveAsPdfA" />
                                    <MenuItem Command="app:Cmd.SaveAsPdfA2a" />
                                    <MenuItem Command="app:Cmd.ShowInFolder" />
                                    <MenuItem Command="app:Cmd.ReloadFromDisk" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.Print" />
                                    <MenuItem Command="app:Cmd.PrintWithOptions" Header="{x:Static loc:Strings.Main_MenuPrintWithOptions}" />
                                    <MenuItem Command="app:Cmd.Scan" />
                                    <MenuItem x:Name="InkvoltPrintMenu" Header="{x:Static loc:Strings.Main_MenuPrinterSettings}" Click="OnOpenInkvoltPrint" Visibility="Collapsed" />
                                    <MenuItem Header="{x:Static loc:Strings.Main_MenuExport}">
                                        <MenuItem Command="app:Cmd.ExportWord" Header="{x:Static loc:Strings.Main_MenuExportWord}" />
                                        <MenuItem Command="app:Cmd.ExportExcel" Header="{x:Static loc:Strings.Main_MenuExportExcel}" />
                                        <MenuItem Command="app:Cmd.ExportPowerPoint" Header="{x:Static loc:Strings.Main_MenuExportPowerPoint}" />
                                        <MenuItem Command="app:Cmd.ExportHtml" Header="{x:Static loc:Strings.Main_MenuExportHtml}" />
                                        <MenuItem Command="app:Cmd.ExportText" Header="{x:Static loc:Strings.Main_MenuExportText}" />
                                        <Separator />
                                        <MenuItem Command="app:Cmd.ExportImages" Header="{x:Static loc:Strings.Main_MenuExportImages}" />
                                    </MenuItem>
                                    <MenuItem Command="app:Cmd.Properties" />
                                    <MenuItem Command="app:Cmd.ProtectPassword" />
                                    <MenuItem Command="app:Cmd.RemoveProtection" />
                                    <MenuItem Command="app:Cmd.ReduceSize" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.CloseDoc" />
                                    <MenuItem Command="app:Cmd.CloseAll" />
                                    <MenuItem Command="app:Cmd.ReopenClosed" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.Settings" />
                                    <MenuItem Command="app:Cmd.Exit" InputGestureText="Alt+F4" />
                                </MenuItem>
                                <MenuItem Header="{x:Static loc:Strings.Main_MenuEdit}">
                                    <MenuItem x:Name="UndoMenu" Command="app:Cmd.Undo" />
                                    <MenuItem x:Name="RedoMenu" Command="app:Cmd.Redo" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.Copy" />
                                    <MenuItem Command="app:Cmd.SelectAll" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.Find" />
                                    <MenuItem Command="app:Cmd.FindNext" />
                                    <MenuItem Command="app:Cmd.FindPrevious" />
                                    <MenuItem Command="app:Cmd.SearchPane" />
                                    <MenuItem Command="app:Cmd.SearchFolders" />
                                    <Separator />
                                    <MenuItem x:Name="HandMenu" Command="app:Cmd.ToolHand" InputGestureText="{x:Static loc:Strings.Main_KeyH}" />
                                    <MenuItem x:Name="SelectMenu" Command="app:Cmd.ToolSelect" InputGestureText="{x:Static loc:Strings.Main_KeyT}" />
                                    <MenuItem x:Name="SnapshotMenu" Command="app:Cmd.ToolSnapshot" InputGestureText="{x:Static loc:Strings.Main_KeyG}" />
                                    <Separator />
                                    <!-- Fill & Sign: type or mark on any page, handwritten signature (digital signing is under Review) -->
                                    <MenuItem Header="{x:Static loc:Strings.Main_MenuFillSign}">
                                        <MenuItem x:Name="AddTextMenu" Command="app:Cmd.ToolAddText" InputGestureText="{x:Static loc:Strings.Main_KeyA}" />
                                        <MenuItem x:Name="CheckMenu" Command="app:Cmd.ToolCheck" InputGestureText="{x:Static loc:Strings.Main_KeyK}" />
                                        <MenuItem x:Name="CrossMenu" Command="app:Cmd.ToolCross" InputGestureText="{x:Static loc:Strings.Main_KeyX}" />
                                        <MenuItem Command="app:Cmd.AddSignature" />
                                    </MenuItem>
                                    <MenuItem x:Name="EditContentMenu" Command="app:Cmd.EditContent" />
                                    <MenuItem Header="{x:Static loc:Strings.Main_MenuForms}">
                                        <MenuItem x:Name="PrepareFormMenu" Command="app:Cmd.PrepareForm" />
                                        <MenuItem Command="app:Cmd.DetectFields" />
                                        <Separator />
                                        <MenuItem Command="app:Cmd.ExportFormData" />
                                        <MenuItem Command="app:Cmd.ImportFormData" />
                                        <MenuItem Command="app:Cmd.FillFormsFromCsv" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Command="app:Cmd.CommandPalette" />
                                </MenuItem>
                                <MenuItem Header="{x:Static loc:Strings.Main_MenuView}">
                                    <MenuItem Command="app:Cmd.ZoomIn" />
                                    <MenuItem Command="app:Cmd.ZoomOut" />
                                    <MenuItem Command="app:Cmd.ActualSize" />
                                    <MenuItem x:Name="FitWidthMenu" Command="app:Cmd.FitWidth" />
                                    <MenuItem x:Name="FitPageMenu" Command="app:Cmd.FitPage" />
                                    <Separator />
                                    <MenuItem x:Name="SingleMenu" Command="app:Cmd.LayoutSingle" />
                                    <MenuItem x:Name="ContinuousMenu" Command="app:Cmd.LayoutContinuous" />
                                    <MenuItem x:Name="FacingMenu" Command="app:Cmd.LayoutFacing" />
                                    <MenuItem x:Name="CoverMenu" Command="app:Cmd.LayoutCover" />
                                    <MenuItem Command="app:Cmd.RotateViewRight" />
                                    <MenuItem Command="app:Cmd.RotateViewLeft" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.FirstPage" />
                                    <MenuItem Command="app:Cmd.PrevPage" />
                                    <MenuItem Command="app:Cmd.NextPage" />
                                    <MenuItem Command="app:Cmd.LastPage" />
                                    <MenuItem Command="app:Cmd.GoToPage" />
                                    <MenuItem Command="app:Cmd.Back" />
                                    <MenuItem Command="app:Cmd.Forward" />
                                    <Separator />
                                    <MenuItem Header="{x:Static loc:Strings.Main_MenuSplitView}">
                                        <MenuItem x:Name="SplitHorizontalMenu" Command="app:Cmd.SplitHorizontal" />
                                        <MenuItem x:Name="SplitVerticalMenu" Command="app:Cmd.SplitVertical" />
                                        <MenuItem Command="app:Cmd.RemoveSplit" />
                                        <Separator />
                                        <MenuItem Command="app:Cmd.SwitchPane" />
                                    </MenuItem>
                                    <MenuItem x:Name="NavPaneMenu" Command="app:Cmd.NavPane" />
                                    <MenuItem Header="{x:Static loc:Strings.Main_MenuBookmarks}" Click="OnShowBookmarks" />
                                    <MenuItem Command="app:Cmd.AddBookmark" />
                                    <MenuItem x:Name="ReadAloudMenu" Command="app:Cmd.ReadAloud" />
                                    <MenuItem Header="{x:Static loc:Strings.Main_MenuTheme}">
                                        <MenuItem x:Name="ThemeSystemMenu" Header="{x:Static loc:Strings.Main_MenuThemeWindows}" Click="OnThemeMenu" Tag="System" />
                                        <MenuItem x:Name="ThemeLightMenu" Header="{x:Static loc:Strings.Main_MenuThemeLight}" Click="OnThemeMenu" Tag="Light" />
                                        <MenuItem x:Name="ThemeDarkMenu" Header="{x:Static loc:Strings.Main_MenuThemeDark}" Click="OnThemeMenu" Tag="Dark" />
                                    </MenuItem>
                                    <MenuItem Command="app:Cmd.ToggleDarkMode" />
                                    <MenuItem x:Name="DarkPagesMenu" Command="app:Cmd.DarkPages" />
                                    <MenuItem x:Name="HighlightFieldsMenu" Command="app:Cmd.HighlightFields" />
                                    <MenuItem Command="app:Cmd.FullScreen" />
                                </MenuItem>
                                <MenuItem Header="{x:Static loc:Strings.Main_MenuOrganize}">
                                    <MenuItem x:Name="OrganizeMenu" Command="app:Cmd.Organize" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.RotateRight" />
                                    <MenuItem Command="app:Cmd.RotateLeft" />
                                    <MenuItem Command="app:Cmd.RotatePages" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.InsertPages" />
                                    <MenuItem Command="app:Cmd.InsertBlank" />
                                    <MenuItem Command="app:Cmd.InsertFromScanner" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.DeletePages" />
                                    <MenuItem Command="app:Cmd.DeleteSelected" />
                                    <MenuItem Command="app:Cmd.ExtractPages" />
                                    <MenuItem Command="app:Cmd.SplitDocument" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.MovePages" />
                                    <MenuItem Command="app:Cmd.DuplicatePages" />
                                    <MenuItem Command="app:Cmd.ReversePages" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.CropPages" />
                                    <MenuItem Command="app:Cmd.Flatten" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.AddHeaderFooter" />
                                    <MenuItem Command="app:Cmd.RemoveHeaderFooter" />
                                    <MenuItem Command="app:Cmd.AddWatermark" />
                                    <MenuItem Command="app:Cmd.RemoveWatermark" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.Combine" />
                                </MenuItem>
                                <MenuItem Header="{x:Static loc:Strings.Main_MenuReview}">
                                    <MenuItem Command="app:Cmd.ShowComments" />
                                    <MenuItem Command="app:Cmd.ShowAttachments" />
                                    <MenuItem Command="app:Cmd.ShowLayers" />
                                    <MenuItem Command="app:Cmd.ShowSignatures" />
                                    <MenuItem x:Name="SignMenu" Command="app:Cmd.Sign" />
                                    <MenuItem Command="app:Cmd.AddVerification" />
                                    <MenuItem Command="app:Cmd.CheckSignaturesOnline" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.Highlight" />
                                    <MenuItem Command="app:Cmd.Underline" />
                                    <MenuItem Command="app:Cmd.StrikeOut" />
                                    <MenuItem x:Name="NoteMenu" Command="app:Cmd.AddNote" />
                                    <!-- Pen, highlighter, shapes, lines, text boxes: filled in code (MainWindow.BuildDrawMenu) -->
                                    <MenuItem x:Name="DrawMenu" Header="{x:Static loc:Strings.Main_MenuDraw}" />
                                    <MenuItem Command="app:Cmd.AddImage" InputGestureText="{x:Static loc:Strings.Main_KeyI}" />
                                    <MenuItem Command="app:Cmd.AddImageFromClipboard" />
                                    <MenuItem x:Name="LinkMenu" Command="app:Cmd.ToolLink" InputGestureText="{x:Static loc:Strings.Main_KeyN}" />
                                    <MenuItem Command="app:Cmd.LinkSelection" />
                                    <MenuItem Command="app:Cmd.AddStamp" InputGestureText="{x:Static loc:Strings.Main_KeyS}" />
                                    <MenuItem Header="{x:Static loc:Strings.Main_MenuMeasure}">
                                        <MenuItem Command="app:Cmd.MeasureDistance" />
                                        <MenuItem Command="app:Cmd.MeasurePerimeter" />
                                        <MenuItem Command="app:Cmd.MeasureArea" />
                                        <Separator />
                                        <MenuItem Command="app:Cmd.MeasureScale" />
                                        <MenuItem Command="app:Cmd.MeasureCalibrate" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Command="app:Cmd.ExportComments" />
                                    <MenuItem Command="app:Cmd.ImportComments" />
                                    <MenuItem Command="app:Cmd.SummarizeComments" />
                                    <Separator />
                                    <MenuItem x:Name="AttachMenu" Header="{x:Static loc:Strings.Main_MenuAttachFile}" Click="OnAttachFile" />
                                    <MenuItem Command="app:Cmd.RecognizeText" />
                                    <MenuItem Command="app:Cmd.ReviewSuspectWords" />
                                    <Separator />
                                    <MenuItem x:Name="RedactMenu" Command="app:Cmd.Redact" />
                                    <MenuItem x:Name="RedactTextMenu" Header="{x:Static loc:Strings.Main_MenuMarkSelectedText}" Click="OnRedactText" />
                                    <MenuItem x:Name="RedactHitsMenu" Header="{x:Static loc:Strings.Main_MenuMarkSearchMatches}" Click="OnRedactHits" />
                                    <MenuItem Command="app:Cmd.RedactPatterns" />
                                    <MenuItem x:Name="ApplyRedactMenu" Header="{x:Static loc:Strings.Main_MenuApplyRedactions}" Click="OnApplyRedactions" />
                                    <MenuItem Command="app:Cmd.CheckRedaction" />
                                    <MenuItem Command="app:Cmd.Sanitize" />
                                    <MenuItem Command="app:Cmd.WhatsInThisPdf" />
                                    <Separator />
                                    <MenuItem Command="app:Cmd.CheckAccessibility" />
                                    <MenuItem Command="app:Cmd.MakeAccessible" />
                                    <MenuItem Command="app:Cmd.ReadingOrder" />
                                    <Separator />
                                    <!-- Bring your own AI: off by default (AiActions, DocumentTab.Ai) -->
                                    <MenuItem Header="{x:Static loc:Strings.Main_MenuAiAssistant}">
                                        <MenuItem Command="app:Cmd.AiSummarize" />
                                        <MenuItem Command="app:Cmd.AiAsk" />
                                        <MenuItem Command="app:Cmd.AiExplain" />
                                        <MenuItem Command="app:Cmd.AiTranslate" />
                                        <Separator />
                                        <MenuItem Command="app:Cmd.AiSettings" />
                                    </MenuItem>
                                </MenuItem>
                                <MenuItem Header="{x:Static loc:Strings.Main_MenuHelp}">
                                    <MenuItem Command="app:Cmd.Shortcuts" />
                                    <MenuItem Command="app:Cmd.CommandPalette" />
                                    <MenuItem Command="app:Cmd.WhatsNew" />
                                    <MenuItem Command="app:Cmd.ReportProblem" />
                                    <MenuItem Command="app:Cmd.CheckForUpdates" />
                                    <MenuItem Command="app:Cmd.InkvoltPro" />
                                    <MenuItem Header="{x:Static loc:Strings.Main_MenuOpenLogFolder}" Click="OnOpenLog" />
                                    <Separator />
                                    <MenuItem Header="{x:Static loc:Strings.Main_MenuAbout}" Click="OnAbout" />
                                </MenuItem>
                            </Menu>
                            <!-- Tooltips name the action; the shortcut is added from the command's own gestures (Cmd.AddShortcutsToTips).
                                 Letter keys (H, T, G, A, K, X and the drawing tools') are page-view keys, not commands, so they are written here. -->
                            <!-- Without a document only Combine applies; with one it moves into the document commands -->
                            <Button x:Name="NoDocCombineButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Command="app:Cmd.Combine"
                                    ToolTip="{x:Static loc:Strings.Main_CombineTip}" Content="&#xE8F1;" />
                            <Border x:Name="DocCommandsSeparator" DockPanel.Dock="Left" Style="{StaticResource BarSeparator}" />
                            <!-- The command bar (CommandBarLayout in Core: groups, order, priorities): save and undo as icons, then labeled
                                 groups that drop a menu of their tools; what doesn't fit, and the page commands, are in "…" with
                                 their labels. Each button's Tag is its CommandBar entry. -->
                            <app:ToolbarPanel x:Name="DocCommands" VerticalAlignment="Center" MoreAlways="True">
                                <Button Tag="Save" Style="{StaticResource IconButton}" Command="app:Cmd.Save" ToolTip="{x:Static loc:Strings.Common_Save}" Content="&#xE74E;" />
                                <Button Tag="Print" Style="{StaticResource IconButton}" Command="app:Cmd.Print" ToolTip="{x:Static loc:Strings.Common_Print}" Content="&#xE749;" />
                                <Button x:Name="UndoButton" Tag="Undo" Style="{StaticResource IconButton}" Command="app:Cmd.Undo" ToolTip="{x:Static loc:Strings.Common_Undo}" Content="&#xE7A7;" />
                                <Button x:Name="RedoButton" Tag="Redo" Style="{StaticResource IconButton}" Command="app:Cmd.Redo" ToolTip="{x:Static loc:Strings.Common_Redo}" Content="&#xE7A6;" />
                                <Border Style="{StaticResource BarSeparator}" />
                                <!-- Hand, Select text, Snapshot: named after the one in use -->
                                <ToggleButton x:Name="PointerButton" Tag="Pointer" Style="{StaticResource CommandButton}" Click="OnBarGroupClick"
                                              ToolTip="{x:Static loc:Strings.Main_PointerTip}" AutomationProperties.Name="{x:Static loc:Strings.Main_PointerTools}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="PointerIcon" Style="{StaticResource Icon}" Text="&#xE7C9;" FontSize="15" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" Margin="6,2,0,0" />
                                    </StackPanel>
                                </ToggleButton>
                                <Border Style="{StaticResource BarSeparator}" />
                                <!-- The groups, Edit to Scan & OCR, are split buttons built from CommandBarLayout's table (BuildBarGroups) -->
                                <Button x:Name="MoreButton" app:ToolbarPanel.IsOverflowButton="True" Style="{StaticResource IconButton}" Content="&#xE712;"
                                        ToolTip="{x:Static loc:Strings.Main_MoreCommandsTip}" AutomationProperties.Name="{x:Static loc:Strings.Main_MoreCommands}" Click="OnMoreClick" />
                            </app:ToolbarPanel>
                        </DockPanel>
                    </DockPanel>
                </Border>

                <Grid x:Name="ContentArea">
                    <!-- Open documents (one visible at a time; hidden ones keep their state) -->
                    <Grid x:Name="DocsHost" />

                    <!-- Start page -->
                    <ScrollViewer x:Name="StartPage" VerticalScrollBarVisibility="Auto" app:TextScale.Scales="True">
                        <StackPanel MaxWidth="920" Margin="40,40,40,32">
                            <StackPanel.Resources>
                                <!-- A Tools card: runs its command (Tag); one that needs a document asks for a PDF first (OnToolCard) -->
                                <Style x:Key="ToolCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Margin" Value="4" />
                                    <Setter Property="Padding" Value="14,12" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Top" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Content.Title, RelativeSource={RelativeSource Self}}" />
                                    <Setter Property="AutomationProperties.HelpText" Value="{Binding Content.Detail, RelativeSource={RelativeSource Self}}" />
                                </Style>
                                <DataTemplate DataType="{x:Type app:StartTool}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="20" Margin="0,1,12,0"
                                                   VerticalAlignment="Top" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </StackPanel.Resources>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="InkvoltPdfLogo.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static loc:Strings.Main_ProductName}" Style="{DynamicResource TitleTextBlockStyle}" />
                                    <TextBlock Text="{x:Static loc:Strings.Start_Tagline}" Style="{StaticResource Caption}" FontSize="14" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <Button x:Name="OpenCard" Command="app:Cmd.Open" Margin="0,28,0,0" Padding="20" HorizontalContentAlignment="Stretch">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="28" Margin="0,0,16,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="{x:Static loc:Strings.Main_OpenAFile}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Static loc:Strings.Start_OpenDetail}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>

                            <TextBlock Text="{x:Static loc:Strings.Start_Tools}" Style="{DynamicResource SubtitleTextBlockStyle}" Margin="0,32,0,6" />
                            <!-- The tools people look for first; the rest are in the menus and Ctrl+K -->
                            <UniformGrid x:Name="ToolGrid" Columns="4" Margin="-4,0,-4,0">
                                <Button Style="{StaticResource ToolCard}" Click="OnToolCard" Tag="{x:Static app:Cmd.ToolAddText}">
                                    <app:StartTool Title="{x:Static loc:Strings.Start_ToolFillSign}" Detail="{x:Static loc:Strings.Start_ToolFillSignDetail}" Glyph="&#xE76D;" />
                                </Button>
                                <Button Style="{StaticResource ToolCard}" Click="OnToolCard" Tag="{x:Static app:Cmd.EditContent}">
                                    <app:StartTool Title="{x:Static loc:Strings.Start_ToolEditText}" Detail="{x:Static loc:Strings.Start_ToolEditTextDetail}" Glyph="&#xE70F;" />
                                </Button>
                                <Button Style="{StaticResource ToolCard}" Click="OnToolCard" Tag="{x:Static app:Cmd.ExportWord}">
                                    <app:StartTool Title="{x:Static loc:Strings.Start_ToolExportWord}" Detail="{x:Static loc:Strings.Start_ToolExportWordDetail}" Glyph="&#xEDE1;" />
                                </Button>
                                <Button Style="{StaticResource ToolCard}" Click="OnToolCard" Tag="{x:Static app:Cmd.Combine}">
                                    <app:StartTool Title="{x:Static loc:Strings.Start_ToolCombine}" Detail="{x:Static loc:Strings.Start_ToolCombineDetail}" Glyph="&#xE8F1;" />
                                </Button>
                                <Button Style="{StaticResource ToolCard}" Click="OnToolCard" Tag="{x:Static app:Cmd.Compare}">
                                    <app:StartTool Title="{x:Static loc:Strings.Start_ToolCompare}" Detail="{x:Static loc:Strings.Start_ToolCompareDetail}" Glyph="&#xE7C4;" />
                                </Button>
                                <Button Style="{StaticResource ToolCard}" Click="OnToolCard" Tag="{x:Static app:Cmd.ReduceSize}">
                                    <app:StartTool Title="{x:Static loc:Strings.Start_ToolReduceSize}" Detail="{x:Static loc:Strings.Start_ToolReduceSizeDetail}" Glyph="&#xE73F;" />
                                </Button>
                                <Button Style="{StaticResource ToolCard}" Click="OnToolCard" Tag="{x:Static app:Cmd.ProtectPassword}">
                                    <app:StartTool Title="{x:Static loc:Strings.Start_ToolProtect}" Detail="{x:Static loc:Strings.Start_ToolProtectDetail}" Glyph="&#xE72E;" />
                                </Button>
                                <Button Style="{StaticResource ToolCard}" Click="OnToolCard" Tag="{x:Static app:Cmd.Redact}">
                                    <app:StartTool Title="{x:Static loc:Strings.Main_Redact}" Detail="{x:Static loc:Strings.Start_ToolRedactDetail}" Glyph="&#xE73B;" />
                                </Button>
                                <Button Style="{StaticResource ToolCard}" Click="OnToolCard" Tag="{x:Static app:Cmd.RecognizeText}">
                                    <app:StartTool Title="{x:Static loc:Strings.Start_ToolOcr}" Detail="{x:Static loc:Strings.Start_ToolOcrDetail}" Glyph="&#xE8C1;" />
                                </Button>
                                <Button Style="{StaticResource ToolCard}" Click="OnToolCard" Tag="{x:Static app:Cmd.Organize}">
                                    <app:StartTool Title="{x:Static loc:Strings.Start_ToolOrganize}" Detail="{x:Static loc:Strings.Start_ToolOrganizeDetail}" Glyph="&#xE8B3;" />
                                </Button>
                                <Button Style="{StaticResource ToolCard}" Click="OnToolCard" Tag="{x:Static app:Cmd.Batch}">
                                    <app:StartTool Title="{x:Static loc:Strings.Start_ToolBatch}" Detail="{x:Static loc:Strings.Start_ToolBatchDetail}" Glyph="&#xE762;" />
                                </Button>
                                <Button x:Name="CreateCard" Style="{StaticResource ToolCard}" Click="OnCreateCard">
                                    <app:StartTool Title="{x:Static loc:Strings.Start_ToolCreate}" Detail="{x:Static loc:Strings.Start_ToolCreateDetail}" Glyph="&#xE8A5;" />
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="CreateOfficeMenu" Command="app:Cmd.CreateFromOffice" Header="{x:Static loc:Strings.Start_CreateFromOffice}" Visibility="Collapsed" />
                                            <MenuItem Command="app:Cmd.CreateFromWeb" Header="{x:Static loc:Strings.Start_CreateFromWeb}" />
                                            <MenuItem Command="app:Cmd.NewFromImages" Header="{x:Static loc:Strings.Start_CreateFromImages}" />
                                            <MenuItem Command="app:Cmd.NewFromClipboard" Header="{x:Static loc:Strings.Start_CreateFromClipboard}" />
                                            <MenuItem Command="app:Cmd.Scan" Header="{x:Static loc:Strings.Start_CreateFromScanner}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </UniformGrid>

                            <DockPanel x:Name="RecentHeader" Margin="0,32,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="{x:Static loc:Strings.Start_ClearList}" Click="OnClearRecent" />
                                <TextBlock Text="{x:Static loc:Strings.Start_Recent}" Style="{DynamicResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ItemsControl x:Name="RecentList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type app:RecentItem}">
                                        <Button Click="OnRecentClick" Tag="{Binding Path}" Width="168" Margin="0,0,12,12" Padding="10"
                                                HorizontalContentAlignment="Stretch" ToolTip="{Binding Path}"
                                                AutomationProperties.Name="{Binding Name}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{x:Static loc:Strings.Start_RecentOpen}" Click="OnRecentMenuOpen" Tag="{Binding Path}" />
                                                    <MenuItem Header="{x:Static loc:Strings.Start_RecentShowInFolder}" Click="OnRecentMenuShow" Tag="{Binding Path}" />
                                                    <Separator />
                                                    <MenuItem Header="{x:Static loc:Strings.Start_RecentRemove}" Click="OnRecentMenuRemove" Tag="{Binding Path}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel>
                                                <Border Height="190" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" CornerRadius="4">
                                                    <Grid>
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="32" Opacity="0.35" />
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="8">
                                                            <Image.Effect>
                                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.25" />
                                                            </Image.Effect>
                                                        </Image>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel x:Name="NoRecent" Visibility="Collapsed" Margin="0,32,0,0">
                                <TextBlock Text="{x:Static loc:Strings.Start_RecentEmpty}" Style="{StaticResource Caption}" />
                                <!-- First-run tip: the Tools grid shows the main tools; the command palette reaches everything else -->
                                <Border Margin="0,24,0,0" Padding="16,12" CornerRadius="6" BorderThickness="1" HorizontalAlignment="Left"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE82F;" FontSize="20" Margin="0,0,12,0"
                                                   VerticalAlignment="Top" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock TextWrapping="Wrap" MaxWidth="640">
                                            <Run FontWeight="SemiBold" Text="{x:Static loc:Strings.Start_NewHere}" />
                                            <Run Text="{x:Static loc:Strings.Start_NewHereText}" />
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Drop overlay -->
                    <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Margin="12" CornerRadius="12"
                            BorderThickness="2" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            Background="{DynamicResource SmokeFillColorDefaultBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="40" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="DropText" Text="{x:Static loc:Strings.Main_DropToOpen}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Toasts (bottom-left) -->
                    <StackPanel x:Name="Toasts" app:TextScale.Scales="True" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,76" />

                    <!-- Command palette -->
                    <Grid x:Name="Palette" app:TextScale.Scales="True" Visibility="Collapsed" Background="Transparent">
                        <Border Width="600" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" Padding="8"
                                CornerRadius="10" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.28" />
                            </Border.Effect>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top">
                                    <TextBox x:Name="PaletteBox" FontSize="15" Padding="10,8"
                                             AutomationProperties.Name="{x:Static loc:Strings.Palette_Placeholder}" />
                                    <!-- Placeholder: shown while the box is empty -->
                                    <TextBlock Text="{x:Static loc:Strings.Palette_Placeholder}" FontSize="15" Margin="13,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PaletteBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock DockPanel.Dock="Bottom" Margin="6,8,6,2" FontSize="11" Style="{StaticResource Caption}"
                                           Text="{x:Static loc:Strings.Palette_Hint}" />
                                <!-- Nothing matches: say so, and what to try (PaletteText) -->
                                <TextBlock x:Name="PaletteEmpty" DockPanel.Dock="Top" Margin="12,14,12,6" TextWrapping="Wrap" Visibility="Collapsed"
                                           AutomationProperties.LiveSetting="Polite" />
                                <ListBox x:Name="PaletteList" MaxHeight="420" Margin="0,8,0,0" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource SubtleListItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{x:Static loc:Strings.Main_Commands}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type app:PaletteItem}">
                                            <DockPanel Margin="2,3">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Gesture}" Style="{StaticResource Caption}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" Width="22" FontSize="13"
                                                           VerticalAlignment="Center" Style="{StaticResource Caption}" />
                                                <TextBlock Text="{Binding Category}" DockPanel.Dock="Left" Style="{StaticResource Caption}" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
