<UserControl x:Class="InkvoltPdf.App.OrganizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:InkvoltPdf.App"
             xmlns:loc="clr-namespace:InkvoltPdf.App"
             Focusable="True" FocusVisualStyle="{x:Null}"
             AutomationProperties.Name="{x:Static loc:Strings.Organize_ViewName}">
    <DockPanel>
        <!-- Header: what is selected, thumbnail size, done -->
        <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1" app:TextScale.Scales="True"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static loc:Strings.Organize_ViewName}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="SelectionText" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="SelectAllButton" Content="{x:Static loc:Strings.Organize_SelectAll}" Margin="16,0,0,0" Style="{StaticResource TextButton}" />
                    <Button x:Name="SelectNoneButton" Content="{x:Static loc:Strings.Organize_ClearSelection}" Margin="4,0,0,0" Style="{StaticResource TextButton}" />
                </StackPanel>
                <Button x:Name="DoneButton" DockPanel.Dock="Right" Content="{x:Static loc:Strings.Common_Done}" MinWidth="88" Margin="16,0,0,0"
                        Style="{DynamicResource AccentButtonStyle}" ToolTip="{x:Static loc:Strings.Organize_DoneTip}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71F;" FontSize="12" Margin="0,0,8,0" />
                    <Slider x:Name="SizeSlider" Minimum="90" Maximum="360" Width="140" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Static loc:Strings.Organize_ThumbnailSize}" ToolTip="{x:Static loc:Strings.Organize_ThumbnailSize}" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A3;" FontSize="12" Margin="8,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Page actions on the selected pages (also on the right-click menu and the Organize menu) -->
        <Border DockPanel.Dock="Top" Padding="12,4" BorderThickness="0,0,0,1" app:TextScale.Scales="True"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <app:ToolbarPanel x:Name="ActionBar" AutomationProperties.Name="{x:Static loc:Strings.Organize_PageActions}">
                <Button Style="{StaticResource CommandButton}" Command="app:Cmd.RotateLeft" ToolTip="{x:Static loc:Strings.Organize_RotateLeftTip}" AutomationProperties.Name="{x:Static loc:Strings.Organize_RotateLeft}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7AD;" FontSize="15" />
                        <TextBlock Text="{x:Static loc:Strings.Organize_RotateLeft}" Margin="8,0,0,0" VerticalAlignment="Center" app:ToolbarPanel.IsLabel="True" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CommandButton}" Command="app:Cmd.RotateRight" ToolTip="{x:Static loc:Strings.Organize_RotateRightTip}" AutomationProperties.Name="{x:Static loc:Strings.Organize_RotateRight}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7AD;" FontSize="15" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="{x:Static loc:Strings.Organize_RotateRight}" Margin="8,0,0,0" VerticalAlignment="Center" app:ToolbarPanel.IsLabel="True" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CommandButton}" Command="app:Cmd.DeleteSelected" ToolTip="{x:Static loc:Strings.Organize_DeleteTip}" AutomationProperties.Name="{x:Static loc:Strings.Common_Delete}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="15" />
                        <TextBlock Text="{x:Static loc:Strings.Common_Delete}" Margin="8,0,0,0" VerticalAlignment="Center" app:ToolbarPanel.IsLabel="True" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CommandButton}" Command="app:Cmd.DuplicatePages" ToolTip="{x:Static loc:Strings.Organize_DuplicateTip}" AutomationProperties.Name="{x:Static loc:Strings.Organize_Duplicate}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="15" />
                        <TextBlock Text="{x:Static loc:Strings.Organize_Duplicate}" Margin="8,0,0,0" VerticalAlignment="Center" app:ToolbarPanel.IsLabel="True" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CommandButton}" Command="app:Cmd.ExtractPages" ToolTip="{x:Static loc:Strings.Organize_ExtractTip}" AutomationProperties.Name="{x:Static loc:Strings.Organize_ExtractButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" FontSize="15" />
                        <TextBlock Text="{x:Static loc:Strings.Organize_ExtractButton}" Margin="8,0,0,0" VerticalAlignment="Center" app:ToolbarPanel.IsLabel="True" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CommandButton}" Command="app:Cmd.MovePages" ToolTip="{x:Static loc:Strings.Organize_MoveTip}" AutomationProperties.Name="{x:Static loc:Strings.Organize_MoveButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8CB;" FontSize="15" />
                        <TextBlock Text="{x:Static loc:Strings.Organize_MoveButton}" Margin="8,0,0,0" VerticalAlignment="Center" app:ToolbarPanel.IsLabel="True" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource BarSeparator}" />
                <Button Style="{StaticResource CommandButton}" Command="app:Cmd.InsertPages" ToolTip="{x:Static loc:Strings.Organize_InsertFileTip}" AutomationProperties.Name="{x:Static loc:Strings.Organize_InsertFile}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="15" />
                        <TextBlock Text="{x:Static loc:Strings.Organize_InsertFile}" Margin="8,0,0,0" VerticalAlignment="Center" app:ToolbarPanel.IsLabel="True" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CommandButton}" Command="app:Cmd.InsertBlank" ToolTip="{x:Static loc:Strings.Organize_InsertBlankTip}" AutomationProperties.Name="{x:Static loc:Strings.Organize_InsertBlank}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="15" />
                        <TextBlock Text="{x:Static loc:Strings.Organize_InsertBlank}" Margin="8,0,0,0" VerticalAlignment="Center" app:ToolbarPanel.IsLabel="True" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource BarSeparator}" />
                <Button Style="{StaticResource CommandButton}" Command="app:Cmd.CropPages" ToolTip="{x:Static loc:Strings.Organize_CropTip}" AutomationProperties.Name="{x:Static loc:Strings.Organize_Crop}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7A8;" FontSize="15" />
                        <TextBlock Text="{x:Static loc:Strings.Organize_Crop}" Margin="8,0,0,0" VerticalAlignment="Center" app:ToolbarPanel.IsLabel="True" />
                    </StackPanel>
                </Button>
            </app:ToolbarPanel>
        </Border>
        <Grid>
            <ItemsControl x:Name="Rows" AllowDrop="True" Background="Transparent"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="Scroller" Focusable="False" Padding="12,8" CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type app:OrganizerRow}">
                        <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type app:OrganizerItem}">
                                    <Border x:Name="Card" Width="{Binding CellWidth}" Margin="4" Padding="8,10,8,6" CornerRadius="8"
                                            Background="Transparent" BorderThickness="2" BorderBrush="Transparent"
                                            AutomationProperties.Name="{Binding AccessibleName}" ToolTip="{Binding Tooltip}">
                                        <StackPanel>
                                            <Grid Width="{Binding Box}" Height="{Binding Box}">
                                                <Border Background="White" Width="{Binding Width}" Height="{Binding Height}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.25" />
                                                    </Border.Effect>
                                                    <Image Source="{Binding Image}" Stretch="Fill" />
                                                </Border>
                                                <!-- Hover actions -->
                                                <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Center" app:TextScale.Scales="True"
                                                            VerticalAlignment="Bottom" Margin="0,0,0,6" Visibility="Hidden">
                                                    <Button Style="{StaticResource HoverAction}" Content="&#xE7AD;" ToolTip="{x:Static loc:Strings.Organize_RotateCcw}"
                                                            Tag="left" Click="OnItemAction" AutomationProperties.Name="{x:Static loc:Strings.Organize_RotateCcw}" />
                                                    <Button Style="{StaticResource HoverAction}" Content="&#xE7AD;" ToolTip="{x:Static loc:Strings.Organize_RotateCw}"
                                                            Tag="right" Click="OnItemAction" AutomationProperties.Name="{x:Static loc:Strings.Organize_RotateCw}" RenderTransformOrigin="0.5,0.5">
                                                        <Button.RenderTransform>
                                                            <ScaleTransform ScaleX="-1" />
                                                        </Button.RenderTransform>
                                                    </Button>
                                                    <Button Style="{StaticResource HoverAction}" Content="&#xE74D;" ToolTip="{x:Static loc:Strings.Common_Delete}"
                                                            Tag="delete" Click="OnItemAction" AutomationProperties.Name="{x:Static loc:Strings.Organize_DeletePage}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12" app:TextScale.Scales="True" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- The focused card (keyboard cursor, or the last one clicked) shows its actions too, not only on hover -->
                                        <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                        <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="False" />
                                                <Condition Binding="{Binding IsMouseOver, ElementName=Card}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="app:Cmd.RotateRight" />
                        <MenuItem Command="app:Cmd.RotateLeft" />
                        <Separator />
                        <MenuItem Command="app:Cmd.DeleteSelected" InputGestureText="{x:Static loc:Strings.Organize_DelKey}" />
                        <MenuItem Command="app:Cmd.DuplicatePages" />
                        <MenuItem Command="app:Cmd.ExtractPages" />
                        <MenuItem Command="app:Cmd.MovePages" />
                        <Separator />
                        <MenuItem Command="app:Cmd.InsertPages" />
                        <MenuItem Command="app:Cmd.InsertBlank" />
                        <MenuItem Command="app:Cmd.CropPages" />
                        <Separator />
                        <MenuItem Command="app:Cmd.Print" Header="{x:Static loc:Strings.Organize_PrintPagesMenu}" />
                        <MenuItem Command="app:Cmd.ExportImages" />
                    </ContextMenu>
                </ItemsControl.ContextMenu>
            </ItemsControl>
        </Grid>
    </DockPanel>
</UserControl>
