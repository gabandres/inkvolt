<UserControl x:Class="InkvoltPdf.App.DocumentTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:InkvoltPdf.App.Viewer"
             xmlns:app="clr-namespace:InkvoltPdf.App"
             xmlns:loc="clr-namespace:InkvoltPdf.App"
             xmlns:core="clr-namespace:InkvoltPdf.Core;assembly=InkvoltPdf.Core">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="NavColumn" Width="220" MinWidth="0" />
            <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Icon rail: one click opens a pane, clicking the open one closes it -->
        <StackPanel x:Name="Rail" app:TextScale.Scales="True" Grid.Column="0" Margin="4,6,4,0" Width="40">
            <ToggleButton x:Name="PagesRail" Style="{StaticResource RailButton}" Content="&#xE8A9;" ToolTip="{x:Static loc:Strings.Tab_PagesThumbnails}" />
            <ToggleButton x:Name="BookmarksRail" Style="{StaticResource RailButton}" Content="&#xE8A4;" ToolTip="{x:Static loc:Strings.Tab_Bookmarks}" />
            <ToggleButton x:Name="SearchRail" Style="{StaticResource RailButton}" Content="&#xE721;" ToolTip="{x:Static loc:Strings.Tab_Search}" />
            <ToggleButton x:Name="CommentsRail" Style="{StaticResource RailButton}" Content="&#xE90A;" ToolTip="{x:Static loc:Strings.Tab_Comments}"
                          AutomationProperties.Name="{x:Static loc:Strings.Tab_Comments}" />
            <Grid x:Name="AttachmentsRailHost">
                <ToggleButton x:Name="AttachmentsRail" Style="{StaticResource RailButton}" Content="&#xE723;" ToolTip="{x:Static loc:Strings.Tab_Attachments}"
                              AutomationProperties.Name="{x:Static loc:Strings.Tab_Attachments}" />
                <Border x:Name="AttachmentsBadge" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,4,2,0" MinWidth="16" Height="16" CornerRadius="8" Padding="4,0" Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock x:Name="AttachmentsBadgeText" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </Grid>
            <ToggleButton x:Name="LayersRail" Style="{StaticResource RailButton}" Content="&#xE81E;" ToolTip="{x:Static loc:Strings.Tab_Layers}" Visibility="Collapsed"
                          AutomationProperties.Name="{x:Static loc:Strings.Tab_Layers}" />
            <ToggleButton x:Name="SignaturesRail" Style="{StaticResource RailButton}" Content="&#xEB95;" ToolTip="{x:Static loc:Strings.Tab_Signatures}" Visibility="Collapsed"
                          AutomationProperties.Name="{x:Static loc:Strings.Tab_Signatures}" />
            <ToggleButton x:Name="AccessibilityRail" Style="{StaticResource RailButton}" Content="&#xE776;" ToolTip="{x:Static loc:Strings.Tab_AccessibilityCheck}" Visibility="Collapsed"
                          AutomationProperties.Name="{x:Static loc:Strings.Tab_AccessibilityCheck}" />
            <ToggleButton x:Name="ReadingOrderRail" Style="{StaticResource RailButton}" Content="&#xE8FD;" ToolTip="{x:Static loc:Strings.Tab_ReadingOrderAltText}" Visibility="Collapsed"
                          AutomationProperties.Name="{x:Static loc:Strings.Tab_ReadingOrderAltText}" />
            <ToggleButton x:Name="SuspectRail" Style="{StaticResource RailButton}" Content="&#xE8AC;" ToolTip="{x:Static loc:Strings.Tab_SuspectWordsTip}" Visibility="Collapsed"
                          AutomationProperties.Name="{x:Static loc:Strings.Tab_SuspectWords}" />
        </StackPanel>

        <!-- Navigation pane -->
        <Border x:Name="NavPane" app:TextScale.Scales="True" Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="14,10,6,6" LastChildFill="False">
                    <TextBlock x:Name="PaneTitle" DockPanel.Dock="Left" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock x:Name="PaneDetail" DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" FontSize="12" />
                    <Button x:Name="ClosePaneButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" FontSize="11" Height="28" MinWidth="28"
                            Content="&#xE711;" ToolTip="{x:Static loc:Strings.Tab_ClosePane}" />
                </DockPanel>
                <Grid>
                    <ListBox x:Name="Thumbs" SelectionMode="Extended" AllowDrop="True" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" HorizontalContentAlignment="Center"
                             AutomationProperties.Name="{x:Static loc:Strings.Tab_PageThumbnails}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource SubtleListItem}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                <Setter Property="Margin" Value="8,2" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type app:ThumbItem}">
                                <StackPanel Margin="2,6,2,2">
                                    <Border Background="White" Width="{Binding Width}" Height="{Binding Height}" HorizontalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.25" />
                                        </Border.Effect>
                                        <Image Source="{Binding Image}" Stretch="Fill" />
                                    </Border>
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="app:Cmd.RotateRight" />
                                <MenuItem Command="app:Cmd.RotateLeft" />
                                <Separator />
                                <MenuItem Command="app:Cmd.DeleteSelected" InputGestureText="{x:Static loc:Strings.Tab_KeyDel}" />
                                <MenuItem Command="app:Cmd.DuplicatePages" />
                                <MenuItem Command="app:Cmd.ExtractPages" />
                                <MenuItem Command="app:Cmd.MovePages" />
                                <Separator />
                                <MenuItem Command="app:Cmd.InsertPages" />
                                <MenuItem Command="app:Cmd.InsertBlank" />
                                <MenuItem Command="app:Cmd.CropPages" />
                                <Separator />
                                <MenuItem Command="app:Cmd.Organize" />
                                <MenuItem Command="app:Cmd.Print" Header="{x:Static loc:Strings.Tab_PrintPages}" />
                                <MenuItem Command="app:Cmd.ExportImages" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <DockPanel x:Name="BookmarksPanel" Visibility="Collapsed">
                        <!-- Bookmark editing: add for the current view, delete, expand/collapse (more on right-click) -->
                        <StackPanel x:Name="BookmarkTools" DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,6,4">
                            <Button Style="{StaticResource IconButton}" Command="app:Cmd.AddBookmark" Content="&#xE710;" FontSize="14"
                                    ToolTip="{x:Static loc:Strings.Tab_AddBookmarkTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_AddBookmark}" />
                            <Button x:Name="BookmarkDeleteButton" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="14" IsEnabled="False"
                                    ToolTip="{x:Static loc:Strings.Tab_DeleteBookmarkTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_DeleteBookmark}" />
                            <Button x:Name="BookmarkExpandButton" Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="14"
                                    ToolTip="{x:Static loc:Strings.Tab_ExpandAll}" AutomationProperties.Name="{x:Static loc:Strings.Tab_ExpandAllBookmarks}" />
                            <Button x:Name="BookmarkCollapseButton" Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="14"
                                    ToolTip="{x:Static loc:Strings.Tab_CollapseAll}" AutomationProperties.Name="{x:Static loc:Strings.Tab_CollapseAllBookmarks}" />
                        </StackPanel>
                        <Grid>
                            <TreeView x:Name="Outline" BorderThickness="0" Background="Transparent" VirtualizingPanel.IsVirtualizing="True"
                                      AllowDrop="True" AutomationProperties.Name="{x:Static loc:Strings.Tab_Bookmarks}">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type app:BookmarkNode}" ItemsSource="{Binding Children}">
                                        <Grid>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                                                       FontWeight="{Binding Weight}" FontStyle="{Binding Style}" Visibility="{Binding TitleVisibility}" />
                                            <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding EditorVisibility}"
                                                     MinWidth="140" Margin="-4,-3,0,-3" AutomationProperties.Name="{x:Static loc:Strings.Tab_BookmarkTitle}"
                                                     IsVisibleChanged="OnBookmarkEditorVisible" PreviewKeyDown="OnBookmarkEditorKey"
                                                     LostKeyboardFocus="OnBookmarkEditorLostFocus" />
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <StackPanel x:Name="NoBookmarks" Margin="16,24" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A4;" FontSize="28" Opacity="0.5" HorizontalAlignment="Left" />
                                <TextBlock Text="{x:Static loc:Strings.Tab_NoBookmarks}" FontWeight="SemiBold" Margin="0,10,0,4" />
                                <TextBlock x:Name="NoBookmarksText" Text="{x:Static loc:Strings.Tab_NoTableOfContents}" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>

                    <DockPanel x:Name="SearchPanel" Margin="10,0,10,8" Visibility="Collapsed">
                        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" AutomationProperties.Name="{x:Static loc:Strings.Tab_SearchText}" app:Placeholder.Text="{x:Static loc:Strings.Tab_SearchThisDocument}" />
                        <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                            <CheckBox x:Name="SearchMatchCase" Content="{x:Static loc:Strings.Tab_MatchCase}" Margin="0,0,12,0" />
                            <CheckBox x:Name="SearchWholeWords" Content="{x:Static loc:Strings.Tab_WholeWords}" Margin="0,0,12,0" />
                            <CheckBox x:Name="SearchIgnoreAccents" Content="{x:Static loc:Strings.Tab_IgnoreAccents}" ToolTip="{x:Static loc:Strings.Tab_IgnoreAccentsTip}" />
                        </WrapPanel>
                        <Button x:Name="SearchButton" DockPanel.Dock="Top" Content="{x:Static loc:Strings.Tab_Search}" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                Style="{DynamicResource AccentButtonStyle}" />
                        <TextBlock x:Name="SearchStatus" DockPanel.Dock="Top" Margin="0,10,0,6" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                        <Button x:Name="RedactHitsButton" DockPanel.Dock="Top" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="-8,0,0,4"
                                Content="{x:Static loc:Strings.Tab_MarkAllForRedaction}" Visibility="Collapsed"
                                ToolTip="{x:Static loc:Strings.Tab_MarkAllForRedactionTip}" />
                        <ListBox x:Name="SearchResults" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                 AutomationProperties.Name="{x:Static loc:Strings.Tab_SearchResults}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SubtleListItem}">
                                    <Setter Property="AutomationProperties.Name">
                                        <Setter.Value>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Path="PageLabel" />
                                                <Binding Path="Excerpt" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type v:SearchHit}">
                                    <StackPanel Margin="0,3">
                                        <TextBlock Text="{Binding PageLabel}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Excerpt}" TextWrapping="Wrap" FontSize="12" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Comments: grouped by page, filter, edit, delete -->
                    <DockPanel x:Name="CommentsPanel" Margin="10,0,10,8" Visibility="Collapsed">
                        <TextBox x:Name="CommentFilter" DockPanel.Dock="Top" AutomationProperties.Name="{x:Static loc:Strings.Tab_FilterComments}"
                                 app:Placeholder.Text="{x:Static loc:Strings.Tab_FilterCommentsPlaceholder}"
                                 ToolTip="{x:Static loc:Strings.Tab_FilterCommentsTip}" />
                        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,6,0,2">
                            <Button Style="{StaticResource IconButton}" Command="app:Cmd.Highlight" Content="&#xE7E6;" FontSize="14"
                                    ToolTip="{x:Static loc:Strings.Tab_HighlightTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_Highlight}" />
                            <Button Style="{StaticResource IconButton}" Command="app:Cmd.Underline" Content="&#xE8DC;" FontSize="14"
                                    ToolTip="{x:Static loc:Strings.Tab_UnderlineTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_Underline}" />
                            <Button Style="{StaticResource IconButton}" Command="app:Cmd.StrikeOut" Content="&#xE738;" FontSize="14"
                                    ToolTip="{x:Static loc:Strings.Tab_StrikeOutTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_StrikeOut}" />
                            <ToggleButton x:Name="NoteToolButton" Style="{StaticResource IconButton}" Command="app:Cmd.AddNote" Content="&#xE70B;" FontSize="14"
                                          ToolTip="{x:Static loc:Strings.Tab_AddNoteTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_AddNote}" />
                            <Border Style="{StaticResource BarSeparator}" />
                            <Button x:Name="CommentEditButton" Style="{StaticResource IconButton}" Content="&#xE70F;" FontSize="14" IsEnabled="False"
                                    ToolTip="{x:Static loc:Strings.Tab_EditCommentTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_EditComment}" />
                            <Button x:Name="CommentDeleteButton" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="14" IsEnabled="False"
                                    ToolTip="{x:Static loc:Strings.Tab_DeleteCommentTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_DeleteComment}" />
                        </WrapPanel>
                        <TextBlock x:Name="CommentsEmpty" DockPanel.Dock="Top" Margin="4,10,4,0" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                        <ListBox x:Name="CommentList" BorderThickness="0" Background="Transparent" Margin="-4,4,-4,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"
                                 AutomationProperties.Name="{x:Static loc:Strings.Tab_Comments}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SubtleListItem}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Margin="8,10,0,2" Style="{StaticResource Caption}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type app:CommentItem}">
                                    <DockPanel Margin="{Binding Indent}">
                                        <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="4" Margin="0,2,8,0" VerticalAlignment="Top"
                                                Background="{Binding Swatch}">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" Foreground="{Binding GlyphBrush}" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Meta, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Contents}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,2" MaxHeight="64"
                                                       TextTrimming="CharacterEllipsis" Visibility="{Binding ContentsVisibility}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="CommentEditMenu" Header="{x:Static loc:Strings.Tab_MenuEditText}" InputGestureText="{x:Static loc:Strings.Tab_KeyEnter}" />
                                    <MenuItem x:Name="CommentDeleteMenu" Header="{x:Static loc:Strings.Tab_MenuDelete}" InputGestureText="{x:Static loc:Strings.Tab_KeyDel}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </DockPanel>

                    <!-- Attachments -->
                    <DockPanel x:Name="AttachmentsPanel" Margin="10,0,10,8" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,2">
                            <Button x:Name="AttachSaveButton" Style="{StaticResource IconButton}" Content="&#xE74E;" FontSize="14" IsEnabled="False"
                                    ToolTip="{x:Static loc:Strings.Tab_SaveAttachmentTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_SaveAttachment}" />
                            <Button x:Name="AttachOpenButton" Style="{StaticResource IconButton}" Content="&#xE8E5;" FontSize="14" IsEnabled="False"
                                    ToolTip="{x:Static loc:Strings.Tab_OpenAttachmentTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_OpenAttachment}" />
                            <Border Style="{StaticResource BarSeparator}" />
                            <Button x:Name="AttachAddButton" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="14"
                                    ToolTip="{x:Static loc:Strings.Tab_AttachFileTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_AddAttachment}" />
                            <Button x:Name="AttachRemoveButton" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="14" IsEnabled="False"
                                    ToolTip="{x:Static loc:Strings.Tab_RemoveAttachmentTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_RemoveAttachment}" />
                        </StackPanel>
                        <TextBlock x:Name="AttachmentsEmpty" DockPanel.Dock="Top" Margin="4,10,4,0" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                   Text="{x:Static loc:Strings.Tab_NoAttachments}" />
                        <ListBox x:Name="AttachmentList" BorderThickness="0" Background="Transparent" Margin="-4,4,-4,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{x:Static loc:Strings.Tab_Attachments}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SubtleListItem}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                    <Setter Property="ToolTip" Value="{Binding Tip}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type app:AttachmentItem}">
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" Margin="0,0,10,0"
                                                   VerticalAlignment="Top" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Layers (optional content): visibility for viewing and printing -->
                    <DockPanel x:Name="LayersPanel" Margin="10,0,10,8" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{StaticResource Caption}" FontSize="12" Margin="4,0,4,6"
                                   Text="{x:Static loc:Strings.Tab_LayersNote}" />
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button x:Name="LayersResetButton" Content="{x:Static loc:Strings.Common_Reset}" Margin="0,0,8,4" IsEnabled="False"
                                    ToolTip="{x:Static loc:Strings.Tab_LayersResetTip}" />
                            <Button x:Name="LayersSaveButton" Content="{x:Static loc:Strings.Tab_LayersSaveDefault}" Margin="0,0,0,4" IsEnabled="False"
                                    ToolTip="{x:Static loc:Strings.Tab_LayersSaveDefaultTip}" />
                        </WrapPanel>
                        <TreeView x:Name="LayerTree" BorderThickness="0" Background="Transparent" AutomationProperties.Name="{x:Static loc:Strings.Tab_Layers}">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type app:LayerNode}" ItemsSource="{Binding Children}">
                                    <Grid>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" MinHeight="0" Padding="6,0,0,0"
                                                  Visibility="{Binding CheckVisibility}" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Label}" />
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Visibility="{Binding GroupVisibility}" />
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>

                    <!-- Digital signatures -->
                    <ScrollViewer x:Name="SignaturesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                        <!-- Long-term validation. Both go online only after a window that lists what is contacted (LtvDialogs) -->
                        <WrapPanel Margin="10,0,10,6">
                            <Button x:Name="SigAddVerification" Command="app:Cmd.AddVerification" Content="{x:Static loc:Strings.Tab_AddVerification}" Margin="0,0,8,4"
                                    ToolTip="{x:Static loc:Strings.Tab_AddVerificationTip}"
                                    AutomationProperties.Name="{x:Static loc:Strings.Tab_AddVerificationName}"
                                    AutomationProperties.HelpText="{x:Static loc:Strings.Tab_AddVerificationHelp}" />
                            <Button x:Name="SigCheckOnline" Command="app:Cmd.CheckSignaturesOnline" Content="{x:Static loc:Strings.Tab_CheckOnline}" Margin="0,0,0,4"
                                    ToolTip="{x:Static loc:Strings.Tab_CheckOnlineTip}"
                                    AutomationProperties.Name="{x:Static loc:Strings.Tab_CheckOnlineName}"
                                    AutomationProperties.HelpText="{x:Static loc:Strings.Tab_CheckOnlineHelp}" />
                        </WrapPanel>
                        <TextBlock x:Name="SigLtvOutcome" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Margin="10,0,10,4"
                                   AutomationProperties.Name="{x:Static loc:Strings.Tab_LtvResult}" AutomationProperties.LiveSetting="Polite" />
                        <Expander x:Name="SigLtvDetails" Visibility="Collapsed" Header="{x:Static loc:Strings.Tab_WhatWasAsked}" Margin="10,0,10,8" AutomationProperties.Name="{x:Static loc:Strings.Tab_WhatWasAsked}">
                            <TextBox x:Name="SigLtvDetailsText" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"
                                     AutomationProperties.Name="{x:Static loc:Strings.Tab_EachCertificateAsked}" />
                        </Expander>
                        <ItemsControl x:Name="SignatureList" Margin="10,0,10,8" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type app:SignatureItem}">
                                    <Border Padding="10,8" Margin="0,0,0,8" CornerRadius="6" BorderThickness="1"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Top" Text="{Binding Glyph}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="ok">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="bad">
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="none">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,6" />
                                                <TextBlock Text="{Binding LongTerm}" Visibility="{Binding LongTermVisibility}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" />
                                                <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" BorderThickness="0"
                                                         Background="Transparent" Padding="0" MinHeight="0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                         AutomationProperties.Name="{x:Static loc:Strings.Tab_SignatureDetails}" />
                                                <Button Style="{StaticResource TextButton}" Content="{x:Static loc:Strings.Tab_GoToSignature}" HorizontalAlignment="Left" Margin="-8,2,0,0"
                                                        Tag="{Binding}" Click="OnGoToSignature" Visibility="{Binding GoVisibility}" />
                                                <Button Style="{StaticResource TextButton}" Content="{x:Static loc:Strings.Tab_SignThisField}" HorizontalAlignment="Left" Margin="-8,0,0,0"
                                                        Tag="{Binding}" Click="OnSignField" Visibility="{Binding SignVisibility}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Accessibility check (PDF/UA-1, Matterhorn): what fails, each item jumps to its place; the person's checklist -->
                    <DockPanel x:Name="AccessibilityPanel" Margin="10,0,10,8" Visibility="Collapsed">
                        <TextBlock x:Name="A11ySummary" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="4,0,4,6" FontSize="12"
                                   AutomationProperties.Name="{x:Static loc:Strings.Tab_A11yResult}" />
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button x:Name="A11yRecheck" Content="{x:Static loc:Strings.Tab_CheckAgain}" Margin="0,0,8,4" ToolTip="{x:Static loc:Strings.Tab_CheckAgainTip}" />
                            <Button x:Name="A11ySave" Content="{x:Static loc:Strings.Tab_SaveReport}" Margin="0,0,0,4" ToolTip="{x:Static loc:Strings.Tab_SaveReportTip}" />
                        </WrapPanel>
                        <TabControl x:Name="A11yTabs" Background="Transparent" BorderThickness="0" Padding="0,6,0,0">
                            <!-- Short headers: the pane is 220 px wide, and WPF's tab strip wraps long ones into two rows -->
                            <TabItem x:Name="A11yFailuresTab" Header="{x:Static loc:Strings.Tab_A11yFails}">
                                <DockPanel>
                                    <TextBlock x:Name="A11yNone" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="4,8,4,0" Style="{StaticResource Caption}" Visibility="Collapsed"
                                               Text="{x:Static loc:Strings.Tab_A11yNothingFails}" />
                                    <ListBox x:Name="A11yList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" HorizontalContentAlignment="Stretch"
                                             AutomationProperties.Name="{x:Static loc:Strings.Tab_A11yFailsList}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type app:A11yItem}">
                                                <StackPanel Margin="0,4">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding Fix}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </DockPanel>
                            </TabItem>
                            <TabItem x:Name="A11yPersonTab" Header="{x:Static loc:Strings.Tab_A11yChecklist}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" Margin="4,8,4,8" Style="{StaticResource Caption}"
                                                   Text="{x:Static loc:Strings.Tab_A11yChecklistNote}" />
                                        <ItemsControl x:Name="A11yChecklist" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type app:A11yCheckItem}">
                                                    <StackPanel Margin="0,0,0,10">
                                                        <CheckBox IsChecked="{Binding Done}" AutomationProperties.Name="{Binding Question}" AutomationProperties.HelpText="{Binding How}">
                                                            <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                        </CheckBox>
                                                        <TextBlock Text="{Binding How}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="26,2,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </DockPanel>

                    <!-- Reading order (Make Accessible): this page's pieces in the order a screen reader reads them, numbered on the page
                         too; reordered by drag or Alt+Up/Down; alternate text for each picture -->
                    <DockPanel x:Name="ReadingOrderPanel" Margin="10,0,10,8" Visibility="Collapsed">
                        <TextBlock x:Name="RoSummary" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="4,0,4,6" FontSize="12"
                                   AutomationProperties.Name="{x:Static loc:Strings.Tab_ReadingOrderSummary}" />
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button x:Name="RoUp" Content="{x:Static loc:Strings.Tab_MoveUp}" Margin="0,0,8,4" ToolTip="{x:Static loc:Strings.Tab_MoveUpTip}" />
                            <Button x:Name="RoDown" Content="{x:Static loc:Strings.Tab_MoveDown}" Margin="0,0,8,4" ToolTip="{x:Static loc:Strings.Tab_MoveDownTip}" />
                            <Button x:Name="RoPageBefore" Content="{x:Static loc:Strings.Tab_PageBefore}" Margin="0,0,8,4"
                                    ToolTip="{x:Static loc:Strings.Tab_PageBeforeTip}" />
                            <Button x:Name="RoPageAfter" Content="{x:Static loc:Strings.Tab_PageAfter}" Margin="0,0,8,4"
                                    ToolTip="{x:Static loc:Strings.Tab_PageAfterTip}" />
                            <Button x:Name="RoApply" Content="{x:Static loc:Strings.Tab_ApplyChanges}" Margin="0,0,0,4"
                                    ToolTip="{x:Static loc:Strings.Tab_ApplyChangesTip}" />
                        </WrapPanel>
                        <StackPanel x:Name="RoFigure" DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="RoAltLabel" Text="{x:Static loc:Strings.Tab_AltText}" FontWeight="SemiBold" Margin="2,0,0,4" />
                            <TextBox x:Name="RoAlt" TextWrapping="Wrap" MinHeight="60" MaxLength="1000" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="{x:Static loc:Strings.Tab_AltTextName}"
                                     AutomationProperties.HelpText="{x:Static loc:Strings.Tab_AltTextHelp}" />
                            <DockPanel Margin="0,6,0,0" LastChildFill="False">
                                <CheckBox x:Name="RoDecorative" DockPanel.Dock="Left" Content="{x:Static loc:Strings.Tab_Decorative}" VerticalAlignment="Center" />
                                <Button x:Name="RoSuggest" DockPanel.Dock="Right" Content="{x:Static loc:Strings.Tab_SuggestWithAi}"
                                        ToolTip="{x:Static loc:Strings.Tab_SuggestWithAiTip}" />
                            </DockPanel>
                        </StackPanel>
                        <DockPanel x:Name="RoPiece" DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="RoKindLabel" DockPanel.Dock="Left" Text="{x:Static loc:Strings.Tab_PieceKind}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="2,0,8,0" />
                            <ComboBox x:Name="RoKind" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static loc:Strings.Tab_PieceKindName}"
                                      AutomationProperties.HelpText="{x:Static loc:Strings.Tab_PieceKindTip}" ToolTip="{x:Static loc:Strings.Tab_PieceKindTip}" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="4,6,4,0" Style="{StaticResource Caption}"
                                   Text="{x:Static loc:Strings.Tab_ReadingOrderHelp}" />
                        <ListBox x:Name="RoList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch" AllowDrop="True"
                                 AutomationProperties.Name="{x:Static loc:Strings.Tab_ReadingOrderList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type app:ReadingOrderItem}">
                                    <DockPanel Margin="0,3">
                                        <Border DockPanel.Dock="Left" MinWidth="22" Height="18" CornerRadius="3" Background="{Binding Badge}" Margin="0,0,8,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Number}" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Margin="4,0" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" FontSize="12" Style="{StaticResource Caption}" MaxHeight="34"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>

                    <!-- Suspect words: recognized words to check, each beside its picture; corrected in place -->
                    <DockPanel x:Name="SuspectPanel" Margin="10,0,10,8" Visibility="Collapsed">
                        <TextBlock x:Name="SuspectSummary" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="4,0,4,6" FontSize="12"
                                   AutomationProperties.Name="{x:Static loc:Strings.Tab_SuspectSummary}" />
                        <StackPanel x:Name="SuspectEditor" DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock Text="{x:Static loc:Strings.Tab_CorrectTo}" FontWeight="SemiBold" Margin="2,0,0,4" />
                            <TextBox x:Name="SuspectText" AutomationProperties.Name="{x:Static loc:Strings.Tab_CorrectToName}"
                                     AutomationProperties.HelpText="{x:Static loc:Strings.Tab_CorrectToHelp}" />
                            <WrapPanel x:Name="SuspectSuggestions" Margin="0,6,0,0" Visibility="Collapsed"
                                       AutomationProperties.Name="{x:Static loc:Strings.Tab_SpellingSuggestions}" />
                            <WrapPanel Margin="0,6,0,0">
                                <Button x:Name="SuspectCorrect" Content="{x:Static loc:Strings.Tab_Correct}" Margin="0,0,8,4"
                                        ToolTip="{x:Static loc:Strings.Tab_CorrectTip}" />
                                <Button x:Name="SuspectKeep" Content="{x:Static loc:Strings.Tab_KeepAsRead}" Margin="0,0,8,4"
                                        ToolTip="{x:Static loc:Strings.Tab_KeepAsReadTip}" />
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="4,6,4,0" Style="{StaticResource Caption}"
                                   Text="{x:Static loc:Strings.Tab_SuspectHelp}" />
                        <ListBox x:Name="SuspectList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                 AutomationProperties.Name="{x:Static loc:Strings.Tab_SuspectList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type app:SuspectWordItem}">
                                    <StackPanel Margin="0,4">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="88" Height="34" Margin="0,0,8,0" Background="White" BorderThickness="1"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="3" ClipToBounds="True"
                                                    ToolTip="{x:Static loc:Strings.Tab_SuspectWordTip}">
                                                <Image Source="{Binding Image}" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.LayoutTransform>
                                                        <RotateTransform Angle="{Binding Level}" />
                                                    </Image.LayoutTransform>
                                                </Image>
                                            </Border>
                                            <TextBlock Text="{Binding Text}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{x:Static loc:Strings.Tab_AsRecognized}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter x:Name="NavSplitter" Grid.Column="2" Width="4" HorizontalAlignment="Stretch" Background="Transparent"
                      AutomationProperties.Name="{x:Static loc:Strings.Tab_ResizePane}" />

        <Grid Grid.Column="3">
            <!-- Reading view -->
            <Grid x:Name="ReadingView">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" app:TextScale.Scales="True">
                <!-- InfoBar: the file changed (or disappeared) on disk -->
                <Border x:Name="DiskBar" Visibility="Collapsed" Padding="14,8" Margin="12,10,12,0" CornerRadius="6"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        AutomationProperties.LiveSetting="Assertive">
                    <DockPanel>
                        <Button x:Name="DiskBarClose" DockPanel.Dock="Right" Style="{StaticResource IconButton}" FontSize="10" Height="26" MinWidth="26"
                                Content="&#xE711;" ToolTip="{x:Static loc:Strings.Tab_Dismiss}" AutomationProperties.Name="{x:Static loc:Strings.Tab_Dismiss}" />
                        <Button x:Name="DiskBarSecondary" DockPanel.Dock="Right" Margin="8,0,4,0" />
                        <Button x:Name="DiskBarPrimary" DockPanel.Dock="Right" Margin="12,0,0,0" Style="{DynamicResource AccentButtonStyle}" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="16" Margin="0,0,12,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock x:Name="DiskBarText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- InfoBar: this document has fillable fields -->
                <Border x:Name="FormBar" Visibility="Collapsed" Padding="14,8" Margin="12,10,12,0" CornerRadius="6"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <DockPanel>
                        <Button x:Name="FormBarClose" DockPanel.Dock="Right" Style="{StaticResource IconButton}" FontSize="10" Height="26" MinWidth="26"
                                Content="&#xE711;" ToolTip="{x:Static loc:Strings.Tab_Dismiss}" />
                        <CheckBox x:Name="HighlightFieldsBox" DockPanel.Dock="Right" Content="{x:Static loc:Strings.Tab_HighlightFields}" IsChecked="True" Margin="12,0,8,0" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE70B;" FontSize="16" Margin="0,0,12,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="FormBarText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- InfoBar: the form is XFA-only (Inkvolt PDF can't fill it) -->
                <Border x:Name="XfaBar" Visibility="Collapsed" Padding="14,8" Margin="12,10,12,0" CornerRadius="6"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <DockPanel>
                        <Button x:Name="XfaBarClose" DockPanel.Dock="Right" Style="{StaticResource IconButton}" FontSize="10" Height="26" MinWidth="26"
                                Content="&#xE711;" ToolTip="{x:Static loc:Strings.Tab_Dismiss}" AutomationProperties.Name="{x:Static loc:Strings.Tab_Dismiss}" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="16" Margin="0,0,12,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{x:Static loc:Strings.Tab_XfaNote}" />
                    </DockPanel>
                </Border>

                <!-- InfoBar: the file was damaged and opened as a repaired copy (said once; Save writes that copy) -->
                <Border x:Name="RepairBar" Visibility="Collapsed" Padding="14,8" Margin="12,10,12,0" CornerRadius="6"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        AutomationProperties.LiveSetting="Polite">
                    <DockPanel>
                        <Button x:Name="RepairBarClose" DockPanel.Dock="Right" Style="{StaticResource IconButton}" FontSize="10" Height="26" MinWidth="26"
                                Content="&#xE711;" ToolTip="{x:Static loc:Strings.Tab_Dismiss}" AutomationProperties.Name="{x:Static loc:Strings.Tab_Dismiss}" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="16" Margin="0,0,12,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{x:Static loc:Strings.Tab_RepairedNote}" />
                    </DockPanel>
                </Border>

                <!-- InfoBar: digital signatures -->
                <Border x:Name="SigBar" Visibility="Collapsed" Padding="14,8" Margin="12,10,12,0" CornerRadius="6"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <DockPanel>
                        <Button x:Name="SigBarClose" DockPanel.Dock="Right" Style="{StaticResource IconButton}" FontSize="10" Height="26" MinWidth="26"
                                Content="&#xE711;" ToolTip="{x:Static loc:Strings.Tab_Dismiss}" AutomationProperties.Name="{x:Static loc:Strings.Tab_Dismiss}" />
                        <Button x:Name="SigBarDetails" DockPanel.Dock="Right" Content="{x:Static loc:Strings.Tab_SignatureDetails}" Margin="12,0,4,0" />
                        <TextBlock x:Name="SigBarIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xEB95;" FontSize="16" Margin="0,0,12,0" />
                        <TextBlock x:Name="SigBarText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- InfoBar: redaction marks waiting to be applied -->
                <Border x:Name="RedactBar" Visibility="Collapsed" Padding="14,8" Margin="12,10,12,0" CornerRadius="6"
                        Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <DockPanel>
                        <Button x:Name="RedactDone" DockPanel.Dock="Right" Style="{StaticResource IconButton}" FontSize="10" Height="26" MinWidth="26"
                                Content="&#xE711;" ToolTip="{x:Static loc:Strings.Tab_RedactLeaveTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_RedactClose}" />
                        <!-- Apply: its icon is the bar's only red (ApplyRedactionsBrush, App.ApplyBarColors), so not an accent button -->
                        <Button x:Name="RedactApply" DockPanel.Dock="Right" Margin="8,0,4,0" AutomationProperties.Name="{x:Static loc:Strings.Tab_ApplyRedactions}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73B;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource ApplyRedactionsBrush}" />
                                <TextBlock Text="{x:Static loc:Strings.Tab_ApplyRedactions}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RedactClear" DockPanel.Dock="Right" Content="{x:Static loc:Strings.Tab_ClearMarks}" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.Tab_RedactByPattern}" Margin="12,0,0,0" Command="app:Cmd.RedactPatterns"
                                ToolTip="{x:Static loc:Strings.Tab_RedactByPatternTip}" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE73B;" FontSize="16" Margin="0,0,12,0"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <TextBlock x:Name="RedactBarText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
                </StackPanel>

                <!-- Split view (View › Split View): the main pane, a splitter and a second pane on the same document.
                     Rows and columns are set by DocumentTab.Split.cs; the active pane gets an accent frame. -->
                <Grid x:Name="SplitHost" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="MainPaneFrame" Grid.RowSpan="3" Grid.ColumnSpan="3" BorderThickness="0">
                <v:PageViewer x:Name="Viewer" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                              AutomationProperties.Name="{x:Static loc:Strings.Tab_DocumentPages}">
                    <v:PageViewer.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="CtxEditLink" Header="{x:Static loc:Strings.Tab_MenuEditLink}" />
                            <MenuItem x:Name="CtxDeleteLink" Header="{x:Static loc:Strings.Tab_MenuDeleteLink}" />
                            <Separator x:Name="CtxLinkSeparator" />
                            <MenuItem x:Name="CtxHighlight" Command="app:Cmd.Highlight" />
                            <MenuItem x:Name="CtxUnderline" Command="app:Cmd.Underline" />
                            <MenuItem x:Name="CtxStrikeOut" Command="app:Cmd.StrikeOut" />
                            <MenuItem x:Name="CtxLinkText" Command="app:Cmd.LinkSelection" />
                            <MenuItem x:Name="CtxRedactText" Header="{x:Static loc:Strings.Tab_MenuMarkForRedaction}" />
                            <Separator x:Name="CtxMarkupSeparator" />
                            <MenuItem Command="app:Cmd.Copy" />
                            <MenuItem Command="app:Cmd.SelectAll" />
                            <Separator />
                            <MenuItem Command="app:Cmd.ToolHand" InputGestureText="{x:Static loc:Strings.Tab_KeyH}" />
                            <MenuItem Command="app:Cmd.ToolSelect" InputGestureText="{x:Static loc:Strings.Tab_KeyT}" />
                            <MenuItem Command="app:Cmd.ToolSnapshot" InputGestureText="{x:Static loc:Strings.Tab_KeyG}" />
                            <Separator />
                            <MenuItem Command="app:Cmd.Back" />
                            <MenuItem Command="app:Cmd.Forward" />
                            <Separator />
                            <MenuItem Command="app:Cmd.ZoomIn" />
                            <MenuItem Command="app:Cmd.ZoomOut" />
                            <MenuItem Command="app:Cmd.FitWidth" />
                            <MenuItem Command="app:Cmd.FitPage" />
                            <Separator />
                            <!-- "Page": these change the file (rotating only the view is a View command) -->
                            <MenuItem Command="app:Cmd.RotateRight" Header="{x:Static loc:Strings.Tab_RotateClockwise}" />
                            <MenuItem Command="app:Cmd.RotateLeft" Header="{x:Static loc:Strings.Tab_RotateCounterclockwise}" />
                            <MenuItem Command="app:Cmd.Organize" />
                            <MenuItem Command="app:Cmd.Print" />
                        </ContextMenu>
                    </v:PageViewer.ContextMenu>
                </v:PageViewer>
                    </Border>
                    <GridSplitter x:Name="PaneSplitter" Visibility="Collapsed" Background="{DynamicResource CardStrokeColorDefaultBrush}"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                                  KeyboardIncrement="24" AutomationProperties.Name="{x:Static loc:Strings.Tab_ResizeSplit}" />
                    <Border x:Name="SecondPaneFrame" Visibility="Collapsed" BorderThickness="2">
                        <Grid x:Name="SecondPaneHost">
                            <Button x:Name="CloseSplitButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,6,22,0" FontSize="11" Height="28" MinWidth="28" Content="&#xE711;" Panel.ZIndex="1"
                                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                    ToolTip="{x:Static loc:Strings.Tab_CloseSplit}" AutomationProperties.Name="{x:Static loc:Strings.Tab_CloseSplit}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Find widget (Ctrl+F), floating top-right -->
                <Border x:Name="FindBar" app:TextScale.Scales="True" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,28,0" Padding="6"
                        Visibility="Collapsed" CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="FindBox" Width="230" VerticalContentAlignment="Center" AutomationProperties.Name="{x:Static loc:Strings.Tab_FindInDocument}"
                                 app:Placeholder.Text="{x:Static loc:Strings.Tab_FindInDocument}" ToolTip="{x:Static loc:Strings.Tab_FindBoxTip}" />
                        <TextBlock x:Name="FindStatus" Margin="10,0,6,0" VerticalAlignment="Center" MinWidth="64" FontSize="12" Style="{StaticResource Caption}" />
                        <!-- Option toggles: the tooltip says what each short label means; screen readers get the name and on/off state -->
                        <ToggleButton x:Name="FindMatchCase" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Tab_MatchCaseGlyph}" FontWeight="SemiBold" Padding="8,4"
                                      ToolTip="{x:Static loc:Strings.Tab_MatchCaseTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_MatchCase}" />
                        <ToggleButton x:Name="FindWholeWords" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Tab_WholeWordsGlyph}" FontWeight="SemiBold" Padding="8,4"
                                      ToolTip="{x:Static loc:Strings.Tab_WholeWordsTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_WholeWordsOnly}" />
                        <ToggleButton x:Name="FindIgnoreAccents" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Tab_IgnoreAccentsGlyph}" FontWeight="SemiBold" Padding="8,4"
                                      ToolTip="{x:Static loc:Strings.Tab_IgnoreAccentsFindTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_IgnoreAccents}" />
                        <Button x:Name="FindPrevButton" Style="{StaticResource IconButton}" Content="&#xE70E;" FontSize="12" ToolTip="{x:Static loc:Strings.Tab_PreviousMatch}"
                                AutomationProperties.Name="{x:Static loc:Strings.Tab_PreviousMatch}" />
                        <Button x:Name="FindNextButton" Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="12" ToolTip="{x:Static loc:Strings.Tab_NextMatch}"
                                AutomationProperties.Name="{x:Static loc:Strings.Tab_NextMatch}" />
                        <Button x:Name="FindCloseButton" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" ToolTip="{x:Static loc:Strings.Tab_CloseEsc}"
                                AutomationProperties.Name="{x:Static loc:Strings.Tab_CloseFind}" />
                    </StackPanel>
                </Border>

                <!-- Drawing style bar, floating top-center: with a drawing tool, a selected drawing or an open text box
                     (DocumentTab.Drawing.cs fills the swatches and shows the groups that apply) -->
                <Border x:Name="StyleBar" app:TextScale.Scales="True" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Padding="4,2"
                        Visibility="Collapsed" CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        AutomationProperties.Name="{x:Static loc:Strings.Tab_DrawingStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StyleBarIcon" Style="{StaticResource Icon}" FontSize="14" Margin="8,0,6,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="StyleBarTitle" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" Style="{StaticResource Caption}" />
                        <StackPanel x:Name="StyleSwatches" Orientation="Horizontal" />
                        <Button x:Name="StyleCustomColor" Style="{StaticResource IconButton}" FontSize="14" MinWidth="30" Height="30" Padding="6,4"
                                Content="&#xE790;" ToolTip="{x:Static loc:Strings.Tab_MoreColorsTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_MoreColors}" />
                        <StackPanel x:Name="StyleWidthGroup" Orientation="Horizontal">
                            <Border Style="{StaticResource BarSeparator}" />
                            <Button x:Name="StyleThinner" Style="{StaticResource IconButton}" FontSize="11" MinWidth="28" Height="30" Padding="4"
                                    Content="&#xE738;" ToolTip="{x:Static loc:Strings.Tab_ThinnerLine}" AutomationProperties.Name="{x:Static loc:Strings.Tab_ThinnerLine}" />
                            <TextBlock x:Name="StyleWidthText" MinWidth="40" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" ToolTip="{x:Static loc:Strings.Tab_LineWidth}" />
                            <Button x:Name="StyleThicker" Style="{StaticResource IconButton}" FontSize="11" MinWidth="28" Height="30" Padding="4"
                                    Content="&#xE710;" ToolTip="{x:Static loc:Strings.Tab_ThickerLine}" AutomationProperties.Name="{x:Static loc:Strings.Tab_ThickerLine}" />
                        </StackPanel>
                        <StackPanel x:Name="StyleFontGroup" Orientation="Horizontal">
                            <Border Style="{StaticResource BarSeparator}" />
                            <Button x:Name="StyleSmaller" Style="{StaticResource IconButton}" FontSize="11" MinWidth="28" Height="30" Padding="4"
                                    Content="&#xE738;" ToolTip="{x:Static loc:Strings.Tab_SmallerText}" AutomationProperties.Name="{x:Static loc:Strings.Tab_SmallerText}" />
                            <TextBlock x:Name="StyleFontText" MinWidth="40" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" ToolTip="{x:Static loc:Strings.Tab_TextSize}" />
                            <Button x:Name="StyleLarger" Style="{StaticResource IconButton}" FontSize="11" MinWidth="28" Height="30" Padding="4"
                                    Content="&#xE710;" ToolTip="{x:Static loc:Strings.Tab_LargerText}" AutomationProperties.Name="{x:Static loc:Strings.Tab_LargerText}" />
                        </StackPanel>
                        <StackPanel x:Name="StyleOpacityGroup" Orientation="Horizontal">
                            <Border Style="{StaticResource BarSeparator}" />
                            <Button x:Name="StyleMoreClear" Style="{StaticResource IconButton}" FontSize="11" MinWidth="28" Height="30" Padding="4"
                                    Content="&#xE738;" ToolTip="{x:Static loc:Strings.Tab_MoreSeeThrough}" AutomationProperties.Name="{x:Static loc:Strings.Tab_LessOpaque}" />
                            <TextBlock x:Name="StyleOpacityText" MinWidth="40" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" ToolTip="{x:Static loc:Strings.Tab_Opacity}" />
                            <Button x:Name="StyleLessClear" Style="{StaticResource IconButton}" FontSize="11" MinWidth="28" Height="30" Padding="4"
                                    Content="&#xE710;" ToolTip="{x:Static loc:Strings.Tab_LessSeeThrough}" AutomationProperties.Name="{x:Static loc:Strings.Tab_MoreOpaque}" />
                        </StackPanel>
                        <StackPanel x:Name="StyleFillGroup" Orientation="Horizontal">
                            <Border Style="{StaticResource BarSeparator}" />
                            <ToggleButton x:Name="StyleFill" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Tab_Fill}" Height="30" Padding="8,2" FontSize="12"
                                          ToolTip="{x:Static loc:Strings.Tab_FillTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_Fill}" />
                            <ToggleButton x:Name="StyleBorder" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Tab_Border}" Height="30" Padding="8,2" FontSize="12"
                                          ToolTip="{x:Static loc:Strings.Tab_BorderTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_Border}" />
                        </StackPanel>
                        <StackPanel x:Name="StyleArrowGroup" Orientation="Horizontal">
                            <Border Style="{StaticResource BarSeparator}" />
                            <ToggleButton x:Name="StyleStartArrow" Style="{StaticResource IconButton}" FontSize="13" MinWidth="30" Height="30" Padding="6,4"
                                          Content="&#xE72B;" ToolTip="{x:Static loc:Strings.Tab_ArrowStart}" AutomationProperties.Name="{x:Static loc:Strings.Tab_ArrowStart}" />
                            <ToggleButton x:Name="StyleEndArrow" Style="{StaticResource IconButton}" FontSize="13" MinWidth="30" Height="30" Padding="6,4"
                                          Content="&#xE72A;" ToolTip="{x:Static loc:Strings.Tab_ArrowEnd}" AutomationProperties.Name="{x:Static loc:Strings.Tab_ArrowEnd}" />
                        </StackPanel>
                        <StackPanel x:Name="StyleDeleteGroup" Orientation="Horizontal">
                            <Border Style="{StaticResource BarSeparator}" />
                            <Button x:Name="StyleDelete" Style="{StaticResource IconButton}" FontSize="13" MinWidth="30" Height="30" Padding="6,4"
                                    Content="&#xE74D;" ToolTip="{x:Static loc:Strings.Tab_DeleteDelTip}" AutomationProperties.Name="{x:Static loc:Strings.Common_Delete}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Prepare Form: field tools, floating top-center (DocumentTab.FormDesign.cs) -->
                <Border x:Name="FormDesignBar" app:TextScale.Scales="True" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Padding="4,2"
                        Visibility="Collapsed" CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        AutomationProperties.Name="{x:Static loc:Strings.Tab_PrepareFormTools}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static loc:Strings.Tab_PrepareForm}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="8,0,6,0" />
                        <Border Style="{StaticResource BarSeparator}" />
                        <ToggleButton x:Name="DesignSelectTool" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Tab_DesignSelect}" FontSize="12" Padding="8,4"
                                      ToolTip="{x:Static loc:Strings.Tab_DesignSelectTip}" />
                        <ToggleButton x:Name="DesignTextTool" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Tab_DesignText}" FontSize="12" Padding="8,4"
                                      ToolTip="{x:Static loc:Strings.Tab_DesignTextTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_DesignTextName}" />
                        <ToggleButton x:Name="DesignCheckTool" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Tab_DesignCheck}" FontSize="12" Padding="8,4"
                                      ToolTip="{x:Static loc:Strings.Tab_DesignCheckTip}" />
                        <ToggleButton x:Name="DesignRadioTool" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Tab_DesignRadio}" FontSize="12" Padding="8,4"
                                      ToolTip="{x:Static loc:Strings.Tab_DesignRadioTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_DesignRadioName}" />
                        <ToggleButton x:Name="DesignComboTool" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Tab_DesignDropdown}" FontSize="12" Padding="8,4"
                                      ToolTip="{x:Static loc:Strings.Tab_DesignDropdownTip}" />
                        <ToggleButton x:Name="DesignListTool" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Tab_DesignList}" FontSize="12" Padding="8,4"
                                      ToolTip="{x:Static loc:Strings.Tab_DesignListName}" AutomationProperties.Name="{x:Static loc:Strings.Tab_DesignListName}" />
                        <ToggleButton x:Name="DesignSignatureTool" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Tab_DesignSignature}" FontSize="12" Padding="8,4"
                                      ToolTip="{x:Static loc:Strings.Tab_DesignSignatureTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_DesignSignatureName}" />
                        <ToggleButton x:Name="DesignButtonTool" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Tab_DesignButton}" FontSize="12" Padding="8,4"
                                      ToolTip="{x:Static loc:Strings.Tab_DesignButtonTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_DesignButtonName}" />
                        <Border Style="{StaticResource BarSeparator}" />
                        <Button x:Name="DesignDetect" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Tab_DetectFields}" FontSize="12" Padding="8,4"
                                ToolTip="{x:Static loc:Strings.Tab_DetectFieldsTip}" />
                        <ToggleButton x:Name="DesignTabNumbers" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Tab_TabOrder}" FontSize="12" Padding="8,4"
                                      ToolTip="{x:Static loc:Strings.Tab_TabOrderTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_ShowTabOrder}" />
                        <Border Style="{StaticResource BarSeparator}" />
                        <Button x:Name="DesignDone" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Common_Done}" FontSize="12" Padding="10,4" FontWeight="SemiBold"
                                ToolTip="{x:Static loc:Strings.Tab_LeavePrepareForm}" AutomationProperties.Name="{x:Static loc:Strings.Tab_DonePreparingForm}" />
                    </StackPanel>
                </Border>

                <!-- Edit Text & Images: the mode's bar (see DocumentTab.EditContent.cs) -->
                <Border x:Name="EditContentBar" app:TextScale.Scales="True" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Padding="4,2"
                        Visibility="Collapsed" CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        AutomationProperties.Name="{x:Static loc:Strings.Tab_EditTextImagesName}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="EditContentTitle" Text="{x:Static loc:Strings.Tab_EditTextImages}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="8,0,6,0"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Border Style="{StaticResource BarSeparator}" />
                        <TextBlock Text="{x:Static loc:Strings.Tab_EditTextImagesHint}" VerticalAlignment="Center" FontSize="12" Margin="6,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Border Style="{StaticResource BarSeparator}" />
                        <Button x:Name="EditContentReplace" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Tab_ReplacePicture}" FontSize="12" Padding="8,4" IsEnabled="False"
                                ToolTip="{x:Static loc:Strings.Tab_ReplacePictureTip}" />
                        <Button x:Name="EditContentDelete" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Tab_DeletePicture}" FontSize="12" Padding="8,4" IsEnabled="False"
                                ToolTip="{x:Static loc:Strings.Tab_DeletePictureTip}" />
                        <Border Style="{StaticResource BarSeparator}" />
                        <Button x:Name="EditContentDone" Style="{StaticResource CommandButton}" Content="{x:Static loc:Strings.Common_Done}" FontSize="12" Padding="10,4" FontWeight="SemiBold"
                                ToolTip="{x:Static loc:Strings.Tab_LeaveEditTextImagesTip}" AutomationProperties.Name="{x:Static loc:Strings.Tab_DoneEditingTextImages}" />
                    </StackPanel>
                </Border>

                <!-- Prepare Form: the selected field's or suggestion's properties, floating right -->
                <Border x:Name="FieldPanel" app:TextScale.Scales="True" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,60,12,12" Width="272"
                        Visibility="Collapsed" CornerRadius="8" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        AutomationProperties.Name="{x:Static loc:Strings.Tab_FieldProperties}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.22" />
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14,12">
                            <StackPanel.Resources>
                                <Style x:Key="PanelCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Margin" Value="0,8,0,3" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock x:Name="FieldPanelTitle" FontSize="14" FontWeight="SemiBold" Margin="0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="FieldPanelError" Style="{StaticResource PanelCaption}" Visibility="Collapsed" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

                            <StackPanel x:Name="FieldProps">
                                <TextBlock Style="{StaticResource PanelCaption}" Text="{x:Static loc:Strings.Tab_FieldNameCaption}" />
                                <TextBox x:Name="FieldNameBox" AutomationProperties.Name="{x:Static loc:Strings.Tab_FieldName}" />
                                <TextBlock Style="{StaticResource PanelCaption}" Text="{x:Static loc:Strings.Tab_FieldTooltip}" />
                                <TextBox x:Name="FieldTooltipBox" AutomationProperties.Name="{x:Static loc:Strings.Tab_FieldTooltip}" />
                                <WrapPanel>
                                    <CheckBox x:Name="FieldRequiredBox" Margin="0,6,12,0" Content="{x:Static loc:Strings.Tab_FieldRequired}" />
                                    <CheckBox x:Name="FieldReadOnlyBox" Margin="0,6,12,0" Content="{x:Static loc:Strings.Tab_FieldReadOnly}" />
                                </WrapPanel>

                                <StackPanel x:Name="FieldTextGroup">
                                    <CheckBox x:Name="FieldMultilineBox" Margin="0,6,12,0" Content="{x:Static loc:Strings.Tab_FieldMultiLine}" />
                                    <TextBlock Style="{StaticResource PanelCaption}" Text="{x:Static loc:Strings.Tab_FieldMaxLengthCaption}" />
                                    <TextBox x:Name="FieldMaxLenBox" AutomationProperties.Name="{x:Static loc:Strings.Tab_FieldMaxLength}" />
                                    <TextBlock Style="{StaticResource PanelCaption}" Text="{x:Static loc:Strings.Tab_FieldFormat}" />
                                    <ComboBox x:Name="FieldFormatBox" AutomationProperties.Name="{x:Static loc:Strings.Tab_FieldFormat}" />
                                </StackPanel>

                                <StackPanel x:Name="FieldOptionsGroup">
                                    <TextBlock Style="{StaticResource PanelCaption}" Text="{x:Static loc:Strings.Tab_FieldChoicesCaption}" />
                                    <TextBox x:Name="FieldOptionsBox" AcceptsReturn="True" Height="86" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                             AutomationProperties.Name="{x:Static loc:Strings.Tab_FieldChoices}" />
                                    <CheckBox x:Name="FieldEditableBox" Margin="0,6,12,0" Content="{x:Static loc:Strings.Tab_FieldAllowOther}" />
                                    <CheckBox x:Name="FieldMultiSelectBox" Margin="0,6,12,0" Content="{x:Static loc:Strings.Tab_FieldAllowSeveral}" />
                                </StackPanel>

                                <StackPanel x:Name="FieldExportGroup">
                                    <TextBlock Style="{StaticResource PanelCaption}" Text="{x:Static loc:Strings.Tab_FieldOnValue}" />
                                    <TextBox x:Name="FieldExportBox" AutomationProperties.Name="{x:Static loc:Strings.Tab_FieldOnValue}" />
                                </StackPanel>

                                <StackPanel x:Name="FieldButtonGroup">
                                    <TextBlock Style="{StaticResource PanelCaption}" Text="{x:Static loc:Strings.Tab_FieldLabel}" />
                                    <TextBox x:Name="FieldCaptionBox" AutomationProperties.Name="{x:Static loc:Strings.Tab_FieldButtonLabel}" />
                                    <TextBlock Style="{StaticResource PanelCaption}" Text="{x:Static loc:Strings.Tab_FieldWhenClicked}" />
                                    <ComboBox x:Name="FieldActionBox" AutomationProperties.Name="{x:Static loc:Strings.Tab_FieldWhenClicked}" />
                                </StackPanel>

                                <StackPanel x:Name="FieldDefaultGroup">
                                    <TextBlock Style="{StaticResource PanelCaption}" Text="{x:Static loc:Strings.Tab_FieldDefaultValue}" />
                                    <TextBox x:Name="FieldDefaultBox" AutomationProperties.Name="{x:Static loc:Strings.Tab_FieldDefaultValue}" />
                                    <ComboBox x:Name="FieldDefaultChoice" AutomationProperties.Name="{x:Static loc:Strings.Tab_FieldDefaultChoice}" />
                                </StackPanel>
                                <CheckBox x:Name="FieldDefaultCheck" Margin="0,6,12,0" Content="{x:Static loc:Strings.Tab_FieldOnByDefault}" />

                                <Grid x:Name="FieldLookGroup">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource PanelCaption}" Text="{x:Static loc:Strings.Tab_TextSize}" />
                                    <ComboBox x:Name="FieldSizeBox" Grid.Row="1" IsEditable="True" AutomationProperties.Name="{x:Static loc:Strings.Tab_TextSize}" />
                                    <TextBlock Style="{StaticResource PanelCaption}" Grid.Column="2" Text="{x:Static loc:Strings.Tab_FieldAlignment}" />
                                    <ComboBox x:Name="FieldAlignBox" Grid.Row="1" Grid.Column="2" AutomationProperties.Name="{x:Static loc:Strings.Tab_FieldAlignment}" />
                                    <TextBlock Style="{StaticResource PanelCaption}" Grid.Row="2" Text="{x:Static loc:Strings.Tab_Border}" />
                                    <ComboBox x:Name="FieldBorderBox" Grid.Row="3" AutomationProperties.Name="{x:Static loc:Strings.Tab_FieldBorderColor}" />
                                    <TextBlock Style="{StaticResource PanelCaption}" Grid.Row="2" Grid.Column="2" Text="{x:Static loc:Strings.Tab_Fill}" />
                                    <ComboBox x:Name="FieldFillBox" Grid.Row="3" Grid.Column="2" AutomationProperties.Name="{x:Static loc:Strings.Tab_FieldFillColor}" />
                                </Grid>

                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="FieldDuplicate" Content="{x:Static loc:Strings.Tab_FieldDuplicate}" Margin="0,0,6,6" ToolTip="{x:Static loc:Strings.Tab_FieldDuplicateTip}" />
                                    <Button x:Name="FieldDelete" Content="{x:Static loc:Strings.Common_Delete}" Margin="0,0,6,6" ToolTip="{x:Static loc:Strings.Tab_FieldDeleteTip}" />
                                    <Button x:Name="FieldEarlier" Content="{x:Static loc:Strings.Tab_FieldTabEarlier}" Margin="0,0,6,6" ToolTip="{x:Static loc:Strings.Tab_FieldTabEarlierTip}" />
                                    <Button x:Name="FieldLater" Content="{x:Static loc:Strings.Tab_FieldTabLater}" Margin="0,0,6,6" ToolTip="{x:Static loc:Strings.Tab_FieldTabLaterTip}" />
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel x:Name="SuggestionProps">
                                <TextBlock x:Name="SuggestionSource" Style="{StaticResource PanelCaption}" />
                                <TextBlock Style="{StaticResource PanelCaption}" Text="{x:Static loc:Strings.Tab_SuggestName}" />
                                <TextBox x:Name="SuggestionNameBox" AutomationProperties.Name="{x:Static loc:Strings.Tab_SuggestNameName}" />
                                <TextBlock Style="{StaticResource PanelCaption}" Text="{x:Static loc:Strings.Tab_SuggestKind}" />
                                <ComboBox x:Name="SuggestionKindBox" AutomationProperties.Name="{x:Static loc:Strings.Tab_SuggestKindName}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="SuggestionAccept" Content="{x:Static loc:Strings.Tab_SuggestAdd}" Margin="0,0,6,6" Style="{DynamicResource AccentButtonStyle}" ToolTip="{x:Static loc:Strings.Tab_SuggestAddTip}" />
                                    <Button x:Name="SuggestionReject" Content="{x:Static loc:Strings.Common_Skip}" Margin="0,0,6,6" ToolTip="{x:Static loc:Strings.Tab_SuggestSkipTip}" />
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel x:Name="SuggestionAll">
                                <TextBlock x:Name="SuggestionCount" Style="{StaticResource PanelCaption}" />
                                <WrapPanel>
                                    <Button x:Name="SuggestionAcceptAll" Content="{x:Static loc:Strings.Tab_SuggestAddAll}" Margin="0,0,6,6" />
                                    <Button x:Name="SuggestionRejectAll" Content="{x:Static loc:Strings.Tab_SuggestSkipAll}" Margin="0,0,6,6" />
                                </WrapPanel>
                            </StackPanel>

                            <TextBlock x:Name="FieldPanelHint" Style="{StaticResource PanelCaption}"
                                       Text="{x:Static loc:Strings.Tab_DesignHelp}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Page and zoom pill, floating bottom-center -->
                <Border x:Name="Pill" app:TextScale.Scales="True" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="6,4"
                        CornerRadius="20" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.22" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Command="app:Cmd.PrevPage" Content="&#xE76B;" FontSize="12" ToolTip="{x:Static loc:Strings.Tab_PreviousPageTip}" />
                        <TextBox x:Name="PageBox" MinWidth="48" MaxWidth="120" VerticalAlignment="Center" HorizontalContentAlignment="Center" Margin="2,0"
                                 AutomationProperties.Name="{x:Static loc:Strings.Tab_PageNumber}" ToolTip="{x:Static loc:Strings.Tab_PageBoxTip}" />
                        <TextBlock x:Name="PageCountText" VerticalAlignment="Center" Margin="6,0,4,0" MinWidth="32" Style="{StaticResource Caption}" />
                        <Button Style="{StaticResource IconButton}" Command="app:Cmd.NextPage" Content="&#xE76C;" FontSize="12" ToolTip="{x:Static loc:Strings.Tab_NextPageTip}" />
                        <Border Style="{StaticResource BarSeparator}" />
                        <Button Style="{StaticResource IconButton}" Command="app:Cmd.ZoomOut" Content="&#xE738;" FontSize="12" ToolTip="{x:Static loc:Strings.Tab_ZoomOut}" />
                        <ComboBox x:Name="ZoomBox" IsEditable="True" Width="96" VerticalAlignment="Center" Margin="2,0"
                                  AutomationProperties.Name="{x:Static loc:Strings.Tab_Zoom}" ToolTip="{x:Static loc:Strings.Tab_ZoomTip}" />
                        <Button Style="{StaticResource IconButton}" Command="app:Cmd.ZoomIn" Content="&#xE710;" FontSize="12" ToolTip="{x:Static loc:Strings.Tab_ZoomIn}" />
                        <Border Style="{StaticResource BarSeparator}" />
                        <ToggleButton x:Name="FitWidthButton" Style="{StaticResource IconButton}" Command="app:Cmd.FitWidth" Content="&#xE9A6;" FontSize="14" ToolTip="{x:Static loc:Strings.Tab_FitWidth}" />
                        <ToggleButton x:Name="FitPageButton" Style="{StaticResource IconButton}" Command="app:Cmd.FitPage" Content="&#xE7C3;" FontSize="14" ToolTip="{x:Static loc:Strings.Tab_FitPage}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Organize pages (grid of large cards) -->
            <app:OrganizerView x:Name="Organizer" Visibility="Collapsed" />

            <!-- Busy veil for page edits (appears only if an edit takes noticeably long) -->
            <Border x:Name="BusyOverlay" Visibility="Collapsed" Background="{DynamicResource SmokeFillColorDefaultBrush}">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Card}" Padding="20,14">
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar IsIndeterminate="True" Width="80" Height="4" VerticalAlignment="Center" />
                        <TextBlock x:Name="BusyText" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
