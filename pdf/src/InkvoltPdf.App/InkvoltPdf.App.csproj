<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(WinTfm)</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- ModernPrint: the print dialog's COM document source (ComWrappers vtables, function-pointer calls) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>InkvoltPdf</AssemblyName>
    <!-- Program.Main: a find worker starts without WPF -->
    <StartupObject>InkvoltPdf.App.Program</StartupObject>
    <RootNamespace>InkvoltPdf.App</RootNamespace>
    <ApplicationIcon>..\..\assets\InkvoltPdf.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ThemeMode (Fluent) is marked experimental in WPF -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- The interface is in English and Spanish (Strings.es.resx): keep only those of the packages' translated resource
         assemblies (the rest would add ~8 MB) -->
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\InkvoltPdf.Core\InkvoltPdf.Core.csproj" />
    <!-- Inkvolt suite: eSCL scanning, printer status and discovery from the libraries shared with Inkvolt Print (shared/; no packages: protocols + WinRT only) -->
    <ProjectReference Include="..\..\..\shared\InkvoltPrint.Core\InkvoltPrint.Core.csproj" />
    <ProjectReference Include="..\..\..\shared\InkvoltPrint.Windows\InkvoltPrint.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The interface's text: Strings.resx in English (the neutral resources), Strings.es.resx in Spanish (a satellite,
         es\InkvoltPdf.resources.dll). MSBuild writes the strongly-typed Strings class from it at build time; XAML reads it
         with {x:Static loc:Strings.Key}. AppLanguage picks the language at start-up. -->
    <EmbeddedResource Update="Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>InkvoltPdf.App</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>
  <!-- WPF compiles XAML's code-behind a first time in a temporary project (<name>_wpftmp) that doesn't run ResGen: write the
       Strings class before XAML is compiled, and hand it to that project. -->
  <Target Name="StringsBeforeXaml" BeforeTargets="MarkupCompilePass1" DependsOnTargets="PrepareResourceNames;ResGen"
          Condition="!$(MSBuildProjectName.EndsWith('_wpftmp'))" />
  <Target Name="StringsInWpfTempProject" BeforeTargets="CoreCompile" Condition="$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Strings.Designer.cs" />
    </ItemGroup>
  </Target>
  <!-- Publish: our own symbols are embedded (Directory.Build.props); packages' loose .pdb files (e.g. libHarfBuzzSharp.pdb,
       23 MB) would land next to the single-file exe, so leave every .pdb out of the publish output. -->
  <Target Name="DropPdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
      <!-- Native PDB writer the runtime pack carries for debugging tools; the app never writes PDBs -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'Microsoft.DiaSymReader.Native.arm64.dll' or '%(Filename)%(Extension)' == 'Microsoft.DiaSymReader.Native.amd64.dll'" />
      <!-- The WebView2 SDK's IntelliSense files -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.xml' and $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Web.WebView2'))" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Resource Include="..\..\assets\InkvoltPdf.ico" Link="InkvoltPdf.ico" />
    <Resource Include="..\..\assets\InkvoltPdf-512.png" Link="InkvoltPdfLogo.png" />
    <!-- Shown by Help > About > Third-party notices; packaging/pack-msix.ps1 also copies it into the MSIX -->
    <Resource Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" />
    <!-- Help > What's New (AppHelp) -->
    <Resource Include="..\..\WHATS-NEW.md" Link="WHATS-NEW.md" />
  </ItemGroup>
  <ItemGroup>
    <!-- WebView2 SDK (BSD-3-Clause): PDF from Web Page, rendered by the WebView2 runtime that Windows provides (not bundled) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
</Project>
