<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />
  <!-- Inkvolt PDF's projects only. The shared libraries (shared/) they reference build with the repo's settings. -->
  <PropertyGroup>
    <!-- Release: PDB embedded in the dll/exe, so crash logs get file and line numbers (works with single-file publish) -->
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <!-- Native ARM64 build (MuPDF ships a win-arm64 native library) -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-arm64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
  </PropertyGroup>
</Project>
