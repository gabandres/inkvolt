<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Open XML SDK (MIT), tests only: opens and validates the exported .docx / .xlsx files -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\InkvoltPdf.Core\InkvoltPdf.Core.csproj" />
    <ProjectReference Include="..\..\..\shared\InkvoltPrint.Core\InkvoltPrint.Core.csproj" />
    <!-- The speed benchmark's generator and harness (BenchTests, opt-in with INKVOLTPDF_BENCH) -->
    <ProjectReference Include="..\..\tools\bench\Bench.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- PDFs Word made (CompareContractTests) -->
    <None Include="Data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The OCR corpus's generator and word error rate (pdf/tools/ocr-corpus; its runner needs Windows' recognizer) -->
    <Compile Include="..\..\tools\ocr-corpus\ScanCorpus.cs" Link="OcrCorpus\ScanCorpus.cs" />
    <Compile Include="..\..\tools\ocr-corpus\WordErrorRate.cs" Link="OcrCorpus\WordErrorRate.cs" />
    <Compile Include="..\..\tools\ocr-corpus\CleanupCorpus.cs" Link="OcrCorpus\CleanupCorpus.cs" />
  </ItemGroup>
</Project>
