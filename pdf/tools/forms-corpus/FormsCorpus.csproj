<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev tool, not shipped: fills real-world forms through FormEditor (the app's fill path), saves, reopens and reads
       them back with Inkvolt, MuPDF and pdf.js, and groups what failed. See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\InkvoltPdf.Core\InkvoltPdf.Core.csproj" />
  </ItemGroup>
</Project>
