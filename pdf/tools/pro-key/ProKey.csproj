<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev tool, not shipped: makes the Inkvolt Pro signing key pair, issues licence keys and checks one. See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The key format and public key live in the suite's shared library (Suite/ProKeys.cs), read by both apps -->
    <ProjectReference Include="..\..\..\shared\InkvoltPrint.Core\InkvoltPrint.Core.csproj" />
  </ItemGroup>
</Project>
