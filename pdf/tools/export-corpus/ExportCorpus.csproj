<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev tool, not shipped: exports real-world PDFs to Word and dumps MuPDF's glyphs. See README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\InkvoltPdf.Core\InkvoltPdf.Core.csproj" />
  </ItemGroup>
</Project>
