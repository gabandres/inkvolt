          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a assinatura verificável após o certificado expirar. Você vê quais endereços serão consultados antes que qualquer coisa vá para a internet."
          }
        }
      }
    },
