    "Pages with almost no ink (the empty back of a one-sided sheet) aren't added. A page with as little as a short word is kept.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas casi sin tinta (el reverso vacío de una hoja de una cara) no se agregan. Una página con apenas una palabra corta se conserva."
          }
        }
      }
    },
    "Pages without text can't be compared word by word: they are checked visually, and Visual shows them overlaid.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas sin texto no se pueden comparar palabra por palabra: se comprueban visualmente, y Visual las muestra superpuestas."
          }
        }
      }
    },
