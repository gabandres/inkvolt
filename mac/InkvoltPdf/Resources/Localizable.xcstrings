            "state": "translated",
            "value": "No se pudo buscar en las páginas."
          }
        }
      }
    },
    "The pages then look straightened and cleaned, and upside-down or sideways pages are turned upright. Undo puts the scans back until you save.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
