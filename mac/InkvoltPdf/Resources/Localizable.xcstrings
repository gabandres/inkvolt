    "Nothing you open leaves this Mac unless you send it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de lo que abres sale de este Mac a menos que tú lo envíes."
