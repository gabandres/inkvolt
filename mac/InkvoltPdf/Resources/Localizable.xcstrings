            "value": "Se busca en todas las páginas y se tapa en negro de una vez; las páginas con coincidencias se convierten en imágenes y su texto se vuelve a reconocer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Localizado em todas as páginas e coberto em preto de uma só vez; as páginas com correspondências viram imagens com o texto reconhecido novamente."
          }
        }
      }
    },
