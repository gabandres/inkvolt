        }
      }
    },
    "The page loads on this Mac with WebKit, from the internet as a browser would, in a private session that keeps no cookies or history. Scripts on a web page run; a saved page runs none. Pop-ups, downloads and permission requests are blocked.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página se carga en este Mac con WebKit, desde Internet como lo haría un navegador, en una sesión privada que no guarda cookies ni historial. Los scripts de una página web se ejecutan; una página guardada no ejecuta ninguno. Las ventanas emergentes, las descargas y las solicitudes de permisos se bloquean."
          }
        }
      }
    },
    "The pages couldn't be extracted.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron extraer las páginas."
