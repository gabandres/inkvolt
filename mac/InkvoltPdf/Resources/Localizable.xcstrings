    "Inkvolt PDF for Mac can't use a comma in a password. Choose one without a comma.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt PDF para Mac no puede usar una coma en una contraseña. Elige una sin coma."
          }
        }
      }
    },
    "Inkvolt PDF is free software: you can share and change it under the GNU Affero General Public License, version 3 (AGPL-3.0), which MuPDF, the engine it is built on, requires. It comes with no warranty. The complete source code is on GitHub.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt PDF es software libre: puedes compartirlo y modificarlo según la Licencia Pública General Affero de GNU, versión 3 (AGPL-3.0), que exige MuPDF, el motor sobre el que está hecho. No tiene ninguna garantía. El código fuente completo está en GitHub."
          }
        }
      }
    },
    "Inkvolt PDF isn't allowed to look for scanners on your network. Allow it in System Settings › Privacy & Security › Local Network (USB scanners still work).": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt PDF no tiene permiso para buscar escáneres en tu red. Permítelo en Configuración del Sistema › Privacidad y seguridad › Red local (los escáneres USB siguen funcionando)."
          }
        }
      }
    },
    "Inkvolt PDF results": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultados de Inkvolt PDF"
