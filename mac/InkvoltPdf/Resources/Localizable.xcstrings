        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Válida al abrirse. Tus ediciones cambiaron el documento firmado, así que esta firma ya no se verifica. Deshazlas, o conserva el original firmado guardando tus cambios como una copia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Válida ao abrir. Suas edições alteraram o documento assinado, portanto esta assinatura não é mais válida. Desfaça-as ou mantenha o original assinado salvando suas alterações como uma cópia."
          }
        }
      }
    },
