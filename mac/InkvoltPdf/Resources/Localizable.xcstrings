            "value": "Imágenes"
          }
        }
      }
    },
    "Pictures shown larger than the chosen resolution are downsampled and stored as JPEG; identical streams merged, uncompressed ones compressed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes que se muestran a más resolución de la elegida se reducen y se guardan como JPEG; los flujos idénticos se combinan y los que no están comprimidos se comprimen."
          }
        }
      }
    },
    "Pieces in reading order": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Piezas en orden de lectura"
