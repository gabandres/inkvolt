    "AES-256 (AES-128 for old readers). Passwords are asked here and never kept in a preset.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AES-256 (AES-128 para lectores antiguos). Las contraseñas se piden aquí y nunca se guardan en un ajuste predefinido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "AES-256 (AES-128 para leitores antigos). As senhas são solicitadas aqui e nunca ficam salvas em uma predefinição."
