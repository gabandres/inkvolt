        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sugiere el servidor gratuito de Sectigo; puedes escribir otro que empiece por https://. Solo se contacta si agregas una marca de tiempo, y solo recibe un hash de la firma, nunca el documento."
          }
        },
