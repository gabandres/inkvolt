    "The pages then look straightened and cleaned, and upside-down or sideways pages are turned upright. Undo puts the scans back until you save.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas se ven entonces enderezadas y limpias, y las páginas al revés o de lado quedan derechas. Deshacer devuelve los escaneos hasta que guardes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As páginas passam a aparecer endireitadas e limpas, e páginas de cabeça para baixo ou de lado ficam na vertical. Desfazer restaura as digitalizações até você salvar."
          }
        }
      }
    },
