{
  "sourceLanguage": "en",
  "strings": {
    "LibreOffice isn't installed": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LibreOffice no está instalado"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O LibreOffice não está instalado"
          }
        }
      }
    },
    "This file was damaged, and Inkvolt PDF repaired it to open it. Saving writes the repaired copy; the file on disk stays as it is until you save.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo estaba dañado e Inkvolt PDF lo reparó para abrirlo. Al guardar se escribe la copia reparada; el archivo del disco no cambia hasta que guardes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo estava danificado e o Inkvolt PDF o reparou para abri-lo. Salvar grava a cópia reparada; o arquivo no disco permanece como está até você salvar."
          }
        }
      }
    },
    "Not checked: the file was damaged and Inkvolt PDF repaired it to open it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin comprobar: el archivo estaba dañado e Inkvolt PDF lo reparó para abrirlo."
