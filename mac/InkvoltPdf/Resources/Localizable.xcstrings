    "This change can't be added to the signed file without rewriting it, so its digital signatures would no longer verify.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cambio no se puede agregar al archivo firmado sin reescribirlo, así que sus firmas digitales ya no se podrían verificar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta alteração não pode ser adicionada ao arquivo assinado sem regravá-lo, portanto suas assinaturas digitais deixariam de ser verificáveis."
          }
        }
      }
    },
    "This change needs the document's permissions password.": {
