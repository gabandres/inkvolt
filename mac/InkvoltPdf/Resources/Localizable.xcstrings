    "Invalid: the signed bytes are intact, but the document was later changed in ways this signature doesn't allow, so what you see may not be what was signed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No válida: los bytes firmados están intactos, pero el documento se cambió después de formas que esta firma no permite, así que lo que ves puede no ser lo que se firmó."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inválida: os bytes assinados estão intactos, mas o documento foi alterado posteriormente de formas que esta assinatura não permite, portanto o que você vê pode não ser o que foi assinado."
          }
        }
      }
    },
    "Invalid: the signed content was altered, or the signature is damaged.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No válida: el contenido firmado se alteró o la firma está dañada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inválida: o conteúdo assinado foi alterado ou a assinatura está danificada."
          }
        }
      }
    },
