        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los títulos se reconocen por el texto más grande que el del cuerpo. Este documento no tiene ninguno, o sus páginas son escaneos sin texto: reconoce el texto primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os títulos são identificados pelo texto maior que o corpo do texto. Este documento não tem nenhum, ou suas páginas são digitalizações sem texto: reconheça o texto primeiro."
