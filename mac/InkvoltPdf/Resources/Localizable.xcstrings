    "The same actions on many files; presets and watched folders": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mismas acciones en muchos archivos; ajustes predefinidos y carpetas vigiladas"
