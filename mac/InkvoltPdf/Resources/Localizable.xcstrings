    "Finds the words on scanned pages, so you can search, select and copy them. It runs on this Mac; check important text.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra las palabras en las páginas escaneadas para que puedas buscarlas, seleccionarlas y copiarlas. Se hace en este Mac; revisa el texto importante."
          }
        }
      }
    },
