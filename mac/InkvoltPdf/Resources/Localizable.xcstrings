    "Put the stack in again to scan the backs of this document's pages. Each back goes after its front. Blank backs are kept, so each lands next to its front.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a poner la pila para escanear los reversos de las páginas de este documento. Cada reverso va después de su anverso. Los reversos en blanco se conservan para que cada uno quede junto a su anverso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque a pilha novamente para digitalizar os versos das páginas deste documento. Cada verso vai depois de sua frente. Versos em branco são mantidos para que cada um fique ao lado de sua frente."
          }
        }
      }
