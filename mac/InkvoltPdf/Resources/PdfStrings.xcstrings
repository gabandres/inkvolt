          }
        }
      }
    },
    "This text can't be edited: it is inside a drawing (a form XObject) that other pages share, drawn through another drawing, and an edit would change every copy.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
