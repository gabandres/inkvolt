          "stringUnit": {
            "state": "translated",
            "value": "Ve el orden que sigue un lector de pantalla como cuadros numerados en la página, mueve partes hacia arriba, hacia abajo o a otra página, y vuelve a escribir las etiquetas."
          }
        },
        "pt-BR": {
          "stringUnit": {
