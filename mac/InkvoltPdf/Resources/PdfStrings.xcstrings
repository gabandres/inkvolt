          "stringUnit": {
            "state": "translated",
            "value": "No dice su idioma."
          }
        }
      }
    },
    "It doesn't say its language: PDF/A-2a needs one (Make Accessible sets it).": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No dice su idioma: PDF/A-2a necesita uno (Hacer accesible lo establece)."
          }
        }
      }
    },
