    "{0} opened the file but didn't save it as PDF. {0} saves only when it is activated: open {0}, sign in with a Microsoft account that includes Office, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} abrió el archivo pero no lo guardó como PDF. {0} solo guarda cuando está activado: abre {0}, inicia sesión con una cuenta de Microsoft que incluya Office y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} abriu o arquivo, mas não o salvou como PDF. O {0} só salva quando está ativado: abra o {0}, entre com uma conta Microsoft que inclua o Office e tente novamente."
          }
        }
      }
    },
    "{0} didn't finish within {1}. It may be waiting in its window: to sign in, for a password, or with a question. Look at {0}, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} no terminó en {1}. Puede que esté esperando en su ventana: para iniciar sesión, por una contraseña o con una pregunta. Mira {0} y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "{0} não terminou em {1}. Ele pode estar aguardando na janela dele: para entrar, por uma senha ou com uma pergunta. Verifique {0} e tente novamente."
          }
        }
      }
    },
    "{0} saved this file as {1} separate PDFs (one for each sheet, as it can), not one. Open it in {0} and save it as one PDF there.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
