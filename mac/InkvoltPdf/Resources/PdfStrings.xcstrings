            "value": "¿El orden de lectura es lógico?"
          }
        }
      }
    },
    "It couldn't be cleaned of scripts and attached files.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se le pudieron quitar los scripts ni los archivos adjuntos."
          }
        }
      }
    },
    "It doesn't say it is tagged (MarkInfo).": {
      "extractionState": "manual",
