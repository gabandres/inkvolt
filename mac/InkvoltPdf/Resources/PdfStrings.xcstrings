    "Media has captions or a transcript; nothing flashes more than three times a second; scripts don't need timed key presses; image maps' links are also listed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido multimedia tiene subtítulos o una transcripción; nada destella más de tres veces por segundo; los scripts no requieren pulsar teclas a tiempo; los vínculos de los mapas de imagen también están en una lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mídias têm legendas ou transcrição; nada pisca mais de três vezes por segundo; scripts não exigem pressionamento de teclas cronometrado; links de mapas de imagem também estão listados."
          }
        }
      }
    },
