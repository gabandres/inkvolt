    "From the document's properties. Screen readers say it first, and the window shows it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De las propiedades del documento. Los lectores de pantalla lo dicen primero, y la ventana lo muestra."
          }
        },
        "pt-BR": {
