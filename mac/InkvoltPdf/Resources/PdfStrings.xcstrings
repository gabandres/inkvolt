          }
        }
      }
    },
    "Add long-term validation data": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregar datos de validación a largo plazo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar dados de validação a longo prazo"
          }
        }
      }
    },
    "\"Add long-term validation data\" is in the list twice.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Agregar datos de validación a largo plazo\" está dos veces en la lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Adicionar dados de validação a longo prazo\" está na lista duas vezes."
          }
        }
      }
    },
    "\"Add long-term validation data\" goes with checks, reports and exports only: it adds to signed files as they are, and other changes would break their signatures.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Agregar datos de validación a largo plazo\" solo puede ir con comprobaciones, informes y exportaciones: agrega datos a los archivos firmados tal como están, y otros cambios romperían sus firmas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Adicionar dados de validação a longo prazo\" só pode ser usado com verificações, relatórios e exportações: ele adiciona dados aos arquivos assinados como estão, e outras alterações quebrariam as assinaturas."
          }
        }
      }
    },
    "Protected: long-term data can't be added to an encrypted PDF without breaking its signatures": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protegido: no se pueden agregar datos a largo plazo a un PDF cifrado sin romper sus firmas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Protegido: não é possível adicionar dados a longo prazo a um PDF criptografado sem quebrar suas assinaturas"
          }
        }
      }
    },
    "Damaged: repaired to open it, so its signatures can't be checked and no long-term data was added": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dañado: se reparó para abrirlo, así que sus firmas no se pueden comprobar y no se agregaron datos a largo plazo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Danificado: reparado para abri-lo, portanto suas assinaturas não podem ser verificadas e nenhum dado a longo prazo foi adicionado"
          }
        }
      }
    },
    "No signature: nothing to add long-term data for": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
