    "Make the PDF again from its source with a current PDF writer; this font's data is written wrong. A different font can also fix it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea el PDF de nuevo desde su origen con un generador de PDF actual; los datos de esta fuente están mal escritos. Otra fuente también puede resolverlo."
          }
        }
      }
    },
    "Make the PDF again so repeated content is either an artifact or tagged each time it appears.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea el PDF de nuevo de modo que el contenido repetido sea un artefacto o esté etiquetado cada vez que aparece."
          }
        }
      }
    },
    "Make the PDF again with the font embedded in full (Word: File › Options › Save › Embed fonts in the file; most PDF printers: “embed all fonts”), or use another font.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea el PDF de nuevo con la fuente incrustada por completo (Word: Archivo › Opciones › Guardar › Incrustar fuentes en el archivo; la mayoría de las impresoras PDF: “incrustar todas las fuentes”), o usa otra fuente."
          }
        }
      }
    },
    "Make the PDF again with the referenced content included.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea el PDF de nuevo con el contenido referenciado incluido."
          }
        }
      }
    },
