        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ela está dentro de um desenho (um XObject de formulário) que a página desenha mais de uma vez por meio de outro desenho, e uma edição alteraria todas as cópias"
          }
        }
      }
    },
    "it is part of a form XObject (a drawing the page reuses), and only the page's own pictures can be edited in this version": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
