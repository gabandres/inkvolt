            "value": "Proteger com senha"
          }
        }
      }
    },
    "Protect with a password needs an open password, a permissions password, or both.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteger con contraseña necesita una contraseña de apertura, una de permisos o ambas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteger com senha precisa de uma senha de abertura, uma senha de permissões ou ambas."
          }
        }
      }
    },
    "Protect with a password needs its passwords (a preset doesn't keep them): choose it and Change… to type them.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteger con contraseña necesita sus contraseñas (un ajuste predefinido no las guarda): selecciónala y usa Cambiar… para escribirlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteger com senha precisa de suas senhas (uma predefinição não as guarda): selecione-a e use Alterar… para digitá-las."
          }
        }
      }
    },
    "Protecting a PDF needs an open password or a permissions password.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para proteger un PDF hace falta una contraseña de apertura o una contraseña de permisos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteger um PDF exige uma senha de abertura ou uma senha de permissões."
          }
        }
      }
    },
    "Put \"Protect with a password\" after the other changes: they would need its password.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon “Proteger con contraseña” después de los demás cambios: necesitarían su contraseña."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque \"Proteger com senha\" depois das outras alterações: elas precisariam da senha."
          }
        }
      }
    },
    "Put \"Save as PDF/A\" after the other changes, so the result stays PDF/A.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon “Guardar como PDF/A” después de los demás cambios, para que el resultado siga siendo PDF/A."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque \"Salvar como PDF/A\" depois das outras alterações, para que o resultado continue sendo PDF/A."
          }
        }
      }
    },
