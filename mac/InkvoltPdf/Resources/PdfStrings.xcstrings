          }
        }
      }
    },
    "Is the declared language right, also for passages in another language?": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿El idioma declarado es correcto, también en los pasajes en otro idioma?"
          }
        }
      }
    },
    "Is the reading order sensible?": {
      "extractionState": "manual",
      "localizations": {
