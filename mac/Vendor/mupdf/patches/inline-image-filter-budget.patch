Inkvolt's patch to MuPDF 1.25.2 (applied by mac/Vendor/mupdf/build.sh; the Mac only: Windows uses MuPDFCore's
prebuilt MuPDF). Why: an inline image's filters (BI ... ID ... EI) run while the content stream is parsed, reading no
byte of the file, and nothing in them looks at the cookie, so neither Inkvolt's page budget nor Cancel can stop them.
[/Fl /Fl /Fl /AHx] over a few dozen bytes inflates 4 GB of zeros that ASCIIHexDecode skips as white space: 9 s and
more for a 1x1 image (PageCheckTests' AnInlinePictureWhoseFiltersInflateThenDiscardIsCutShortWithinTheLimit). The
patch counts what all the filters of one inline image produce and stops at 8 times the image's decoded size plus 1 MB,
as data cut short. Nothing else in MuPDF changes. To report upstream: inline-image-filter-budget.md (drop this patch
once a MuPDF release has a fix and build.sh moves to it).

diff --git a/source/pdf/pdf-stream.c b/source/pdf/pdf-stream.c
index 7783cfc..1ac877e 100644
--- a/source/pdf/pdf-stream.c
+++ b/source/pdf/pdf-stream.c
@@ -383,16 +383,148 @@ pdf_open_filter(fz_context *ctx, pdf_document *doc, fz_stream *file_stm, pdf_obj
 	return fstm;
 }
 
+/*
+ * An inline image's filters run while the content stream is parsed, and
+ * nothing in them looks at the cookie. A filter can consume its input
+ * without producing anything (ASCIIHexDecode and ASCII85Decode skip white
+ * space, NUL included; FlateDecode skips empty blocks), so a chain such as
+ * [/Fl /Fl /Fl /AHx] over a few dozen bytes inflates gigabytes that the
+ * last filter throws away: the page takes minutes for a 1x1 image, and
+ * no abort can stop it. Limit what the filters of one inline image may
+ * produce, all stages together, to a multiple of the image's decoded size
+ * (plus some slack for small images and their codecs' headers); past it,
+ * the data is treated as truncated, as short image data already is.
+ */
+#define INLINE_IMAGE_EXPANSION 8
+#define INLINE_IMAGE_SLACK (1 << 20)
+
+typedef struct
+{
+	int refs;
+	int warned;
+	size_t left;
+} inline_budget;
+
+typedef struct
+{
+	fz_stream *chain;
+	inline_budget *budget;
+	unsigned char buffer[4096];
+} inline_limit_filter;
+
+static void
+drop_inline_budget(fz_context *ctx, inline_budget *budget)
+{
+	if (--budget->refs == 0)
+		fz_free(ctx, budget);
+}
+
+static int
+next_inline_limit(fz_context *ctx, fz_stream *stm, size_t max)
+{
+	inline_limit_filter *state = stm->state;
+	size_t n;
+
+	if (state->budget->left == 0)
+	{
+		if (!state->budget->warned)
+			fz_warn(ctx, "inline image data expands too much; truncating");
+		state->budget->warned = 1;
+		return EOF;
+	}
+	n = fz_available(ctx, state->chain, max);
+	if (n == 0)
+		return EOF;
+	if (n > state->budget->left)
+		n = state->budget->left;
+	if (n > sizeof(state->buffer))
+		n = sizeof(state->buffer);
+
+	memcpy(state->buffer, state->chain->rp, n);
+	stm->rp = state->buffer;
+	stm->wp = stm->rp + n;
+	state->chain->rp += n;
+	state->budget->left -= n;
+	stm->pos += n;
+	return *stm->rp++;
+}
+
+static void
+close_inline_limit(fz_context *ctx, void *state_)
+{
+	inline_limit_filter *state = state_;
+	fz_drop_stream(ctx, state->chain);
+	drop_inline_budget(ctx, state->budget);
+	fz_free(ctx, state);
+}
+
+static fz_stream *
+open_inline_limit(fz_context *ctx, fz_stream *chain, inline_budget *budget)
+{
+	inline_limit_filter *state = fz_malloc_struct(ctx, inline_limit_filter);
+	state->chain = fz_keep_stream(ctx, chain);
+	state->budget = budget;
+	budget->refs++;
+	return fz_new_stream(ctx, state, next_inline_limit, close_inline_limit);
+}
+
+/* As build_filter_chain, with each filter's output counted against one budget. */
+static fz_stream *
+build_inline_filter_chain(fz_context *ctx, fz_stream *file_stm, pdf_document *doc, pdf_obj *fs, pdf_obj *ps, int length, fz_compression_params *imparams)
+{
+	int single = pdf_is_name(ctx, fs);
+	int i, n = single ? 1 : pdf_array_len(ctx, fs);
+	size_t size = length > 0 ? (size_t)length : 0;
+	inline_budget *budget = fz_malloc_struct(ctx, inline_budget);
+	fz_stream *chain = NULL;
+	fz_stream *head = NULL;
+
+	budget->refs = 1;
+	if (size > (SIZE_MAX - INLINE_IMAGE_SLACK) / INLINE_IMAGE_EXPANSION)
+		budget->left = SIZE_MAX;
+	else
+		budget->left = size * INLINE_IMAGE_EXPANSION + INLINE_IMAGE_SLACK;
+
+	fz_var(chain);
+	fz_var(head);
+	fz_try(ctx)
+	{
+		chain = fz_keep_stream(ctx, file_stm);
+		for (i = 0; i < n; i++)
+		{
+			pdf_obj *f = single ? fs : pdf_array_get(ctx, fs, i);
+			pdf_obj *p = single ? ps : pdf_array_get(ctx, ps, i);
+			head = build_filter(ctx, chain, doc, f, p, 0, 0, (i == n-1 ? imparams : NULL), 1);
+			if (head != chain)
+			{
+				fz_stream *limited = open_inline_limit(ctx, head, budget);
+				fz_drop_stream(ctx, head);
+				head = limited;
+			}
+			fz_drop_stream(ctx, chain);
+			chain = head;
+			head = NULL;
+		}
+	}
+	fz_always(ctx)
+		drop_inline_budget(ctx, budget);
+	fz_catch(ctx)
+	{
+		fz_drop_stream(ctx, head);
+		fz_drop_stream(ctx, chain);
+		fz_rethrow(ctx);
+	}
+	return chain;
+}
+
 fz_stream *
 pdf_open_inline_stream(fz_context *ctx, pdf_document *doc, pdf_obj *stmobj, int length, fz_stream *file_stm, fz_compression_params *imparams)
 {
 	pdf_obj *filters = pdf_dict_geta(ctx, stmobj, PDF_NAME(Filter), PDF_NAME(F));
 	pdf_obj *params = pdf_dict_geta(ctx, stmobj, PDF_NAME(DecodeParms), PDF_NAME(DP));
 
-	if (pdf_is_name(ctx, filters))
-		return build_filter(ctx, file_stm, doc, filters, params, 0, 0, imparams, 1);
-	else if (pdf_array_len(ctx, filters) > 0)
-		return build_filter_chain(ctx, file_stm, doc, filters, params, 0, 0, imparams, 1);
+	if (pdf_is_name(ctx, filters) || pdf_array_len(ctx, filters) > 0)
+		return build_inline_filter_chain(ctx, file_stm, doc, filters, params, length, imparams);
 
 	if (imparams)
 		imparams->type = FZ_IMAGE_RAW;
