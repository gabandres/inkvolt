<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>Inkvolt Print</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Bermudez Systems LLC</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Picture</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.jpeg</string>
				<string>public.png</string>
				<string>com.microsoft.bmp</string>
				<string>com.compuserve.gif</string>
				<string>public.tiff</string>
				<string>public.heic</string>
				<string>org.webmproject.webp</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Inkvolt Print uses the camera only while you scan with it: each page you capture becomes a scanned page on this Mac. Nothing is recorded or sent.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Inkvolt Print finds your printers and scanners on this network and reads their status, ink and toner.</string>
	<key>NSLocationUsageDescription</key>
	<string>Inkvolt Print reads the names of the Wi-Fi networks nearby only while you set up a new printer's Wi-Fi, to find the printer's own network. macOS gives Wi-Fi names only to apps with location access; your location isn't used or kept.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Inkvolt Print reads the names of the Wi-Fi networks nearby only while you set up a new printer's Wi-Fi, to find the printer's own network. macOS gives Wi-Fi names only to apps with location access; your location isn't used or kept.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_ipp._tcp</string>
		<string>_ipps._tcp</string>
		<string>_uscan._tcp</string>
		<string>_uscans._tcp</string>
		<string>_pdl-datastream._tcp</string>
		<string>_printer._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
