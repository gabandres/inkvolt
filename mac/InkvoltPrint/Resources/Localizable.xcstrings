{
  "sourceLanguage": "en",
  "strings": {
    "\n\nThe printer needs to be on and free, with plain paper loaded.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nLa impresora debe estar encendida y libre, con papel normal cargado."
          }
        }
      }
    },
    " (%@ left out)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " (%@ omitidos)"
          }
        }
      }
    },
    " (file %lld of %lld; Save again writes the rest)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (file %1$lld of %2$lld; Save again writes the rest)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " (archivo %lld de %lld; Guardar de nuevo escribe el resto)"
          }
        }
      }
    },
    " It is the scanner's own PDF, as it sent it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Es el PDF del propio escáner, tal como lo envió."
          }
        }
      }
    },
    " They are the scanner's own PDFs, as it sent them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Son los PDF del propio escáner, tal como los envió."
          }
        }
      }
    },
    " as %lld files": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " como %lld archivos"
          }
        }
      }
    },
    "\"%@\" couldn't be cancelled.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cancelar \"%@\"."
          }
        }
      }
    },
    "#": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "#"
          }
        }
      }
    },
    "%@ %@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@: %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: %@"
          }
        }
      }
    },
    "%@ (not on this Mac: Automatic)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (no está en este Mac: Automático)"
          }
        }
      }
    },
    "%@ Check SNMP access below.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Revisa el acceso SNMP más abajo."
          }
        }
      }
    },
    "%@ Help › Inkvolt Pro… enters a key.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ En Ayuda › Inkvolt Pro… puedes escribir una clave."
          }
        }
      }
    },
    "%@ Nothing was changed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ No se cambió nada."
          }
        }
      }
    },
    "%@ Opening them shares this Mac's sign-in with those computers.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Abrirlos comparte el inicio de sesión de este Mac con esas computadoras."
          }
        }
      }
    },
    "%@ Save Anyway keeps it as it is.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Guardar de todos modos lo conserva tal como está."
          }
        }
      }
    },
    "%@ already on the list": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya en la lista"
          }
        }
      }
    },
    "%@ asks for its admin password": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pide su contraseña de administrador"
          }
        }
      }
    },
    "%@ from %lld%% to %lld%%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ from %2$lld%% to %3$lld%%"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ del %lld%% al %lld%%"
          }
        }
      }
    },
    "%@ has no network address, so there's nothing to record.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene dirección de red, así que no hay nada que grabar."
          }
        }
      }
    },
    "%@ in %@ would print as soon as it's watched. Print them?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in %2$@ would print as soon as it's watched. Print them?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en %@ se imprimirían en cuanto se vigile la carpeta. ¿Imprimirlos?"
          }
        }
      }
    },
    "%@ is protected with a password.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está protegido con contraseña."
          }
        }
      }
    },
    "%@ neither a PDF nor a picture": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ que no son PDF ni imágenes"
          }
        }
      }
    },
    "%@ of this list went to the printer already. Send the whole list again?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de esta lista ya se enviaron a la impresora. ¿Volver a enviar toda la lista?"
          }
        }
      }
    },
    "%@ over the %@ a batch takes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ over the %2$@ a batch takes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ por encima de los %@ que admite un lote"
          }
        }
      }
    },
    "%@, %@ to send": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@ to send"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ por enviar"
          }
        }
      }
    },
    "%@, and it didn't take the previous setting back. Check automatic updates on its web page.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, y no recuperó la configuración anterior. Revisa las actualizaciones automáticas en su página web."
          }
        }
      }
    },
    "%@, changed %lld times": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, changed %2$lld times"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, cambiado %lld veces"
          }
        }
      }
    },
    "%@, changed on %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, changed on %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, cambiado el %@"
          }
        }
      }
    },
    "%@, not scanned yet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, todavía sin escanear"
          }
        }
      }
    },
    "%@, so automatic updates were set back to “%@”. “%@” is no longer offered for it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, so automatic updates were set back to “%2$@”. “%3$@” is no longer offered for it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, así que las actualizaciones automáticas volvieron a “%2$@”. “%3$@” ya no se ofrece para ella."
          }
        }
      }
    },
    "%@. The previous setting was sent back, but the printer didn't say whether it took it. Check it in a moment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Se volvió a enviar la configuración anterior, pero la impresora no indicó si la aceptó. Compruébalo en un momento."
          }
        }
      }
    },
    "%@. The printer kept automatic updates on and the previous setting (“%@”) couldn't be restored. Change it here or on its web page.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. The printer kept automatic updates on and the previous setting (“%2$@”) couldn't be restored. Change it here or on its web page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. La impresora mantuvo activadas las actualizaciones automáticas y no se pudo restaurar la configuración anterior (“%@”). Cámbiala aquí o en su página web."
          }
        }
      }
    },
    "%@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@"
          }
        }
      }
    },
    "%@: drag to move the crop": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: arrastra para mover el recorte"
          }
        }
      }
    },
    "%lld": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "%lld dpi": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ppp"
          }
        }
      }
    },
    "%lld dpi: may look soft": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ppp: puede verse borrosa"
          }
        }
      }
    },
    "%lld files": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivos"
          }
        }
      }
    },
    "%lld files couldn't be read as pictures.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer %lld archivos como imágenes."
          }
        }
      }
    },
    "%lld jobs from other people stay in the queue.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld trabajos de otras personas siguen en la cola."
          }
        }
      }
    },
    "%lld of %lld jobs couldn't be cancelled. They may have just finished.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld jobs couldn't be cancelled. They may have just finished."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cancelar %lld de %lld trabajos. Puede que acaben de terminar."
          }
        }
      }
    },
    "%lld of %lld pages": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld pages"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld páginas"
