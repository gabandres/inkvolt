        }
      }
    },
    "%lld photos print below %lld dpi and may look soft (marked in the list).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld photos print below %2$lld dpi and may look soft (marked in the list)."
