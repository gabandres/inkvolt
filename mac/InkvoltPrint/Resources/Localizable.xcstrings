            "value": "Detener"
          }
        }
      }
    },
    "Stop Watching": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar de vigilar"
          }
        }
      }
    },
    "Stop on the pages to review them before saving": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenerse en las páginas para revisarlas antes de guardar"
          }
        }
      }
    },
    "Stop saving: the pages stay": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener el guardado: las páginas se quedan"
          }
        }
      }
    },
    "Stop searching": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener la búsqueda"
          }
        }
      }
    },
    "Stopped watching: %@ sent (%@), %@ failed.%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped watching: %1$@ sent (%2$@), %3$@ failed.%4$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se dejó de vigilar: %@ enviados (%@), %@ con error.%@"
          }
        }
      }
    },
    "Stopping after the page being drawn…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deteniendo después de la página que se está dibujando…"
          }
        }
      }
    },
    "Straighten pages": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enderezar páginas"
          }
        }
      }
    },
    "Subfolder": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subcarpeta"
          }
        }
      }
    },
    "Supplies": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suministros"
          }
        }
      }
    },
    "Supply history %@.csv": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historial de suministros %@.csv"
          }
        }
      }
    },
    "Tab picks a photo. Arrow keys move it, Shift-arrow keys resize it, Option-arrow keys turn it, Delete removes it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab elige una foto. Las flechas la mueven, Mayúsculas y flechas cambian su tamaño, Opción y flechas la giran, Suprimir la quita."
          }
        }
      }
    },
    "Takes effect the next time Inkvolt Print starts.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica la próxima vez que se inicie Inkvolt Print."
          }
        }
      }
    },
    "Takes off the lid around the sheet; a page it can't be sure of stays whole": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita la tapa alrededor de la hoja; una página de la que no está seguro se queda entera"
          }
        }
      }
    },
    "Takes the dots out of pictures from magazines and newspapers": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita los puntos de las imágenes de revistas y periódicos"
          }
        }
      }
    },
    "Tell me about low supplies and printer problems": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisarme de suministros bajos y problemas de la impresora"
          }
        }
      }
    },
    "Tell me when a printer stops answering for 15 minutes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisarme cuando una impresora deje de responder durante 15 minutos"
          }
        }
      }
    },
    "Tell me when my own print job fails or gets stuck": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisarme cuando uno de mis trabajos de impresión falle o se quede atascado"
          }
        }
      }
    },
    "Tell me when there's an update": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisarme cuando haya una actualización"
          }
        }
      }
    },
    "Text language": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma del texto"
          }
        }
      }
    },
    "That includes the Pro features to come: supply history export, batch print lists and the command line, fleet export, scanner sharing, SNMPv3. One Inkvolt Pro key serves Inkvolt Print and Inkvolt PDF, on Windows and on the Mac, and keeps the Pro features when they start asking for one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso incluye las funciones Pro que vienen: exportar el historial de suministros, listas de impresión en lote y la línea de comandos, exportar la flota, compartir escáneres, SNMPv3. Una sola clave de Inkvolt Pro sirve para Inkvolt Print e Inkvolt PDF, en Windows y en el Mac, y mantiene las funciones Pro cuando empiecen a pedirla."
          }
        }
      }
    },
    "That password didn't work": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa contraseña no funcionó"
          }
        }
      }
    },
    "That password doesn't open %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa contraseña no abre %@."
          }
        }
      }
    },
    "The copy couldn't be prepared for printing.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo preparar la copia para imprimir."
          }
        }
      }
    },
    "The first page is on its way.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera página está en camino."
          }
        }
      }
    },
    "The keychain didn't keep it, so it isn't used. Try again, or restart your Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El llavero no lo guardó, así que no se usa. Vuelve a intentarlo o reinicia tu Mac."
          }
        }
      }
    },
    "The keychain didn't keep its SNMP access, so the printer wasn't added. Try again, or restart your Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El llavero no guardó su acceso SNMP, así que la impresora no se agregó. Vuelve a intentarlo o reinicia tu Mac."
          }
        }
      }
    },
    "The language of the text on the pages, for the searchable PDF's text": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma del texto de las páginas, para el texto del PDF buscable"
          }
        }
      }
    },
    "The list wasn't saved: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se guardó la lista: %@"
          }
        }
      }
    },
    "The page as it will be saved": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página tal como se guardará"
          }
        }
      }
    },
    "The page as scanned": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página tal como se escaneó"
          }
        }
      }
    },
    "The pages couldn't be prepared for printing.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron preparar las páginas para imprimir."
          }
        }
      }
    },
    "The paper's edge can't be told from the lid here (a white sheet on a white lid, a page printed to its edges): the page is kept whole.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no se puede distinguir el borde del papel de la tapa (una hoja blanca sobre una tapa blanca, una página impresa hasta los bordes): la página se conserva entera."
          }
        }
      }
    },
    "The photos couldn't be sent to %@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photos couldn't be sent to %1$@: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron enviar las fotos a %@: %@"
          }
        }
      }
    },
    "The printer asks for its admin password": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora pide su contraseña de administrador"
          }
        }
      }
    },
    "The printer didn't answer over SNMPv3: check that it's on and that SNMPv3 is turned on in it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora no respondió por SNMPv3: comprueba que esté encendida y que tenga SNMPv3 activado."
          }
        }
      }
    },
    "The printer didn't answer with this community: check it, and that the printer is on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora no respondió con esta comunidad: revísala y comprueba que la impresora esté encendida."
          }
        }
      }
    },
    "The printer didn't send its settings. Try again in a moment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora no envió su configuración. Vuelve a intentarlo en un momento."
          }
        }
      }
    },
    "The printer didn't take the change. Check it's still connected, then try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora no aceptó el cambio. Comprueba que siga conectada y vuelve a intentarlo."
          }
        }
      }
    },
    "The printer didn't take the request.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora no aceptó la solicitud."
          }
        }
      }
    },
    "The printer isn't answering.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora no responde."
          }
        }
      }
    },
    "The printer isn't connected.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora no está conectada."
          }
        }
      }
    },
    "The printer's SNMPv3 user with authentication and privacy (authPriv). Every request is signed and encrypted, and only reads.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El usuario SNMPv3 de la impresora con autenticación y privacidad (authPriv). Cada solicitud va firmada y cifrada, y solo lee."
          }
        }
      }
    },
    "The results weren't saved: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se guardaron los resultados: %@"
          }
        }
      }
    },
    "The saved password was removed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quitó la contraseña guardada."
          }
        }
      }
    },
    "The scan couldn't be saved in %@%@. Check the folder is still there, or choose another in Manage Presets.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scan couldn't be saved in %1$@%2$@. Check the folder is still there, or choose another in Manage Presets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el escaneo en %@%@. Comprueba que la carpeta siga ahí o elige otra en Administrar ajustes."
          }
        }
      }
    },
    "The scan couldn't be saved there. Choose another place, or check there's room on the disk.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el escaneo ahí. Elige otro lugar o comprueba que haya espacio en el disco."
          }
        }
      }
    },
    "The scan didn't finish: the scanner stopped answering.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escaneo no terminó: el escáner dejó de responder."
          }
        }
      }
    },
    "The scanner didn't answer. Check that the printer is on, then try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escáner no respondió. Comprueba que la impresora esté encendida y vuelve a intentarlo."
          }
        }
      }
    },
    "The scanner isn't available while the printer isn't connected.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escáner no está disponible mientras la impresora no esté conectada."
          }
        }
      }
    },
    "The sheets couldn't be prepared for printing.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron preparar las hojas para imprimir."
          }
        }
      }
    },
    "Then": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego"
          }
        }
      }
    },
    "There are too many scans with that name in %@. Choose another folder.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiados escaneos con ese nombre en %@. Elige otra carpeta."
          }
        }
      }
    },
    "These details help find the problem: the version, macOS and a few settings. IP addresses, printer IDs and serial numbers, file paths and your names are masked. Nothing is sent: copy them, then paste them into a GitHub issue or an e-mail. Delete anything you'd rather not share.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos detalles ayudan a encontrar el problema: la versión, macOS y algunas opciones. Las direcciones IP, los ID y números de serie de las impresoras, las rutas de archivos y tus nombres están ocultos. No se envía nada: cópialos y pégalos en una incidencia de GitHub o en un correo electrónico. Borra lo que prefieras no compartir."
          }
        }
      }
    },
    "They'll be offered again the next time Inkvolt Print opens.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se volverán a ofrecer la próxima vez que se abra Inkvolt Print."
          }
        }
      }
    },
    "This Is My Printer": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es mi impresora"
          }
        }
      }
    },
    "This Is My Printer…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es mi impresora…"
          }
        }
      }
    },
    "This batch comes to %@ on %@. Print it?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This batch comes to %1$@ on %2$@. Print it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este lote suma %@ en %@. ¿Imprimirlo?"
          }
        }
      }
    },
    "This doesn't remove it from macOS. It won't be listed again when it's found on the network.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no la quita de macOS. No volverá a aparecer cuando se encuentre en la red."
          }
        }
      }
    },
    "This doesn't remove it from macOS. It's listed again if it's set up in macOS again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no la quita de macOS. Vuelve a aparecer si se configura de nuevo en macOS."
          }
        }
      }
    },
    "This file couldn't be opened as a PDF.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir este archivo como PDF."
          }
        }
      }
    },
    "This page is too large to clean up (%lld million pixels): it is saved as scanned.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página es demasiado grande para limpiarla (%lld millones de píxeles): se guarda tal como se escaneó."
          }
        }
      }
    },
    "This printer can't check for updates without installing them, so “%@” is no longer offered for it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta impresora no puede buscar actualizaciones sin instalarlas, así que “%@” ya no se ofrece para ella."
          }
        }
      }
    },
    "This printer can't check for updates without installing them: it turned on automatic installs": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta impresora no puede buscar actualizaciones sin instalarlas: activó las instalaciones automáticas"
          }
        }
      }
    },
    "This printer doesn't let apps see its firmware updates. Turn automatic updates off on its web page.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta impresora no deja que las aplicaciones vean sus actualizaciones de firmware. Desactiva las actualizaciones automáticas en su página web."
          }
        }
      }
    },
    "This printer doesn't offer driverless printing (IPP), so macOS needs its maker's driver for it. Add it in Printers & Scanners.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta impresora no ofrece impresión sin controlador (IPP), así que macOS necesita el controlador de su fabricante. Agrégala en Impresoras y escáneres."
          }
        }
      }
    },
    "This printer has no address to record.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta impresora no tiene una dirección que grabar."
          }
        }
      }
    },
    "This printer has no macOS print queue to print through.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta impresora no tiene una cola de impresión de macOS por la que imprimir."
          }
        }
      }
    },
    "This printer's scanner didn't say what it can do.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escáner de esta impresora no indicó lo que puede hacer."
          }
        }
      }
    },
    "This scanner sends PDF from %@: its pages were drawn as pictures at %lld dpi for the review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This scanner sends PDF from %1$@: its pages were drawn as pictures at %2$lld dpi for the review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este escáner envía PDF desde %@: sus páginas se dibujaron como imágenes a %lld ppp para la revisión."
          }
        }
      }
    },
    "This scanner sends PDF from %@: its pictures were taken out as they came, so the review, text recognition and presets work as usual.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este escáner envía PDF desde %@: sus imágenes se extrajeron tal como llegaron, así que la revisión, el reconocimiento de texto y los ajustes funcionan como siempre."
          }
        }
      }
    },
    "To record a printer, show it first and come back here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para grabar una impresora, muéstrala primero y vuelve aquí."
          }
        }
      }
    },
    "Try Again": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reintentar"
          }
        }
      }
    },
    "Try the Demo": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probar la demo"
          }
        }
      }
    },
    "Turn Left": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Girar a la izquierda"
          }
        }
      }
    },
    "Turn Off Automatic Updates": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar las actualizaciones automáticas"
          }
        }
      }
    },
    "Turn Right": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Girar a la derecha"
          }
        }
      }
    },
    "Turn Saved Photo": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Girar la foto guardada"
          }
        }
      }
    },
    "Turn left": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Girar a la izquierda"
          }
        }
      }
    },
    "Turn off automatic firmware updates on %@?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Desactivar las actualizaciones automáticas de firmware en %@?"
          }
        }
      }
    },
    "Turn right": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Girar a la derecha"
          }
        }
      }
    },
    "Turn the card over in the same corner of the glass, then click Scan Back.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da la vuelta a la tarjeta en la misma esquina del cristal y haz clic en Escanear reverso."
          }
        }
      }
    },
    "Turns automatic firmware updates off, so an HP update can't install by itself, and checks the printer kept it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva las actualizaciones automáticas de firmware, para que una actualización de HP no pueda instalarse sola, y comprueba que la impresora lo conservó."
          }
        }
      }
    },
