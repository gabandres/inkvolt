    "Not printed: a booklet prints on both sides, and this printer's queue says it prints one side only. Choose another layout, or another printer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se imprimió: un folleto se imprime a doble cara, y la cola de esta impresora dice que imprime una sola cara. Elige otro diseño u otra impresora."
          }
        }
      }
    },
    "Not printed: this layout would take more than %lld sheets. Choose fewer pages or a smaller poster.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se imprimió: este diseño ocuparía más de %lld hojas. Elige menos páginas o un póster más pequeño."
          }
        }
      }
    },
    "Not saved: the preset puts a password on its PDF, and none was entered.": {
      "localizations": {
