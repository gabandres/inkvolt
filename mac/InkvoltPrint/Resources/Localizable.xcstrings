    "macOS asks you to allow it: turn on Inkvolt Print in System Settings › General › Login Items.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS te pide que lo permitas: activa Inkvolt Print en Configuración del Sistema › General › Ítems de inicio."
          }
        }
      }
    },
    "macOS couldn't prepare the pages for printing.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no pudo preparar las páginas para imprimir."
          }
        }
      }
    },
    "macOS didn't add Inkvolt Print to your login items.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no agregó Inkvolt Print a tus ítems de inicio."
          }
        }
      }
    },
    "macOS didn't remove Inkvolt Print from your login items.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no quitó Inkvolt Print de tus ítems de inicio."
          }
        }
      }
    },
    "macOS has no printer set up for this one, so other apps can't print to it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no tiene una impresora configurada para esta, así que otras apps no pueden imprimir en ella."
          }
        }
      }
    },
    "macOS is reading what the printer can do…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
