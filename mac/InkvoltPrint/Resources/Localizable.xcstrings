          }
        }
      }
    },
    "1 photo found": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 foto encontrada"
          }
        }
      }
    },
    "1 photo found, saved as its own picture.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontró 1 foto, guardada como imagen propia."
          }
        }
      }
    },
    "1 photo prints below %lld dpi and may look soft (marked in the list).": {
      "localizations": {
