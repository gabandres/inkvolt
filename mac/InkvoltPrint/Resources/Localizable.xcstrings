    "Firmware": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmware"
          }
        }
      }
    },
    "Firmware Settings": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración del firmware"
          }
        }
      }
    },
    "Firmware updates can change which cartridges a printer accepts. The printer's web page has its update settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones de firmware pueden cambiar qué cartuchos acepta una impresora. La página web de la impresora tiene su configuración de actualizaciones."
          }
        }
      }
    },
    "First month": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primer mes"
          }
        }
      }
    },
