          }
        }
      }
    },
    "Leave it blank for public, the community most printers ship with.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo en blanco para usar public, la comunidad que traen la mayoría de las impresoras."
