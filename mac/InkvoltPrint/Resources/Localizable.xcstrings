            "value": "Conservar las hojas separadoras"
          }
        }
      }
    },
    "Key for %@, issued %@. It is checked on this Mac, works offline, on Windows and on the Mac, and stays through reinstalling%@. Thank you for supporting Inkvolt Print.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key for %1$@, issued %2$@. It is checked on this Mac, works offline, on Windows and on the Mac, and stays through reinstalling%3$@. Thank you for supporting Inkvolt Print."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave para %@, emitida el %@. Se comprueba en este Mac, funciona sin conexión, en Windows y en el Mac, y se mantiene al reinstalar%@. Gracias por apoyar Inkvolt Print."
          }
        }
      }
    },
    "Know its address?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sabes su dirección?"
          }
        }
      }
    },
