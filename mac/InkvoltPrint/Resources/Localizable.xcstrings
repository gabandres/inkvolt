    "What's on the clipboard couldn't be made ready to print. Copy it again and try once more.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que está en el portapapeles no se pudo preparar para imprimir. Cópialo de nuevo y vuelve a intentarlo."
          }
        }
      }
    },
    "What's on the clipboard is too big to print from here. Save it as a file and print that.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que está en el portapapeles es demasiado grande para imprimirlo desde aquí. Guárdalo como archivo e imprime ese archivo."
          }
        }
      }
    },
    "Which way up the sheets came out": {
      "localizations": {
        "es": {
          "stringUnit": {
