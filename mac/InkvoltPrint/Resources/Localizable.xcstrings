    "Whiten the background": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blanquear el fondo"
          }
        }
      }
    },
    "Whoever opens the PDF will need it. Nobody can open the file without it, Inkvolt Print included: keep it somewhere safe.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien abra el PDF la necesitará. Nadie puede abrir el archivo sin ella, ni siquiera Inkvolt Print: guárdala en un lugar seguro."
          }
        }
      }
    },
