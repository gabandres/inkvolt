{
  "sourceLanguage": "en",
  "strings": {
    "\n\nThe printer needs to be on and free, with plain paper loaded.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nLa impresora debe estar encendida y libre, con papel normal cargado."
          }
        }
      }
    },
    " (%@ left out)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " (%@ omitidos)"
          }
        }
      }
    },
    " (file %lld of %lld; Save again writes the rest)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (file %1$lld of %2$lld; Save again writes the rest)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " (archivo %lld de %lld; Guardar de nuevo escribe el resto)"
          }
        }
      }
    },
    " It is the scanner's own PDF, as it sent it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Es el PDF del propio escáner, tal como lo envió."
          }
        }
      }
    },
    " They are the scanner's own PDFs, as it sent them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Son los PDF del propio escáner, tal como los envió."
          }
        }
      }
    },
    " as %lld files": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " como %lld archivos"
          }
        }
      }
    },
    "\"%@\" couldn't be cancelled.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cancelar \"%@\"."
          }
        }
      }
    },
    "#": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "#"
          }
        }
      }
    },
    "%@ %@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@: %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@: %@"
          }
        }
      }
    },
    "%@ (not on this Mac: Automatic)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (no está en este Mac: Automático)"
          }
        }
      }
    },
    "%@ Check SNMP access below.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Revisa el acceso SNMP más abajo."
          }
        }
      }
    },
    "%@ Help › Inkvolt Pro… enters a key.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ En Ayuda › Inkvolt Pro… puedes escribir una clave."
          }
        }
      }
    },
    "%@ Nothing was changed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ No se cambió nada."
          }
        }
      }
    },
    "%@ Opening them shares this Mac's sign-in with those computers.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Abrirlos comparte el inicio de sesión de este Mac con esas computadoras."
          }
        }
      }
    },
    "%@ Save Anyway keeps it as it is.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Guardar de todos modos lo conserva tal como está."
          }
        }
      }
    },
    "%@ already on the list": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya en la lista"
          }
        }
      }
    },
    "%@ and %lld more": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y %lld más"
          }
        }
      }
    },
    "%@ and 1 more": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y 1 más"
          }
        }
      }
    },
    "%@ asks for its admin password": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pide su contraseña de administrador"
          }
        }
      }
    },
    "%@ couldn't be opened: no app on this Mac opens it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir %@: ninguna aplicación de este Mac lo abre."
          }
        }
      }
    },
    "%@ couldn't be read to print (moved, changed or protected with a password).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer %@ para imprimirlo (se movió, cambió o tiene contraseña)."
          }
        }
      }
    },
    "%@ from %lld%% to %lld%%": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ from %2$lld%% to %3$lld%%"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ del %lld%% al %lld%%"
          }
        }
      }
    },
    "%@ has no network address, so there's nothing to record.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene dirección de red, así que no hay nada que grabar."
          }
        }
      }
    },
    "%@ in %@ would print as soon as it's watched. Print them?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in %2$@ would print as soon as it's watched. Print them?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en %@ se imprimirían en cuanto se vigile la carpeta. ¿Imprimirlos?"
          }
        }
      }
    },
    "%@ is protected with a password.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está protegido con contraseña."
          }
        }
      }
    },
    "%@ neither a PDF nor a picture": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ que no son PDF ni imágenes"
          }
        }
      }
    },
    "%@ of this list went to the printer already. Send the whole list again?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de esta lista ya se enviaron a la impresora. ¿Volver a enviar toda la lista?"
          }
        }
      }
    },
    "%@ over the %@ a batch takes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ over the %2$@ a batch takes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ por encima de los %@ que admite un lote"
          }
        }
      }
    },
    "%@ was removed from the list; the file is still there.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se quitó de la lista; el archivo sigue ahí."
          }
        }
      }
    },
    "%@, %@ to send": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@ to send"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@ por enviar"
          }
        }
      }
    },
    "%@, and it didn't take the previous setting back. Check automatic updates on its web page.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, y no recuperó la configuración anterior. Revisa las actualizaciones automáticas en su página web."
          }
        }
      }
    },
    "%@, changed %lld times": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, changed %2$lld times"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, cambiado %lld veces"
          }
        }
      }
    },
    "%@, changed on %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, changed on %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, cambiado el %@"
          }
        }
      }
    },
    "%@, not scanned yet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, todavía sin escanear"
          }
        }
      }
    },
    "%@, scanned": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, escaneado"
          }
        }
      }
    },
    "%@, so automatic updates were set back to “%@”. “%@” is no longer offered for it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, so automatic updates were set back to “%2$@”. “%3$@” is no longer offered for it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, así que las actualizaciones automáticas volvieron a “%2$@”. “%3$@” ya no se ofrece para ella."
          }
        }
      }
    },
    "%@. The previous setting was sent back, but the printer didn't say whether it took it. Check it in a moment.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Se volvió a enviar la configuración anterior, pero la impresora no indicó si la aceptó. Compruébalo en un momento."
          }
        }
      }
    },
    "%@. The printer kept automatic updates on and the previous setting (“%@”) couldn't be restored. Change it here or on its web page.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. The printer kept automatic updates on and the previous setting (“%2$@”) couldn't be restored. Change it here or on its web page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. La impresora mantuvo activadas las actualizaciones automáticas y no se pudo restaurar la configuración anterior (“%@”). Cámbiala aquí o en su página web."
          }
        }
      }
    },
    "%@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@"
          }
        }
      }
    },
    "%@: drag to move the crop": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: arrastra para mover el recorte"
          }
        }
      }
    },
    "%lld": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "%lld dpi": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ppp"
          }
        }
      }
    },
    "%lld dpi: may look soft": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ppp: puede verse borrosa"
          }
        }
      }
    },
    "%lld files": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivos"
          }
        }
      }
    },
    "%lld files couldn't be read as pictures.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer %lld archivos como imágenes."
          }
        }
      }
    },
    "%lld fronts but %lld backs: a sheet may have gone through twice or been left behind. The backs were matched from the last sheet: check the order and drag any page that's out of place, or click Undo to put the backs after the fronts.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld anversos pero %lld reversos: puede que una hoja pasara dos veces o se quedara atrás. Los reversos se emparejaron desde la última hoja: revisa el orden y arrastra la página que esté fuera de lugar, o haz clic en Deshacer para poner los reversos después de los anversos."
          }
        }
      }
    },
    "%lld jobs from other people stay in the queue.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld trabajos de otras personas siguen en la cola."
          }
        }
      }
    },
    "%lld of %lld jobs couldn't be cancelled. They may have just finished.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld jobs couldn't be cancelled. They may have just finished."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cancelar %lld de %lld trabajos. Puede que acaben de terminar."
          }
        }
      }
    },
    "%lld of %lld pages": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld of %2$lld pages"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld páginas"
          }
        }
      }
    },
    "%lld of the files couldn't be read and won't print.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de los archivos no se pudieron leer y no se imprimirán."
          }
        }
      }
    },
    "%lld pages": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld páginas"
          }
        }
      }
    },
    "%lld pages per sheet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld páginas por hoja"
          }
        }
      }
    },
    "%lld pages were cleaned up (Undo puts them back).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se limpiaron %lld páginas (Deshacer las recupera)."
          }
        }
      }
    },
    "%lld pages were turned upright.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pusieron %lld páginas al derecho."
          }
        }
      }
    },
    "%lld per sheet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld por hoja"
          }
        }
      }
    },
    "%lld photos found": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fotos encontradas"
          }
        }
      }
    },
    "%lld photos found, each saved as its own picture.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontraron %lld fotos, cada una guardada como imagen propia."
          }
        }
      }
    },
    "%lld photos print below %lld dpi and may look soft (marked in the list).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld photos print below %2$lld dpi and may look soft (marked in the list)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fotos se imprimen a menos de %lld ppp y pueden verse borrosas (marcadas en la lista)."
          }
        }
      }
    },
    "%lld scanned pages from %@ weren't saved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld scanned pages from %2$@ weren't saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se guardaron %lld páginas escaneadas el %@."
          }
        }
      }
    },
    "%lld separator sheets found: %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld separator sheets found: %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hojas separadoras encontradas: %@."
          }
        }
      }
    },
    "%lld sheets": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hojas"
          }
        }
      }
    },
    "%lld sheets go through again with nothing printed on their backs (the ends of copies).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hojas vuelven a pasar sin nada impreso en sus reversos (los finales de las copias)."
          }
        }
      }
    },
    "%lld%%": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %%"
          }
        }
      }
    },
    "%lld%% or less": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %% o menos"
          }
        }
      }
    },
    "%lld. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld. %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld. %@"
          }
        }
      }
    },
    "%lld. Put the stack in the paper tray that way, the top edge going in first as before, then click Print the Backs.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld. Pon la pila así en la bandeja de papel, con el borde superior entrando primero como antes, y luego haz clic en Imprimir los reversos."
          }
        }
      }
    },
    "%lld. Take %@ and turn the stack over like the page of a book, so the printed side faces down and the first page is on top.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld. Take %2$@ and turn the stack over like the page of a book, so the printed side faces down and the first page is on top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld. Toma %2$@ y da la vuelta a la pila como la página de un libro, para que el lado impreso quede hacia abajo y la primera página arriba."
          }
        }
      }
    },
    "%lld. Take %@ as they came out, printed side down, without turning the stack over.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld. Take %2$@ as they came out, printed side down, without turning the stack over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld. Toma %2$@ tal como salieron, con el lado impreso hacia abajo, sin dar la vuelta a la pila."
          }
        }
      }
    },
    "%lld×": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld×"
          }
        }
      }
    },
    ", starts file %lld": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ", empieza el archivo %lld"
          }
        }
      }
    },
    "1 file": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 archivo"
          }
        }
      }
    },
    "1 job from other people stays in the queue.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 trabajo de otras personas sigue en la cola."
          }
        }
      }
    },
    "1 page": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 página"
          }
        }
      }
    },
    "1 page was cleaned up (Undo puts it back).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se limpió 1 página (Deshacer la recupera)."
          }
        }
      }
    },
    "1 page was turned upright.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se puso 1 página al derecho."
          }
        }
      }
    },
    "1 photo found": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 foto encontrada"
          }
        }
      }
    },
    "1 photo found, saved as its own picture.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontró 1 foto, guardada como imagen propia."
          }
        }
      }
    },
    "1 photo prints below %lld dpi and may look soft (marked in the list).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 foto se imprime a menos de %lld ppp y puede verse borrosa (marcada en la lista)."
          }
        }
      }
    },
    "1 scanned page from %@ wasn't saved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se guardó 1 página escaneada el %@."
          }
        }
      }
    },
    "1 separator sheet found: %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontró 1 hoja separadora: %@."
          }
        }
      }
    },
    "1 sheet": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 hoja"
          }
        }
      }
    },
    "1. Take the top sheet (page %lld) off the output tray and set it aside: nothing prints on its back. Once the backs are done, put it last.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Quita la hoja de arriba (página %lld) de la bandeja de salida y apártala: en su reverso no se imprime nada. Cuando terminen los reversos, ponla al final."
          }
        }
      }
    },
    "4 × 6 in photo paper": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Papel fotográfico de 4 × 6 in"
          }
        }
      }
    },
    "5 × 7 in photo paper": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
