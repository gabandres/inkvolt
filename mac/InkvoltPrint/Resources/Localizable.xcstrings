        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fotos se imprimen a menos de %lld ppp y pueden verse borrosas (marcadas en la lista)."
          }
        }
      }
    },
    "%lld scanned pages from %@ weren't saved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld scanned pages from %2$@ weren't saved."
