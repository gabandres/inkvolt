    "Found where the halves overlap. Move the second half if it isn't quite right.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontró dónde se superponen las mitades. Mueve la segunda mitad si no queda bien del todo."
