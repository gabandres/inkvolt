    "This list was made by a newer Inkvolt Print: update it to open the list.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta lista se hizo con una versión más reciente de Inkvolt Print: actualízalo para abrir la lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta lista foi criada por uma versão mais recente do Inkvolt Print: atualize-o para abrir a lista."
          }
        }
      }
    },
    "This newer HP printer uses HP's CDM interface, whose maintenance requests aren't publicly documented, so Inkvolt Print doesn't start them: use its control panel or its web page.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta impresora HP más reciente usa la interfaz CDM de HP, cuyas solicitudes de mantenimiento no están documentadas públicamente, así que Inkvolt Print no las inicia: usa su panel de control o su página web."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta impressora HP mais recente usa a interface CDM da HP, cujas solicitações de manutenção não são documentadas publicamente, portanto o Inkvolt Print não as inicia: use o painel de controle ou a página web dela."
          }
        }
      }
    },
    "This page came from the demo scanner. Nothing was scanned and nothing left this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página viene del escáner de demostración. No se escaneó nada y nada salió de este Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página veio do scanner de demonstração. Nada foi digitalizado e nada saiu deste Mac."
          }
        }
      }
    },
    "This page size can't be scanned on both sides. Scan one side, or use the glass.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tamaño de página no se puede escanear por ambas caras. Escanea una cara o usa el cristal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tamanho de página não pode ser digitalizado em frente e verso. Digitalize apenas um lado ou use o vidro."
          }
        }
      }
    },
    "This picture can't be read: it may be damaged, or not a kind macOS reads.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer esta imagen: puede estar dañada o no ser de un tipo que macOS lea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível ler esta imagem: ela pode estar danificada ou não ser de um tipo que o macOS lê."
          }
        }
      }
    },
    "This picture can't be read: it may be damaged.": {
      "extractionState": "manual",
