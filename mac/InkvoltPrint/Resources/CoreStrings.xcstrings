          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem resposta em {0}. Verifique se está ligada e ativa, e na mesma rede que este Mac."
          }
        }
      }
    },
    "No macOS printer to check.": {
      "extractionState": "manual",
      "localizations": {
