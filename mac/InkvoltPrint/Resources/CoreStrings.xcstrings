          }
        }
      }
    },
    "This printer aligns by hand (choosing patterns): use its control panel or its web page.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta impresora se alinea a mano (eligiendo patrones): usa su panel de control o su página web."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta impressora faz o alinhamento manualmente (escolhendo padrões): use o painel de controle ou a página web dela."
          }
        }
      }
    },
    "This printer doesn't let apps change its automatic firmware updates. Turn them off on its web page, under the firmware update settings.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta impresora no deja que las aplicaciones cambien sus actualizaciones automáticas del firmware. Desactívalas en su página web, en la configuración de actualización del firmware."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta impressora não permite que aplicativos alterem as atualizações automáticas de firmware. Desative-as na página web dela, nas configurações de atualização de firmware."
          }
        }
