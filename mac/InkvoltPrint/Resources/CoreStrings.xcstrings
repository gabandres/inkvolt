    "The printer wants a signed-in user for printing. Set it up in macOS and print through it, or allow printing without signing in on its web page.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora pide un usuario con sesión iniciada para imprimir. Configúrala en macOS e imprime a través de ella, o permite imprimir sin iniciar sesión en su página web."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A impressora exige um usuário conectado para imprimir. Configure-a no macOS e imprima por ela, ou permita imprimir sem iniciar sessão na página web dela."
          }
        }
      }
    },
    "The printer can't take a job this large. Print fewer pages at a time.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora no acepta un trabajo tan grande. Imprime menos páginas cada vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A impressora não aceita um trabalho tão grande. Imprima menos páginas por vez."
          }
        }
      }
    },
    "The printer refused the pages: it didn't take their format or settings. Nothing was printed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora rechazó las páginas: no aceptó su formato o su configuración. No se imprimió nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A impressora recusou as páginas: não aceitou o formato ou as configurações delas. Nada foi impresso."
          }
        }
      }
    },
    "The printer is busy and took nothing. Try again in a minute.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora está ocupada y no aceptó nada. Inténtalo de nuevo en un minuto."
          }
