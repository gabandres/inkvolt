          "stringUnit": {
            "state": "translated",
            "value": "A senha de autenticação tem pelo menos {0} caracteres."
          }
        }
      }
    },
    "The community can be at most {0} characters.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
