    "Inkvolt Print can't reach it. It may be turned off, asleep or off the network.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt Print no puede conectar con ella. Puede estar apagada, en reposo o fuera de la red."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Inkvolt Print não consegue acessá-la. Ela pode estar desligada, em modo de suspensão ou fora da rede."
          }
        }
      }
    },
    "Inkvolt Print couldn't read it": {
      "extractionState": "manual",
      "localizations": {
