    "A job came to more sheets than its estimate, so nothing more is sent.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trabajo usó más hojas de las estimadas, así que no se envía nada más."
