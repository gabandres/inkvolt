    "Inkvolt Print demo": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo de Inkvolt Print"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Demonstração do Inkvolt Print"
          }
        }
      }
    },
    "Inkvolt Print reads this printer over SNMP, which has no maintenance requests, so it can't start cleaning, nozzle checks or alignment: use its control panel or its web page.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt Print lee esta impresora por SNMP, que no tiene solicitudes de mantenimiento, así que no puede iniciar limpiezas, comprobaciones de inyectores ni alineaciones: usa su panel de control o su página web."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Inkvolt Print lê esta impressora via SNMP, que não tem solicitações de manutenção, portanto não pode iniciar limpeza, verificação de bicos ou alinhamento: use o painel de controle ou a página web dela."
          }
        }
      }
    },
    "Inkvolt Print starts a new file at this sheet.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt Print empieza un archivo nuevo en esta hoja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Inkvolt Print inicia um novo arquivo nesta folha."
          }
        }
      }
    },
    "Insert the toner cartridge and close the front door.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserta el cartucho de tóner y cierra la puerta frontal."
