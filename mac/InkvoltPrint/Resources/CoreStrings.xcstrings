{
  "sourceLanguage": "en",
  "strings": {
    "\n\nThe printer needs to be on and free, with plain paper loaded.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nLa impresora debe estar encendida y libre, con papel normal cargado."
          }
        }
      }
    },
    " (matched by its name)": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " (identificada por su nombre)"
          }
        }
      }
    },
    " (the original stays in {0}: it couldn't be moved)": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " (el original queda en {0}: no se pudo mover)"
          }
        }
      }
    },
    " ({0} then, {1} now)": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " ({0} entonces, {1} ahora)"
          }
        }
      }
    },
    " · found on the network": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " · encontrado en la red"
          }
        }
      }
    },
    "\"{0}\" is not a valid address.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"{0}\" no es una dirección válida."
          }
        }
      }
    },
    "\"{0}\" isn't a file on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"{0}\" no es un archivo de este Mac."
          }
        }
      }
    },
    "\"{0}\" isn't a full path, or one from the list's folder.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"{0}\" no es una ruta completa ni una de la carpeta de la lista."
          }
        }
      }
    },
    "\"{0}\" isn't a path a list may use.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"{0}\" no es una ruta que pueda usar una lista."
          }
        }
      }
    },
    "\"{0}\" leaves the list's folder: use a full path for that.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"{0}\" sale de la carpeta de la lista: usa una ruta completa para eso."
          }
        }
      }
    },
    "\"{0}\" names a device.": {
      "extractionState": "manual",
