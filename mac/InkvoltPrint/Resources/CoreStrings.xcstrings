        }
      }
    },
    "Printing is paused in macOS, so jobs wait in the queue.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresión está en pausa en macOS, así que los trabajos esperan en la cola."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A impressão está pausada no macOS, portanto os trabalhos aguardam na fila."
          }
        }
      }
    },
    "Prints 1 or 2 pages on plain paper with the printer's settings, network address and supply status. Uses a little {0}.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime 1 o 2 páginas en papel normal con la configuración de la impresora, su dirección de red y el estado de los suministros. Usa un poco de {0}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime 1 ou 2 páginas em papel comum com as configurações, o endereço de rede e o status dos suprimentos da impressora. Usa um pouco de {0}."
          }
        }
      }
    },
    "Prints 1 page on plain paper with color blocks and patterns that show streaks, faded colors or misalignment. Uses some {0}.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime 1 página en papel normal con bloques de color y patrones que muestran rayas, colores desvaídos o desalineación. Usa algo de {0}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime 1 página em papel comum com blocos de cor e padrões que mostram listras, cores desbotadas ou desalinhamento. Usa um pouco de {0}."
          }
        }
      }
    },
    "Prints 1 page on plain paper with test patterns, to see whether a cleaning helped. Uses a little {0}.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime 1 página en papel normal con patrones de prueba, para ver si una limpieza ayudó. Usa un poco de {0}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime 1 página em papel comum com padrões de teste para ver se uma limpeza ajudou. Usa um pouco de {0}."
          }
        }
      }
    },
    "Prints 1 page on plain paper with the printer's network settings and addresses. Uses a little {0}.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime 1 página en papel normal con la configuración de red y las direcciones de la impresora. Usa un poco de {0}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime 1 página em papel comum com as configurações de rede e os endereços da impressora. Usa um pouco de {0}."
          }
        }
      }
    },
    "Prints an alignment page on plain paper (uses a little ink). Then place the page face down on the scanner glass and follow the printer's control panel to scan it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime una página de alineación en papel normal (usa un poco de tinta). Luego coloca la página boca abajo en el cristal del escáner y sigue el panel de control de la impresora para escanearla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime uma página de alinhamento em papel comum (usa um pouco de tinta). Em seguida, coloque a página voltada para baixo no vidro do scanner e siga as instruções do painel de controle da impressora para digitalizá-la."
          }
        }
      }
    },
    "Prints an alignment page on plain paper and adjusts the printhead from it. Uses a little ink and takes a few minutes.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime una página de alineación en papel normal y ajusta el cabezal de impresión a partir de ella. Usa un poco de tinta y tarda unos minutos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime uma página de alinhamento em papel comum e ajusta o cabeçote de impressão a partir dela. Usa um pouco de tinta e leva alguns minutos."
          }
        }
      }
    },
    "Prints the printer's diagnostics page on plain paper (usually 1 page). Uses a little {0}.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime la página de diagnóstico de la impresora en papel normal (normalmente 1 página). Usa un poco de {0}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime a página de diagnóstico da impressora em papel comum (geralmente 1 página). Usa um pouco de {0}."
          }
        }
      }
    },
    "Pull the orange tab off the new toner cartridge.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tira de la lengüeta naranja del cartucho de tóner nuevo para quitarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe a aba laranja para removê-la do novo cartucho de toner."
          }
        }
      }
    },
    "Push the paper tray all the way in.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuja la bandeja de papel hasta el fondo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Empurre a bandeja de papel até o fim."
          }
        }
      }
    },
    "Put a copy in front of each document in the feeder, face up like the pages.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon una copia delante de cada documento en el alimentador, boca arriba como las páginas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque uma cópia na frente de cada documento no alimentador, virada para cima como as páginas."
          }
        }
      }
    },
    "Put the cartridge back in and close the door.": {
      "extractionState": "manual",
