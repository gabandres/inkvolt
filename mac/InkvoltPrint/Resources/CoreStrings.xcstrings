    "A deeper cleaning than level {0}; uses more ink. Try it only when level {0} didn't fix the prints, and let the printer rest a few minutes in between.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una limpieza más a fondo que la del nivel {0}; usa más tinta. Pruébala solo si el nivel {0} no arregló las impresiones, y deja descansar la impresora unos minutos entre una y otra."
          }
        }
      }
    },
    "A different device answers at this address": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro dispositivo responde en esta dirección"
