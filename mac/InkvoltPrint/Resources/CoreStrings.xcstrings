          }
        }
      }
    },
    "The printer answers, but macOS still shows it offline. Removing it and adding it again makes macOS find it afresh.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora responde, pero macOS todavía la muestra sin conexión. Quitarla y volver a agregarla hace que macOS la encuentre de nuevo."
