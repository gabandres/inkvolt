    },
    "The level chart fills in as days pass: Inkvolt Print keeps one reading a day on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gráfico de niveles se completa con el paso de los días: Inkvolt Print guarda una lectura al día en este Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O gráfico de níveis é preenchido com o passar dos dias: o Inkvolt Print guarda uma leitura por dia neste Mac."
          }
        }
      }
    },
    "The list file can't be read: {0}": {
