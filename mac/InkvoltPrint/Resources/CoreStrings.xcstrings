    "Reuse the sheet rather than copying it: copiers widen bars. Scanned sheets are left out unless you keep them.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reutiliza la hoja en vez de copiarla: las copiadoras ensanchan las barras. Las hojas escaneadas se omiten salvo que las conserves."
          }
        }
      }
    },
    "Running low": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Queda poco"
          }
        }
      }
    },
    "Runs the printer's cleaning page: feeds a sheet of plain paper through to clean the paper path. Uses a little toner and takes a minute or two.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta la página de limpieza de la impresora: pasa una hoja de papel normal para limpiar el recorrido del papel. Usa un poco de tóner y tarda uno o dos minutos."
          }
        }
      }
    },
    "SNMPv3 is part of Inkvolt Pro.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SNMPv3 es parte de Inkvolt Pro."
          }
        }
      }
    },
    "Save a batch-print list, print a folder as files land in it, run a list from the command line, and keep the results as CSV.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una lista de impresión en lote, imprime una carpeta a medida que llegan archivos, ejecuta una lista desde la línea de comandos y guarda los resultados como CSV."
          }
        }
      }
    },
