    "Export one CSV of every printer's ink and toner levels over time, with the pages each cartridge printed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta un CSV con los niveles de tinta y tóner de cada impresora a lo largo del tiempo, con las páginas que imprimió cada cartucho."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte um CSV com os níveis de tinta e toner de cada impressora ao longo do tempo, com as páginas que cada cartucho imprimiu."
          }
        }
      }
    },
    "Export the fleet page as CSV or JSON, read every printer from a script with status --all, and fix every queue at once.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta la página Flota como CSV o JSON, lee todas las impresoras desde un script con status --all y resuelve todas las colas a la vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte a página Frota como CSV ou JSON, leia todas as impressoras a partir de um script com status --all e corrija todas as filas de uma vez."
          }
        }
      }
    },
