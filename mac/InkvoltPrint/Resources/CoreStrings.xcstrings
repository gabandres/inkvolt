{
  "sourceLanguage": "en",
  "strings": {
    "\n\nThe printer needs to be on and free, with plain paper loaded.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nLa impresora debe estar encendida y libre, con papel normal cargado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nA impressora precisa estar ligada e livre, com papel comum carregado."
          }
        }
      }
    },
    " (matched by its name)": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " (identificada por su nombre)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " (identificada pelo nome)"
          }
        }
      }
    },
    " (the original stays in {0}: it couldn't be moved)": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " (el original queda en {0}: no se pudo mover)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " (o original permanece em {0}: não foi possível movê-lo)"
