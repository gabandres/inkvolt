    "Every page scanned looked blank, so none were added{0}. Clear \"Leave out blank pages\" to keep them.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las páginas escaneadas parecían en blanco, así que no se agregó ninguna{0}. Desmarca \"Omitir páginas en blanco\" para conservarlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as páginas digitalizadas pareciam em branco, portanto nenhuma foi adicionada{0}. Desmarque \"Omitir páginas em branco\" para mantê-las."
          }
        }
      }
    },
    "Every queue is fine: nothing to fix.": {
      "extractionState": "manual",
      "localizations": {
