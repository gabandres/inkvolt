    "Prints 1 or 2 pages on plain paper with the printer's settings, network address and supply status. Uses a little {0}.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime 1 o 2 páginas en papel normal con la configuración de la impresora, su dirección de red y el estado de los suministros. Usa un poco de {0}."
          }
        }
      }
    },
    "Prints 1 page on plain paper with color blocks and patterns that show streaks, faded colors or misalignment. Uses some {0}.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime 1 página en papel normal con bloques de color y patrones que muestran rayas, colores desvaídos o desalineación. Usa algo de {0}."
          }
        }
      }
    },
    "Prints 1 page on plain paper with test patterns, to see whether a cleaning helped. Uses a little {0}.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime 1 página en papel normal con patrones de prueba, para ver si una limpieza ayudó. Usa un poco de {0}."
          }
        }
      }
    },
    "Prints 1 page on plain paper with the printer's network settings and addresses. Uses a little {0}.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime 1 página en papel normal con la configuración de red y las direcciones de la impresora. Usa un poco de {0}."
          }
        }
      }
    },
    "Prints an alignment page on plain paper (uses a little ink). Then place the page face down on the scanner glass and follow the printer's control panel to scan it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime una página de alineación en papel normal (usa un poco de tinta). Luego coloca la página boca abajo en el cristal del escáner y sigue el panel de control de la impresora para escanearla."
          }
        }
      }
    },
    "Prints an alignment page on plain paper and adjusts the printhead from it. Uses a little ink and takes a few minutes.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime una página de alineación en papel normal y ajusta el cabezal de impresión a partir de ella. Usa un poco de tinta y tarda unos minutos."
          }
        }
      }
    },
    "Prints the printer's diagnostics page on plain paper (usually 1 page). Uses a little {0}.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imprime la página de diagnóstico de la impresora en papel normal (normalmente 1 página). Usa un poco de {0}."
          }
        }
      }
    },
