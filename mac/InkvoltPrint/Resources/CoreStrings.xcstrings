      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa no es una clave de Inkvolt Pro: una clave empieza por {0}."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa não é uma chave do Inkvolt Pro: uma chave começa com {0}."
          }
        }
      }
    },
    "The Mac didn't join the printer's network. Check that the printer is still in Wi-Fi setup mode and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Mac no se unió a la red de la impresora. Comprueba que la impresora siga en modo de configuración Wi-Fi y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac não entrou na rede da impressora. Verifique se a impressora ainda está no modo de configuração Wi-Fi e tente novamente."
          }
        }
      }
    },
    "The Mac is on the printer's network, but the printer gave no address for its setup page. Its manual names the address to type in a browser.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Mac está en la red de la impresora, pero la impresora no dio una dirección para su página de configuración. Su manual indica la dirección que hay que escribir en un navegador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac está na rede da impressora, mas a impressora não informou um endereço para sua página de configuração. O manual dela indica o endereço a digitar em um navegador."
          }
        }
      }
    },
    "The Mac isn't back on \"{0}\" yet. Choose \"{0}\" in the Wi-Fi menu in the menu bar, then Check Again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Mac aún no ha vuelto a \"{0}\". Elige \"{0}\" en el menú Wi-Fi de la barra de menús y luego Volver a comprobar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac ainda não voltou para \"{0}\". Escolha \"{0}\" no menu Wi-Fi na barra de menus e clique em Verificar novamente."
          }
        }
      }
    },
    "The authentication passphrase has at least {0} characters.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La frase de contraseña de autenticación tiene al menos {0} caracteres."
