    "The key has a character that doesn't belong in it (a key uses the letters A to Z and the digits 2 to 7). Paste it exactly as it was sent.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave tiene un carácter que no le corresponde (una clave usa las letras de la A a la Z y los dígitos del 2 al 7). Pégala exactamente como te la enviaron."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave contém um caractere que não pertence a ela (uma chave usa as letras de A a Z e os dígitos de 2 a 7). Cole-a exatamente como foi enviada."
          }
