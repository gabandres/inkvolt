        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa una hoja de papel normal por la impresora para limpiar las manchas de tinta de los rodillos. Tarda unos minutos; usa un poco de tinta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
