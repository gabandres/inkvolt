        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A unidade de tambor chegou ao fim da vida útil. Substitua-a para manter a boa qualidade de impressão."
          }
        }
      }
    },
    "The file changed since the estimate: its password no longer opens it. Not printed.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
