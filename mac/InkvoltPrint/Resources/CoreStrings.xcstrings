    },
    "No photos marked: the whole scan is saved as one picture. Drag over a photo to mark it.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay fotos marcadas: todo el escaneo se guarda como una sola imagen. Arrastra sobre una foto para marcarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma foto marcada: toda a digitalização é salva como uma única imagem. Arraste sobre uma foto para marcá-la."
          }
        }
      }
    },
    "No printer answered at {0}. Check the address, and that the printer is on and on this network.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna impresora respondió en {0}. Comprueba la dirección y que la impresora esté encendida y en esta red."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma impressora respondeu em {0}. Verifique o endereço e se a impressora está ligada e nesta rede."
          }
        }
      }
    },
    "No printer's setup network is in range. Turn the printer on, put it in Wi-Fi setup mode (its manual says how; many start it on their own when new or after a network reset), wait a minute and look again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna red de configuración de impresora al alcance. Enciende la impresora, ponla en modo de configuración Wi-Fi (su manual dice cómo; muchas lo inician solas cuando son nuevas o tras restablecer la red), espera un minuto y vuelve a buscar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma rede de configuração de impressora está ao alcance. Ligue a impressora, coloque-a no modo de configuração Wi-Fi (o manual explica como; muitas iniciam isso sozinhas quando novas ou após uma redefinição de rede), aguarde um minuto e procure novamente."
          }
        }
      }
    },
    "No printers answered on your network.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna impresora respondió en tu red."
