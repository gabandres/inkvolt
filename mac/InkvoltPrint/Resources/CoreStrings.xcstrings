    "The printer stopped answering while the job was sent. Check it before printing again: it may have the job.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La impresora dejó de responder mientras se enviaba el trabajo. Revísala antes de volver a imprimir: puede que tenga el trabajo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A impressora parou de responder enquanto o trabalho era enviado. Verifique-a antes de imprimir novamente: ela pode ter recebido o trabalho."
          }
        }
      }
    },
    "The printer isn't taking jobs now.": {
      "extractionState": "manual",
