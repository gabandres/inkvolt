    "Check that it's switched on and awake, and connected to the same Wi-Fi or network as this Mac (its control panel or a network configuration page shows its address). Turning the printer off and on, then the router, fixes most of these.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que esté encendida y activa, y conectada a la misma red Wi-Fi o red que este Mac (su panel de control o una página de configuración de red muestra su dirección). Apagar y encender la impresora, y luego el router, resuelve la mayoría de estos casos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se está ligada e ativa, e conectada à mesma rede Wi-Fi ou rede que este Mac (o painel de controle ou uma página de configuração de rede mostra o endereço dela). Desligar e ligar a impressora e depois o roteador resolve a maioria desses casos."
          }
        }
      }
    },
    "Check that it's turned on and connected.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que esté encendida y conectada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se ela está ligada e conectada."
          }
        }
      }
    },
    "Check that it's turned on and its USB cable is plugged in.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que esté encendida y que su cable USB esté conectado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se ela está ligada e se o cabo USB está conectado."
          }
        }
      }
    },
    "Check that it's turned on and on the same network as this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
