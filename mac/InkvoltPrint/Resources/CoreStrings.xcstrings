        }
      }
    },
    "The document feeder couldn't pick up a page. Straighten the stack and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El alimentador de documentos no pudo tomar una página. Endereza la pila y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O alimentador de documentos não conseguiu puxar uma página. Alinhe a pilha e tente novamente."
          }
        }
      }
    },
    "The document feeder is jammed. Clear the paper and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El alimentador de documentos está atascado. Quita el papel y vuelve a intentarlo."
