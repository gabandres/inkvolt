{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleName": {
      "comment": "Bundle name",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt Print"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt Print"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt Print"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt Print uses the camera only while you scan with it: each page you capture becomes a scanned page on this Mac. Nothing is recorded or sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt Print usa la cámara solo mientras escaneas con ella: cada página que capturas se convierte en una página escaneada en este Mac. No se graba ni se envía nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Inkvolt Print usa a câmera somente enquanto você digitaliza com ela: cada página capturada se torna uma página digitalizada neste Mac. Nada é gravado ou enviado."
          }
        }
      }
    },
    "NSHumanReadableCopyright": {
      "comment": "Copyright (human-readable)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "© 2026 Bermudez Systems LLC"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "© 2026 Bermudez Systems LLC"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "© 2026 Bermudez Systems LLC"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Privacy - Local Network Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt Print finds your printers and scanners on this network and reads their status, ink and toner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt Print encuentra tus impresoras y escáneres en esta red y lee su estado, su tinta y su tóner."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Inkvolt Print encontra suas impressoras e scanners nesta rede e lê o estado, a tinta e o toner deles."
          }
        }
      }
    },
    "NSLocationUsageDescription": {
      "comment": "Privacy - Location Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt Print reads the names of the Wi-Fi networks nearby only while you set up a new printer's Wi-Fi, to find the printer's own network. macOS gives Wi-Fi names only to apps with location access; your location isn't used or kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt Print lee los nombres de las redes Wi-Fi cercanas solo mientras configuras la Wi-Fi de una impresora nueva, para encontrar la red propia de la impresora. macOS solo da los nombres de las redes Wi-Fi a las aplicaciones con acceso a la ubicación; tu ubicación no se usa ni se guarda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Inkvolt Print lê os nomes das redes Wi-Fi próximas somente enquanto você configura o Wi-Fi de uma nova impressora, para encontrar a rede própria da impressora. O macOS fornece os nomes de Wi-Fi apenas para aplicativos com acesso à localização; sua localização não é usada nem mantida."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy - Location When In Use Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt Print reads the names of the Wi-Fi networks nearby only while you set up a new printer's Wi-Fi, to find the printer's own network. macOS gives Wi-Fi names only to apps with location access; your location isn't used or kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt Print lee los nombres de las redes Wi-Fi cercanas solo mientras configuras la Wi-Fi de una impresora nueva, para encontrar la red propia de la impresora. macOS solo da los nombres de las redes Wi-Fi a las aplicaciones con acceso a la ubicación; tu ubicación no se usa ni se guarda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Inkvolt Print lê os nomes das redes Wi-Fi próximas somente enquanto você configura o Wi-Fi de uma nova impressora, para encontrar a rede própria da impressora. O macOS fornece os nomes de Wi-Fi apenas para aplicativos com acesso à localização; sua localização não é usada nem mantida."
          }
        }
      }
    }
  },
  "version": "1.0"
}
