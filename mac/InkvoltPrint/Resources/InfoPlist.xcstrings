    "NSLocalNetworkUsageDescription": {
      "comment": "Privacy - Local Network Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkvolt Print finds your printers and scanners on this network and reads their status, ink and toner."
